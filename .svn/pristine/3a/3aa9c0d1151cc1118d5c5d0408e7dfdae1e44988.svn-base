
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportGroupeditDetail.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button">{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportGroupeditDetail.Tips_2'|translate}}</button>
    <button ng-click="vm.search()" class="btn side-panel-button">{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportGroupeditDetail.Tips_3'|translate}}</button>
</div>
<div class="side-panel-property-area-body" style="height: 80px;">
    <sit-property-grid sit-id="add_form"
                       sit-layout="Horizontal"
                       sit-type="Fixed"
                       sit-mode="edit"
                       sit-columns="4">
        <sit-property sit-widget="sit-text" sit-value="vm.searchParams.Code" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportGroupeditDetail.Tips_4'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.searchParams.Name" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportGroupeditDetail.Tips_5'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.searchParams.DeptName" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportGroupeditDetail.Tips_6'|translate}}</sit-property>

    </sit-property-grid>
</div>

<div style="clear: both;"></div>
<div id="itemlist1" style="width:calc(100% - 2px); height: 500px;margin-top: 6px; padding:5px 16px 0 0px;clear: both; display: block;">
    <div ui-grid="vm.gridOptionsItem1" ui-grid-pagination ui-grid-selection ui-grid-resize-columns ui-grid-auto-resize class="uigrid  gridItem"></div>
</div>