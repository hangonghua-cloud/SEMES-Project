        /// <summary>
        /// 物料编号
        /// </summary>
        public string MATNR { get; set; } = "";
        /// <summary>
        /// 采购凭证编号
        /// </summary>
        public string EBELN { get; set; } = "";
        /// <summary>
        /// 采购凭证项目编号
        /// </summary>
