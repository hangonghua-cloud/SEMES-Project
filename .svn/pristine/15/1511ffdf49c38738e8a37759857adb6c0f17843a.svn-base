<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.PL_MarkUpload.PL_MarkUploadadd.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.PL_MarkUpload.PL_MarkUploadadd.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="1" style="margin-left: 4px;">
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MarkCode" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.PL_MarkUpload.PL_MarkUploadadd.Tips_3'|translate}}</sit-property>
            <sit-property sit-widget="sit-file-uploader" sit-value="vm.file_MarkName" sit-validation="{required: true}"
                          accept="'image/*,video/*,audio/*,application/pdf,office/doc,office/docx,office/xls,office/xlsx,application/x-zip-compressed,.frx'" sit-read-only="false"
                          sit-min-size="'1KB'" sit-max-size="'100MB'">{{'Siemens.SimaticIT.MaterialApp.PL_MarkUpload.PL_MarkUploadadd.Tips_4'|translate}}</sit-property>
            <sit-property sit-widget="sit-radio" sit-value="vm.IsEnabled.value" sit-options="vm.IsEnabled.options"
                          sit-change="" sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.PL_MarkUpload.PL_MarkUploadadd.Tips_5'|translate}}</sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>
