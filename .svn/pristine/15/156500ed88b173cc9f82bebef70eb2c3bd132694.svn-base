<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.FactoryModelApp.ModelResource.ModelResourceaddDetail.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.FactoryModelApp.ModelResource.ModelResourceaddDetail.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <div class="col-md-25">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2">
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductionOrderNO" width:200
                          sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.FactoryModelApp.ModelResource.ModelResourceaddDetail.Tips_3'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductionOrderNO" width:200
                          sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.FactoryModelApp.ModelResource.ModelResourceaddDetail.Tips_4'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductionOrderNO" width:200
                          sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.FactoryModelApp.ModelResource.ModelResourceaddDetail.Tips_5'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductionOrderNO" width:200
                          sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.FactoryModelApp.ModelResource.ModelResourceaddDetail.Tips_6'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductionOrderNO" width:200
                          sit-validation="{required: false"
                          sit-read-only="false">{{'Siemens.SimaticIT.FactoryModelApp.ModelResource.ModelResourceaddDetail.Tips_7'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductionOrderNO" width:200
                          sit-validation="{required: false}"
                          sit-read-only="false">{{'Siemens.SimaticIT.FactoryModelApp.ModelResource.ModelResourceaddDetail.Tips_8'|translate}}</sit-property>
            <sit-property sit-widget="sit-datepicker"
                          sit-value="vm.currentItem.PlanedStart"
                          sit-format="'yyyy-MM-dd'"
                          sit-validation="{required: false}"
                          sit-read-only="false">
                {{'Siemens.SimaticIT.FactoryModelApp.ModelResource.ModelResourceaddDetail.Tips_9'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductionOrderNO" width:200
                          sit-validation="{required: false}"
                          sit-read-only="false">{{'Siemens.SimaticIT.FactoryModelApp.ModelResource.ModelResourceaddDetail.Tips_10'|translate}}</sit-property>
            <sit-property sit-widget="sit-datepicker"
                          sit-value="vm.currentItem.PlanedStart"
                          sit-format="'yyyy-MM-dd'"
                          sit-validation="{required: false}"
                          sit-read-only="false">
                {{'Siemens.SimaticIT.FactoryModelApp.ModelResource.ModelResourceaddDetail.Tips_11'|translate}}
            </sit-property>
    </div>
</div>
