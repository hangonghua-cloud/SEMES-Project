<style>
    .row {
        display: -webkit-box;
        display: -webkit-flex;
        display: -ms-flexbox;
        display: flex;
        flex-wrap: wrap;
    }

        .row > [class*='col-'] {
            display: flex;
            flex-direction: column;
        }

    .ng-tree-search {
        width: 100%;
        margin-bottom: 1px;
    }

    .panel-Title {
        background-color: #fff;
        color: #333;
        height: 35px;
        line-height: 35px;
        text-overflow: ellipsis;
        overflow: hidden;
        white-space: nowrap;
        font-weight: bold;
        border: 1px solid #ccc;
        border-bottom-width: 0;
        padding-left: 0px;
        width: 100%;
        box-sizing: content-box;
    }
</style>


<sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">

    <sit-command sit-icon="fa fa-trash-o " sit-type="main" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportLayoutlist.Tips_1'|translate}}" ng-click="vm.deleteDataItemDetailButtonHandler"
                 :sit-label="{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportLayoutlist.Tips_1'|translate}}" ng-show="vm.is_deleteDataItemDetailButtonHandler"></sit-command>

    <sit-command sit-icon="fa fa-pencil-square-o" sit-type="main" sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportLayoutlist.Tips_2'|translate}}" ng-click="vm.editDataItemDetailButtonHandler"
                 :sit-label="{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportLayoutlist.Tips_2'|translate}}" ng-show="vm.is_editDataItemDetailButtonHandler"></sit-command>

    <sit-command sit-icon="fa  fa-plus-square-o" sit-type="main" sit-name="com.siemens.customcommand.add" :sit-tooltip="{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportLayoutlist.Tips_3'|translate}}" ng-click="vm.addDataItemDetailButtonHandler"
                 :sit-label="{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportLayoutlist.Tips_3'|translate}}" ng-show="vm.is_addDataItemDetailButtonHandler"></sit-command>

    <sit-command sit-icon="fa fa-trash" sit-type="main" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportLayoutlist.Tips_4'|translate}}"
                 ng-click="vm.deleteButtonHandler" :sit-label="{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportLayoutlist.Tips_4'|translate}}" ng-show="vm.is_deleteButtonHandler"></sit-command>
    <sit-command sit-icon="fa fa-pencil-square" sit-type="main" sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportLayoutlist.Tips_5'|translate}}"
                 ng-click="vm.editButtonHandler" :sit-label="{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportLayoutlist.Tips_5'|translate}}" ng-show="vm.is_deleteButtonHandler"></sit-command>
    <sit-command sit-icon="fa fa-plus" sit-type="main" sit-name="com.siemens.customcommand.add" :sit-tooltip="{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportLayoutlist.Tips_6'|translate}}"
                 ng-click="vm.addButtonHandler" :sit-label="{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportLayoutlist.Tips_6'|translate}}" ng-show="vm.is_addButtonHandler"></sit-command>
</sit-command-bar>
<div id="itemlistContainer" class="content-area content-area-relative" style="width:100%; height:100%;overflow: hidden">
    <div class="row" style="height:100%;">
        <div class="col-xs-8 col-md-8" id="boxTree" style="height: 100%;overflow: hidden;">
            <div style="margin: 16px 0px 15px 10px; border: 1px solid #cccccc; background-color: #f6f6f6; width:calc(100%-10px); height: 100%; padding:1px 10px 0 10px;overflow: auto;">

                <js-tree tree-plugins="types,search" tree-types="typesConfig" tree-data="scope" tree-model="treeModel" tree-core="treeCore"
                         tree-events="changed:changedCB;"></js-tree>
            </div>
            <div id="test"></div>
        </div>
        <div class="col-xs-32 col-md-32" style="height:100%;">
            <div id="itemlist" style="width:calc(100% - 5px); height: calc(100% - 92px); padding:15px 5px 0 10px">

                <div class="panel-Title">
                    <div style="margin-left: 10px;">
                        {{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportLayoutlist.Tips_7'|translate}}
                        <span id="titleinfo">{{vm.ReportName}}</span>
                    </div>
                </div>
                <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection ui-grid-pagination class="uigrid"></div>
            </div>
        </div>
    </div>
</div>