<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">取消</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">保存</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form"
                       sit-layout="Horizontal"
                       sit-type="Fixed"
                       sit-mode="edit"
                       sit-columns="2">
        <!-- <sit-property sit-widget="sit-text" sit-value="vm.currentItem.BOMCode" sit-validation="{required: false}"
           sit-read-only="true">BOM编码:</sit-property> -->
        <sit-property sit-widget="sit-select" sit-value="vm.TypeFactory.value" sit-validation="{required: true}" sit-options="vm.TypeFactory.options"
                      sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'">工厂编码:</sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.TypeOrder.value" sit-validation="{required: true}" sit-options="vm.TypeOrder.options"
                      sit-to-display="'ItemName'" sit-to-keep="'ItemValue'">订单类型:</sit-property>
        <sit-property sit-widget="sit-alp-text-picker" sit-value="vm.currentItem.MaterialName" sit-validation="{required: true}"
                      ng-click="vm.materialClick()"
                      sit-read-only="false">物料编码:</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialClassName" sit-validation="{required: true}"
                      sit-read-only="true">物料分类:</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialName" sit-validation="{required: true}"
                      sit-read-only="true">物料名称:</sit-property>

        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.UnitNum" sit-validation="{required: true, min: 0}"
                      sit-read-only="false">单位数量:</sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.typeUnit.value" sit-validation="{required: true}" sit-options="vm.typeUnit.options"
                      sit-to-display="'ItemName'" sit-to-keep="'ItemValue'">单位:</sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.ProcessRoute.value" sit-validation="{required: false}" sit-options="vm.ProcessRoute.options"
                      sit-to-display="'ProcessName'" sit-to-keep="'ProcessCode'">工艺路线:</sit-property>
    </sit-property-grid>
</div>
