<style>
    .MainCommandActionButton {
        margin-top: 20px !important;
    }
</style>
<div id="itemlist" class="content-area content-area-relative" style="height: calc(10% - 10px) !important">
    <!--查询条件与功能按钮-->
    <div class="col-md-40" style="margin-left: 15px;">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit"
                               sit-columns="8">
                <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value"
                              sit-options="vm.typeFactory.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                              sit-change="vm.typeFactoryChange">
                    {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_1'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-select" sit-read-only="false" style="max-width:300px;"
                              sit-options="vm.WorkshopConfig.options" sit-to-keep="'ResourceCode'"
                              sit-validation="{required: false}" sit-value="vm.WorkshopConfig.value"
                              sit-to-display="'ResourceName'">
                    {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_2'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.EquipmentId" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_3'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.EquipmentName" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_4'|translate}}</sit-property>
                <sit-property sit-widget="sit-select" sit-read-only="false" style="max-width:300px;"
                              sit-options="vm.TypeConfig.options" sit-to-keep="'ItemValue'" sit-validation="{required: false}"
                              sit-value="vm.TypeConfig.selectedOption" sit-to-display="'ItemName'">
                    {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_5'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-select" sit-read-only="false" style="max-width:300px;"
                              sit-options="vm.StatusConfig.options" sit-to-keep="'ItemCode'" sit-validation="{required: false}"
                              sit-value="vm.StatusConfig.selectedOption" sit-to-display="'ItemName'">
                    {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_6'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-datepicker" sit-value="vm.RepairStartDate" style="max-width:300px;"
                              sit-format="'yyyy-MM-dd'" sit-validation="{required: false}" sit-read-only="false">
                    {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_7'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-datepicker" sit-value="vm.RepairEndDate" style="max-width:300px;"
                              sit-format="'yyyy-MM-dd'" sit-validation="{required: false}" sit-read-only="false">

                </sit-property>
                <sit-property sit-widget="sit-datepicker" sit-value="vm.FinishStartDate" style="max-width:300px;"
                              sit-format="'yyyy-MM-dd'" sit-validation="{required: false}" sit-read-only="false">
                    {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_8'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-datepicker" sit-value="vm.FinishEndDate" style="max-width:300px;"
                              sit-format="'yyyy-MM-dd'" sit-validation="{required: false}" sit-read-only="false">

                </sit-property>
                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                                 :sit-tooltip="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_9'|translate}}" ng-click="vm.searchButtonHandler" :sit-label="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_9'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div>
    <!--右侧功能按钮-->
    <sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">
        <sit-command sit-icon="fa-eye" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_10'|translate}}"
                     ng-click="vm.selectButtonHandler" :sit-label="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_10'|translate}}" ng-show="vm.isButtonVisible1" sit-type="main">
        </sit-command>
        <sit-command sit-icon="fa-trash-o" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_11'|translate}}"
                     ng-click="vm.deleteSpareButtonHandler" :sit-label="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_11'|translate}}" ng-show="vm.isButtonVisible2"></sit-command>
        <!--<sit-command sit-icon="fa-edit" sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_12'|translate}}" ng-click="vm.editSpareButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_12'|translate}}备件使用记录" ng-show="vm.isButtonVisible2"></sit-command>-->
        <sit-command sit-icon="fa-plus-square-o" sit-name="com.siemens.customcommand.add"
                     ng-click="vm.addSpareButtonHandler" :sit-tooltip="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_14'|translate}}" :sit-label="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_14'|translate}}"
                     ng-show="vm.isButtonVisible1" sit-type="main"></sit-command>
        <sit-command sit-icon="fa-pencil-square-o" sit-name="com.siemens.customcommand.add"
                     ng-click="vm.editRepairButtonHandler" :sit-tooltip="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_12'|translate}}维修记录" :sit-label="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_12'|translate}}维修记录" ng-show="vm.isEdit"
                     sit-type="main"></sit-command>
        <sit-command sit-icon="fa-plus-square" sit-name="com.siemens.customcommand.add"
                     ng-click="vm.addRepairButtonHandler" :sit-tooltip="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_16'|translate}}" :sit-label="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_16'|translate}}" ng-show="vm.isNew"
                     sit-type="main"></sit-command>
        <sit-command sit-icon="fa-trash" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_17'|translate}}"
                     ng-click="vm.deleteButtonHandler" :sit-label="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_17'|translate}}" ng-show="vm.isButtonVisible1"></sit-command>
        <sit-command sit-icon="fa-pencil" sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_12'|translate}}报修记录"
                     ng-click="vm.editButtonHandler" :sit-label="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_12'|translate}}报修记录" ng-show="vm.isButtonVisible1"></sit-command>
        <sit-command sit-icon="fa-plus" sit-name="com.siemens.customcommand.add" ng-click="vm.addButtonHandler"
                     :sit-tooltip="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_19'|translate}}" :sit-label="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairlist.Tips_19'|translate}}" sit-type="main"></sit-command>
    </sit-command-bar>

</div>
<!-- grid列表 -->
<div id="listClass" style="width:100%; height: 39%; padding:0px 16px 0 16px; margin-top: 80px;">
    <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
         ui-grid-pagination class="uigrid"></div>
</div>
<div id="listClassSparePart" style="width:100%; height: 39%; padding:0px 16px 0 16px; margin-top: 3px;">
    <div ui-grid="vm.gridOptionsItem" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
         ui-grid-pagination class="uigrid"></div>
</div>