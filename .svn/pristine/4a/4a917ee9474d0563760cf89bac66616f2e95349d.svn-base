using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ALP.Application.Code.Model
{
    /// <summary>
    /// 工单汇总模型表
    /// </summary>
    public class PL_WorkOrderModel
    {
        public string Id { get; set; }

        /// <summary>
        /// 工厂编码
        /// </summary>
        public string FactoryCode { get; set; }
        /// <summary>
        /// 工厂名称
        /// </summary>
        public string FactoryName { get; set; }

        /// <summary>
        /// 订单编码
        /// </summary>
        public string ProductOrder { get; set; }

        /// <summary>
        /// 工单号
        /// </summary>
        public string WorkOrder { get; set; }

        /// <summary>
        /// 客户PO号
        /// </summary>
        public string CustomerPO { get; set; }

        /// <summary>
        /// 柜号
        /// </summary>
        public string ContainerNO { get; set; }

        /// <summary>
        /// 工单状态
        /// </summary>
        public string OrderStatus { get; set; }
        /// <summary>
        /// 工单类型
        /// </summary>
        public string WorkOrderType { get; set; }
        /// <summary>
        /// PO号状态
        /// </summary>
        public string POStatus { get; set; }

        /// <summary>
        /// 物料编码
        /// </summary>
        public string MaterialCode { get; set; }
        /// <summary>
        /// 大小张转换
        /// </summary>
        public decimal? DXZH { get; set; }

        /// <summary>
        /// 下单总片数
        /// </summary>
        public decimal? OrderPieces { get; set; }

        /// <summary>
        /// 下单总盒数
        /// </summary>
        public decimal? OrderBox { get; set; }

        /// <summary>
        /// 下单总托数
        /// </summary>
        public decimal? OrderPallet { get; set; }

        /// <summary>
        /// 下单起始托号
        /// </summary>
        public decimal? OrderStartPallet { get; set; }

        /// <summary>
        /// 发货总片数
        /// </summary>
        public decimal? DeliveryPieces { get; set; }

        /// <summary>
        /// 发货总盒数
        /// </summary>
        public decimal? DeliveryBox { get; set; }

        /// <summary>
        /// 发货总托数
        /// </summary>
        public decimal? DeliveryPallet { get; set; }

        /// <summary>
        /// 发货起始托号
        /// </summary>
        public decimal? DeliveryStartPallet { get; set; }

        /// <summary>
        /// 总张数
        /// </summary>
        public decimal? TotalSheets { get; set; }

        /// <summary>
        /// 良率
        /// </summary>
        public decimal? Yield { get; set; }

        /// <summary>
        /// 放量张数
        /// </summary>
        public decimal? ActualSheets { get; set; }

        /// <summary>
        /// 工艺路线
        /// </summary>
        public string Process { get; set; }

        /// <summary>
        /// 起始工序
        /// </summary>
        public string StartOperation { get; set; }
        /// <summary>
        /// 超产品起始工序
        /// </summary>
        public string SuperStartOperation { get; set; }

        /// <summary>
        /// 流转方式
        /// </summary>
        public string TransferBy { get; set; }

        /// <summary>
        /// 质量首检确认
        /// </summary>
        public bool? FirstInspectionConfirm { get; set; }

        /// <summary>
        /// 质量首检工序
        /// </summary>
        public string FirstInspectionOperation { get; set; }

        /// <summary>
        /// 免产标志
        /// </summary>
        public bool? AvoidProduce { get; set; }

        /// <summary>
        /// 冻结标记
        /// </summary>
        public bool? FreezeFlag { get; set; }

        /// <summary>
        /// 删除标记
        /// </summary>
        public bool? DeleteFlag { get; set; }

        /// <summary>
        /// 要料状态
        /// </summary>
        public bool? DemandMaterial { get; set; }
        /// <summary>
        /// 面膜发料状态
        /// </summary>
        public string MaskStatus { get; set; }

        /// <summary>
        /// 耐磨层发料状态
        /// </summary>
        public string WearLayerStatus { get; set; }

        /// <summary>
        ///生产/放量张数
        /// </summary>
