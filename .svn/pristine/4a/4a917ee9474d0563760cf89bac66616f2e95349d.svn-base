        /// <summary>
        /// 超发米数
        /// </summary>
        public decimal? SuperNum { get; set; }

        /// <summary>
        /// 退库米数
        /// </summary>
        public decimal? CancellingNum { get; set; }

        /// <summary>
        /// 实际消耗米数
        /// </summary>
