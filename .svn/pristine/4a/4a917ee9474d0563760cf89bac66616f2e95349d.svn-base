        /// <summary>
        /// 耐磨层单耗
        /// </summary>
        public decimal WearLayerConsume { get; set; }
        /// <summary>
        /// 执行工单张数
        /// </summary>
        public decimal? PSheetsQty { get; set; }
        /// <summary>
        /// 执行工单片数
        /// </summary>
        public decimal? PieceQty { get; set; }
        /// <summary>
        /// 超产品批次
        /// </summary>
        public string BatchNo { get; set; }
        /// <summary>
