<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.Process.ProcessOperationadd.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.MaterialApp.Process.ProcessOperationadd.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form"
                       sit-layout="Horizontal"
                       sit-type="Fixed"
                       sit-mode="edit"
                       sit-columns="1">
        <sit-property sit-widget="sit-select" sit-value="vm.TypeFactory.value" sit-validation="{required: true}" sit-options="vm.TypeFactory.options"
                      sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.Process.ProcessOperationadd.Tips_3'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProcessCode" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.Process.ProcessOperationadd.Tips_4'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProcessName" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.Process.ProcessOperationadd.Tips_5'|translate}}</sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.MaterialClass.value" sit-validation="{required: true}" sit-options="vm.MaterialClass.options"
                      sit-to-display="'ItemName'" sit-to-keep="'ItemValue'">{{'Siemens.SimaticIT.MaterialApp.Process.ProcessOperationadd.Tips_6'|translate}}</sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.SmallClass.value" sit-validation="{required: true}" sit-options="vm.SmallClass.options"
                      sit-to-display="'ItemName'" sit-to-keep="'ItemValue'">{{'Siemens.SimaticIT.MaterialApp.Process.ProcessOperationadd.Tips_7'|translate}}</sit-property>
        <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.Process.ProcessOperationadd.Tips_8'|translate}}</sit-property>
    </sit-property-grid>
</div>
