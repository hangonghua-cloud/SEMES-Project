        /// <summary>
        /// 功能描述: 导出 列表到EXCEL 
        /// 创　　建: admin
        /// 创建日期: 2021-10-13 14:01:18
        /// 任务编号: 成品发货明细
        /// </summary>
        /// <param name="jo">queryJson 查询参数</param>
        /// <returns>链接地址</returns>
        [HttpPost]
        [Route("MM_ProductDispatchItem_export")]
        public HttpResponseMessage MM_ProductDispatchItem_export(JObject jo)
        {
            var result = new ResponseResult();
            result.resultData = null;
            try
            {
                if (jo.SelectToken("Entity") == null)
                {
                    result.success = false;
                    result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_7");//缺少Entity参数！
                    return Request.CreateResponse(HttpStatusCode.OK, result);
                }

                string queryJson = getValue(jo, "Entity");
                JObject queryParam = queryJson.ToJObject();

                MM_ProductDispatchItem_Service _Service = new MM_ProductDispatchItem_Service();
                string msg = Language.GetText("Common.SearchSuccess");//查询成功
                string CreatedByCode = "";
                if (!queryParam["CreatedByCode"].IsEmpty())
                {
                    CreatedByCode = queryParam["CreatedByCode"].ToString();
                }

                //查询条件 默认是当前登录用户ID, 可传空 导出全部
                var data = _Service.GetList_export(CreatedByCode, out msg);

                result.resultData = data;
                result.success = true;
                result.returnMsg = msg;
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
            catch (Exception ex)
            {
                result.success = false;
                result.returnMsg = Language.GetText("Common.SearchError2") + ex.Message; //查询失败：
                result.statusCode = ((int)HttpStatusCode.InternalServerError).ToString();
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
        }

        #region 确认发货
        /// <summary>
        /// 确认发货
        /// </summary>
        /// <param name="jo"></param>
        /// <returns></returns>
        [HttpPost]
        [Route("markSureSendOut")]
        public HttpResponseMessage markSureSendOut(JObject jo)
        {
            var userCode = CurrentAccount.UserCode;
            var userName = CurrentAccount.UserName;
            var result = new ResponseResult();
            result.resultData = null;

            if (jo == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_5");//参数不能为空！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            if (jo.SelectToken("Entity") == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_7");//缺少Entity参数！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            try
            {
                //业务服务类
                MM_ProductDispatchItem_Service _Service = new MM_ProductDispatchItem_Service();
                //参数转实体
                MM_ProductDispatchItemEntity entity = JsonConvert.DeserializeObject<MM_ProductDispatchItemEntity>(getValue(jo, "Entity"));

                var factoryCode = entity.FactoryCode;
                var SAPSyncSwitch = _keyParameterItemService.Get_ExpressionEntity(t => t.EnCode == "Switch" && t.ItemCode == "SAPSync"
                    && t.Remark1 == factoryCode);

                if (SAPSyncSwitch?.ItemValue == "1")
                {
                    if (entity.PostDate == null)
                        return AjaxResult(false, Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_35"));//请先维护过账日期
                }

                entity.Status = "3"; //已完成
                entity.Operator = userCode + "-" + userName + "-PC";
                entity.SendTime = DateTime.Now;
                entity.ModifyBy = CurrentAccount.UserCode;
                entity.ModifyTime = DateTime.Now;
                entity.PostMark = "X";

                //按照交货单号发货  (拼柜)
                var dispitchList = _Service.Get_ExpressionList(t => t.DocNum == entity.DocNum).ToList();
                if (dispitchList.Count == 0)
                {
                    return AjaxResult(false, "交货单不存在");
                }

                var lstProductOut = new List<MM_ProductOutEntity>();//成品出库记录
                var lstMark = new List<PM_PackingPrintMarkEntity>();//更新唛头状态
                var lstProductStock = new List<MM_ProductStockEntity>();//成品库存
                var lstMaterialCode = new List<string>();
                foreach (var dispitchEnt in dispitchList)
                {
                    dispitchEnt.Status = entity.Status;
                    dispitchEnt.Operator = entity.Operator;
                    dispitchEnt.SendTime = entity.SendTime;
                    dispitchEnt.ModifyBy = entity.ModifyBy;
                    dispitchEnt.ModifyTime = entity.ModifyTime;
                    dispitchEnt.PostMark = entity.PostMark;

                    #region 2、扣减成品库存
                    var dispatchDetailList = _dispatchDetailService.Get_ExpressionList(t => t.DispatchItemId == dispitchEnt.Id).ToList();
                    var arrMaterialCode = dispatchDetailList.Select(t => t.MaterialCode).ToArray();
                    lstMaterialCode.AddRange(arrMaterialCode);

                    var productStockList = _productStockService.Get_ExpressionList(t => t.ProductOrder == dispitchEnt.ProductOrder
                        && t.ContainerNO == dispitchEnt.ContainerNO && arrMaterialCode.Contains(t.MaterialCode) && t.IsEnabled == true
                        && t.PieceQty > 0).ToList();
                    if (productStockList.Count == 0)
                    {
                        string message = $"库存不存在,订单号：{dispitchEnt.ProductOrder},柜号：{dispitchEnt.ContainerNO},客户型号：{string.Join(",", arrMaterialCode)}";
                        return AjaxResult(false, message);
                    }
                        

                    foreach (var item in dispatchDetailList)
                    {
                        List<MM_ProductStockEntity> materialStockList = new List<MM_ProductStockEntity>();
                        if (SAPSyncSwitch?.ItemValue == "1")
                        {
                            materialStockList = productStockList.FindAll(t => t.LineNum == item.ProductLine);
                        }
                        else
                        {
                            materialStockList = productStockList.FindAll(t => t.MaterialCode == item.MaterialCode);
                        }
                        if (materialStockList == null || materialStockList.Count == 0)
                            return AjaxResult(false, "客户型号[" + item.MaterialCode + "]没有库存");

                        //出库必须在成品仓库
                        var arrWhsCode = materialStockList.Select(t => t.WhsCode).Distinct().ToArray();
                        var warehouseList_extend = _resourceExtendService.Get_ExpressionList(t => arrWhsCode.Contains(t.ResourceCode)
                            && t.FieldCode == "CKLX" && t.FieldValue == "3").ToList();//3：成品库
                        //foreach (var itemStock in materialStockList)
                        //{
                        //    if (!warehouseList_extend.Any(t => t.ResourceCode == itemStock.WhsCode))
                        //    {
                        //        return AjaxResult(false, $"客户型号【{itemStock.MaterialCode}】不在成品库");
                        //    }
                        //}
                        var arrCPWhsCode = warehouseList_extend.Select(t => t.ResourceCode).Distinct().ToArray();
                        materialStockList = materialStockList.Where(t => arrCPWhsCode.Contains(t.WhsCode)).ToList();
                        if (materialStockList == null || materialStockList.Count == 0)
                            return AjaxResult(false, "客户型号[" + item.MaterialCode + "]没有库存");

                        if (materialStockList.Sum(t => t.PieceQty) < item.PieceQty)
                        {
                            return AjaxResult(false, "客户型号[" + item.MaterialCode + "]库存不足");
                        }
                        else if (materialStockList.Sum(t => t.PieceQty) == item.PieceQty)
                        {
                            materialStockList.ForEach(m =>
                            {
                                //新增出库记录
                                MM_ProductOutEntity productOutEntity = new MM_ProductOutEntity();
                                productOutEntity.Id = Guid.NewGuid().ToString();
                                productOutEntity.DocNum = dispitchEnt.DocNum;
                                productOutEntity.LineNum = item.LineNum;
                                productOutEntity.FactoryCode = m.FactoryCode;
                                productOutEntity.FactoryName = m.FactoryName;
                                productOutEntity.ProductOrder = m.ProductOrder;
                                productOutEntity.OrderLine = m.LineNum;
                                productOutEntity.ContainerNO = m.ContainerNO;
                                productOutEntity.MaterialCode = m.MaterialCode;
                                productOutEntity.WorkOrder = m.WorkOrder;
                                productOutEntity.CustomerPO = m.CustomerPO;
                                productOutEntity.WhsCode = m.WhsCode;
                                productOutEntity.LocationCode = m.LocationCode;
                                //productOutEntity.PalletQty = m.PalletQty;
                                productOutEntity.PieceQty = m.PieceQty;
                                productOutEntity.OutType = "5";
                                productOutEntity.CreateTime = DateTime.Now;
                                productOutEntity.Creator = userCode;
                                productOutEntity.BusinessId = dispitchEnt.Id;

                                lstProductOut.Add(productOutEntity);

                                //扣减库存
                                m.PieceQty = 0;
                                m.ModifyBy = userCode;
                                m.ModifyTime = DateTime.Now;
                            });
                        }
                        else if (materialStockList.Sum(t => t.PieceQty) > item.PieceQty)
                        {
                            decimal CycleQty = 0;
                            foreach (var stockItem in materialStockList)  //按照顺序扣减
                            {
                                var offsetQty = item.PieceQty - CycleQty;
                                if (stockItem.PieceQty < offsetQty)
                                {
                                    //新增出库记录
                                    MM_ProductOutEntity productOutEntity = new MM_ProductOutEntity();
                                    productOutEntity.Id = Guid.NewGuid().ToString();
                                    productOutEntity.DocNum = dispitchEnt.DocNum;
                                    productOutEntity.LineNum = item.LineNum;
                                    productOutEntity.FactoryCode = stockItem.FactoryCode;
                                    productOutEntity.FactoryName = stockItem.FactoryName;
                                    productOutEntity.ProductOrder = stockItem.ProductOrder;
                                    productOutEntity.OrderLine = stockItem.LineNum;
                                    productOutEntity.ContainerNO = stockItem.ContainerNO;
                                    productOutEntity.MaterialCode = stockItem.MaterialCode;
                                    productOutEntity.WorkOrder = stockItem.WorkOrder;
                                    productOutEntity.CustomerPO = stockItem.CustomerPO;
                                    productOutEntity.WhsCode = stockItem.WhsCode;
                                    productOutEntity.LocationCode = stockItem.LocationCode;
                                    productOutEntity.PieceQty = stockItem.PieceQty;
                                    productOutEntity.OutType = "5";
                                    productOutEntity.CreateTime = DateTime.Now;
                                    productOutEntity.Creator = userCode;
                                    productOutEntity.BusinessId = dispitchEnt.Id;
                                    lstProductOut.Add(productOutEntity);

                                    CycleQty += stockItem.PieceQty.Value;//累计出库
                                    stockItem.PieceQty = 0;
                                }
                                else if (stockItem.PieceQty >= CycleQty)
                                {
                                    //新增出库记录
                                    MM_ProductOutEntity productOutEntity = new MM_ProductOutEntity();
                                    productOutEntity.Id = Guid.NewGuid().ToString();
                                    productOutEntity.DocNum = dispitchEnt.DocNum;
                                    productOutEntity.LineNum = item.LineNum;
                                    productOutEntity.FactoryCode = stockItem.FactoryCode;
                                    productOutEntity.FactoryName = stockItem.FactoryName;
                                    productOutEntity.ProductOrder = stockItem.ProductOrder;
                                    productOutEntity.OrderLine = stockItem.LineNum;
                                    productOutEntity.ContainerNO = stockItem.ContainerNO;
                                    productOutEntity.MaterialCode = stockItem.MaterialCode;
                                    productOutEntity.WorkOrder = stockItem.WorkOrder;
                                    productOutEntity.CustomerPO = stockItem.CustomerPO;
                                    productOutEntity.WhsCode = stockItem.WhsCode;
                                    productOutEntity.LocationCode = stockItem.LocationCode;
                                    productOutEntity.PieceQty = offsetQty;
                                    productOutEntity.OutType = "5";
                                    productOutEntity.CreateTime = DateTime.Now;
                                    productOutEntity.Creator = userCode;
                                    productOutEntity.BusinessId = dispitchEnt.Id;
                                    lstProductOut.Add(productOutEntity);

                                    stockItem.PieceQty = stockItem.PieceQty - offsetQty;
                                    break;
                                }
                            }
                        }

                        #region 更新唛头状态
                        var workOrderEntity = _plWorkOrderService.Get_ExpressionEntity(t => t.WorkOrder == item.WorkOrder);
                        if (workOrderEntity != null)
                        {
                            //var markList = _markService.Get_ExpressionList(t => t.WorkOrder == workOrderEntity.WorkOrder && t.Status == "6");
                            var markList = _markService.Get_ExpressionList(t => t.WorkOrder == workOrderEntity.WorkOrder);
                            foreach (var mark in markList)
                            {
                                mark.Status = "5";
                                mark.ModifyBy = CurrentAccount.UserCode;
                                mark.ModifyTime = DateTime.Now;
                            }
                            lstMark.AddRange(markList);
                        }
                        #endregion
                    }

                    lstProductStock.AddRange(productStockList);
                    #endregion
                }

                #region 同步SAP
                if (SAPSyncSwitch?.ItemValue == "1")
                {
                    #region IF150 交货单修改
                    IF150 sapRequest1 = new IF150();
                    sapRequest1.HEAD = new SapHeadDto();
                    sapRequest1.HEAD.INIF_ID = SAPInterface.IF150.ToString();

                    sapRequest1.RSQ_DATA = new IF150_RSQ_DATA();
                    IF150_DATA IF150_DATA = new IF150_DATA();
                    IF150_DATA.ZGZ = entity.PostMark;
                    IF150_DATA.VSTEL = factoryCode ?? "";
                    IF150_DATA.VBELN = entity.DocNum ?? "";
                    IF150_DATA.ZFPN = entity.InvoiceNO ?? "";
                    IF150_DATA.ZTDN = entity.LoadingBill ?? "";
                    IF150_DATA.ZJS = entity.BoxNum == null ? "" : entity.BoxNum.ToString() ?? "";
                    IF150_DATA.ZJZID = entity.ContainerID ?? "";
                    IF150_DATA.ZFXN = entity.SealingNo ?? "";
                    IF150_DATA.ZCID = entity.CarNumber ?? "";
                    IF150_DATA.ZCCG = entity.ForkliftWorker ?? "";
                    IF150_DATA.ZMG = entity.WoodWorker ?? "";
                    IF150_DATA.ZFHR = entity.Operator ?? "";
                    IF150_DATA.ZDAT3 = DateTime.Now.ToString("yyyyMMdd");
                    IF150_DATA.ZTIM3 = DateTime.Now.ToString("HHmmss");
                    IF150_DATA.ZNAM3 = CurrentAccount.UserCode + "-" + CurrentAccount.UserName ?? "";
                    IF150_DATA.WADAT_IST = entity.PostDate.Value.ToString("yyyyMMdd");
                    sapRequest1.RSQ_DATA.IS_DATA = IF150_DATA;

                    List<IF150_ITEM> IT_ITEM = new List<IF150_ITEM>();
                    var materialList = _materialService.Get_ExpressionList(t => lstMaterialCode.Contains(t.MaterialCode)).ToList();
                    foreach (var groupItem in lstProductOut.GroupBy(t => t.MaterialCode))
                    {
                        int i = 1;
                        foreach (var item in groupItem)
                        {
                            IF150_ITEM IF150_ITEM = new IF150_ITEM();
                            IF150_ITEM.POSNR = item.LineNum ?? "";
                            if (groupItem.Count() > 1)
                            {
                                IF150_ITEM.ZPOSNR = i.ToString() ?? "";
                            }
                            IF150_ITEM.VGBEL = item.ProductOrder ?? "";
                            IF150_ITEM.VGPOS = item.OrderLine ?? "";
                            IF150_ITEM.MATNR = materialList.Find(t => t.MaterialCode == groupItem.Key)?.SAPMaterialCode ?? "";
                            IF150_ITEM.LFIMG = item.PieceQty.ToString() ?? "";
                            IF150_ITEM.LGORT = item.LocationCode ?? "";
                            IF150_ITEM.CHARG = "";
                            IT_ITEM.Add(IF150_ITEM);

                            i += 1;
                        }
                    }
                    sapRequest1.RSQ_DATA.IT_ITEM = IT_ITEM;
                    var sapResult1 = SAPHelper.Instance.PostToSAP(sapRequest1.HEAD.INIF_ID, sapRequest1);
                    if (!sapResult1.Flag)
                        return AjaxResult(false, sapResult1.Msg);

                    //entity.IsPosted = sapResult1.Flag ? "1" : "";
                    //entity.PostedMsg = sapResult1.Msg;
                    //entity.PostedTime = DateTime.Now;
                    //entity.PostedUser = CurrentAccount.UserCode + "-" + CurrentAccount.UserName;
                    //entity.SAP_VBELN = getValue(JObject.Parse(sapResult1.Data), "EV_VBLEN");
                    //entity.SAP_MBLNR = getValue(JObject.Parse(sapResult1.Data), "EV_MBLNR");
                    foreach (var dispitchEnt in dispitchList)
                    {
                        dispitchEnt.IsPosted = sapResult1.Flag ? "1" : "";
                        dispitchEnt.PostedMsg = sapResult1.Msg;
                        dispitchEnt.PostedTime = DateTime.Now;
                        dispitchEnt.PostedUser = CurrentAccount.UserCode + "-" + CurrentAccount.UserName;
                        dispitchEnt.SAP_VBELN = getValue(JObject.Parse(sapResult1.Data), "EV_VBLEN");
                        dispitchEnt.SAP_MBLNR = getValue(JObject.Parse(sapResult1.Data), "EV_MBLNR");
                    }
                    #endregion

                    #region IF106 交货单过账
                    //IF106 sapRequest = new IF106();
                    //sapRequest.HEAD = new SapHeadDto();
                    //sapRequest.HEAD.INIF_ID = SAPInterface.IF106.ToString();

                    //sapRequest.RSQ_DATA = new IF106_RSQ_DATA();
                    //IF106_HEAD IF106_HEAD = new IF106_HEAD();
                    //IF106_HEAD.ZGZ = entity.PostMark ?? "";
                    //IF106_HEAD.VSTEL = entity.FactoryCode ?? "";
                    //IF106_HEAD.VBELN = entity.DocNum ?? "";
                    //IF106_HEAD.WADAT_IST = DateTime.Now.ToString("yyyyMMdd");
                    //IF106_HEAD.ZMESDATE = DateTime.Now.ToString("yyyyMMdd");
                    //IF106_HEAD.ZMESTIME = DateTime.Now.ToString("HHmmss");
                    //sapRequest.RSQ_DATA.IS_HEAD = IF106_HEAD;

                    //var sapResult = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                    //if (!sapResult.Flag)
                    //    return AjaxResult(false, sapResult.Msg);
                    #endregion

                    //entity.IsPosted = sapResult.Flag ? "1" : "";
                    //entity.PostedMsg = sapResult.Msg;
                    //entity.PostedTime = DateTime.Now;
                    //entity.PostedUser = CurrentAccount.UserCode + "-" + CurrentAccount.UserName;
                    //entity.SAP_VBELN = getValue(JObject.Parse(sapResult.Data), "EV_VBLEN");
                    //entity.SAP_MBLNR = getValue(JObject.Parse(sapResult.Data), "EV_MBLNR");

                }
                #endregion

                var msg = "";
                TransactionOptions transactionOption = new TransactionOptions();
                //设置事务隔离级别
                transactionOption.IsolationLevel = System.Transactions.IsolationLevel.ReadCommitted;
                // 设置事务超时时间为60秒
                transactionOption.Timeout = new TimeSpan(0, 0, 60);
                using (var ts = new TransactionScope(TransactionScopeOption.Required, transactionOption))
                //using (var ts = new TransactionScope())
                {
                    //_Service.SaveEntity(entity.Id, entity, out msg);
                    _Service.SaveEntity_List(true, "", dispitchList, out msg);

                    if (lstProductStock.Count > 0)
                        _productStockService.SaveEntity_List(true, userCode, lstProductStock, out msg);//扣减库存

                    if (lstProductOut.Count > 0)
                        _productOutService.SaveEntity_List(false, userCode, lstProductOut, out msg);

                    if (lstMark.Count > 0)
                        _markService.SaveEntity_List(true, "", lstMark, out msg);

                    ts.Complete();
                }

                result.returnMsg = Language.GetText("Common.Success");//操作成功
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
            catch (Exception ex)
            {
                result.success = false;
                result.returnMsg = Language.GetText("Common.ErrorWithOther2") + ex.Message;//操作失败：
                result.statusCode = ((int)HttpStatusCode.InternalServerError).ToString();
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
        }
        #endregion

        #region 发货单退货
        /// <summary>
        /// 发货单退货
        /// </summary>
        /// <param name="jo"></param>
        /// <returns></returns>
        [HttpPost]
        [Route("ProductDispatchItemTakOff")]
        public HttpResponseMessage ProductDispatchItemTakOff(JObject jo)
        {
            try
            {
                //参数转实体
                var entity = JsonConvert.DeserializeObject<MM_ProductDispatchItemEntity>(getValue(jo, "Entity"));

                entity.ModifyBy = CurrentAccount.UserCode;
                entity.ModifyTime = DateTime.Now;
                entity.ModifyTime = DateTime.Now;
                entity.PostMark = "R";

                #region 同步SAP
                var factoryCode = entity.FactoryCode;
                var SAPSyncSwitch = _keyParameterItemService.Get_ExpressionEntity(t => t.EnCode == "Switch" && t.ItemCode == "SAPSync"
                    && t.Remark1 == factoryCode);
                if (SAPSyncSwitch?.ItemValue == "1")
                {

                    #region IF106 交货单冲销
                    IF106 sapRequest = new IF106();
                    sapRequest.HEAD = new SapHeadDto();
                    sapRequest.HEAD.INIF_ID = SAPInterface.IF106.ToString();

                    sapRequest.RSQ_DATA = new IF106_RSQ_DATA();
                    IF106_HEAD IF106_HEAD = new IF106_HEAD();
                    IF106_HEAD.ZGZ = entity.PostMark ?? "";
                    IF106_HEAD.VSTEL = entity.FactoryCode ?? "";
                    IF106_HEAD.VSTEL = entity.DocNum ?? "";
                    IF106_HEAD.WADAT_IST = DateTime.Now.ToString("yyyyMMdd");
                    IF106_HEAD.ZMESDATE = DateTime.Now.ToString("yyyyMMdd");
                    IF106_HEAD.ZMESTIME = DateTime.Now.ToString("HHmmss");
                    sapRequest.RSQ_DATA.IS_HEAD = IF106_HEAD;

                    var sapResult = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                    if (!sapResult.Flag)
                        return AjaxResult(false, sapResult.Msg);
                    #endregion

                    entity.Off_IsPosted = sapResult.Flag ? "1" : ""; ;
                    entity.Off_PostedMsg = sapResult.Msg;
                    entity.Off_PostedTime = DateTime.Now;
                    entity.Off_PostedUser = CurrentAccount.UserCode + "-" + CurrentAccount.UserName;
                    entity.Off_SAP_MBLNR = getValue(JObject.Parse(sapResult.Data), "EV_MBLNR");
                    entity.Off_SAP_VBELN = getValue(JObject.Parse(sapResult.Data), "EV_VBLEN");
                }
                #endregion

                string msg = "";
                int isok = _dispatchItemService.SaveEntity(entity.Id, entity, out msg);

                return AjaxResult(true, Language.GetText("Common.Success"));//操作成功
            }
            catch (Exception ex)
            {
                return AjaxResult(false, Language.GetText("Common.ErrorWithOther2") + ex.Message);
            }
        }
        #endregion
    }
}
