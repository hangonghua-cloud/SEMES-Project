        /// <summary>
        /// 功能描述: 保存表单（新增、修改）
        /// 创　　建: admin
        /// 创建日期: 2021-10-13 14:01:18
        /// 任务编号: 成品发货明细
        /// </summary>
        /// <param name="jo">json参数, 包含keyValue 主键值, entity 实体对象 </param>
        /// <returns></returns>
        [HttpPost]
        [Route("SaveMM_ProductDispatchItem")]
        public HttpResponseMessage SaveMM_ProductDispatchItem(JObject jo)
        {
            var userCode = CurrentAccount.UserCode;
            var userName = CurrentAccount.UserName;
            var result = new ResponseResult<object>();
            result.resultData = null;

            if (jo == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_5");//参数不能为空！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            //判断主键内容是否为空, 为空新增, 有值修改
            if (jo.SelectToken("KeyValue") == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_6");//缺少KeyValue参数！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            if (jo.SelectToken("Entity") == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_7");//缺少Entity参数！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            //if (string.IsNullOrEmpty(userCode))
            //{
            //result.success = false;
            //result.returnMsg = "用户名不能为空！";
            //return Request.CreateResponse(HttpStatusCode.OK, result);
            //}

            try
            {
                //业务服务类
                MM_ProductDispatchItem_Service _Service = new MM_ProductDispatchItem_Service();
                //参数转实体
                MM_ProductDispatchItemEntity entity = JsonConvert.DeserializeObject<MM_ProductDispatchItemEntity>(getValue(jo, "Entity"));


                string keyValue = getValue(jo, "KeyValue");
                string queryJson = getValue(jo, "Entity");

                if (!string.IsNullOrEmpty(keyValue))//修改
                {
                    entity.ModifyBy = CurrentAccount.UserCode;
                    entity.ModifyTime = DateTime.Now;

                    #region 同步SAP
                    var factoryCode = entity.FactoryCode;
                    var SAPSyncSwitch = _keyParameterItemService.Get_ExpressionEntity(t => t.EnCode == "Switch" && t.ItemCode == "SAPSync"
                        && t.Remark1 == factoryCode);
                    if (SAPSyncSwitch?.ItemValue == "1")
                    {
                        #region IF150 交货单修改
                        IF150 sapRequest1 = new IF150();
                        sapRequest1.HEAD = new SapHeadDto();
                        sapRequest1.HEAD.INIF_ID = SAPInterface.IF150.ToString();

                        sapRequest1.RSQ_DATA = new IF150_RSQ_DATA();
                        IF150_DATA IF150_DATA = new IF150_DATA();
                        IF150_DATA.ZGZ = "";
                        IF150_DATA.VSTEL = factoryCode ?? "";
                        IF150_DATA.VBELN = entity.DocNum ?? "";
                        IF150_DATA.ZFPN = entity.InvoiceNO ?? "";
                        IF150_DATA.ZTDN = entity.LoadingBill ?? "";
                        IF150_DATA.ZJS = entity.BoxNum == null ? "" : entity.BoxNum.ToString() ?? "";
                        IF150_DATA.ZJZID = entity.ContainerID ?? "";
                        IF150_DATA.ZFXN = entity.SealingNo ?? "";
                        IF150_DATA.ZCID = entity.CarNumber ?? "";
                        IF150_DATA.ZCCG = entity.ForkliftWorker ?? "";
                        IF150_DATA.ZMG = entity.WoodWorker ?? "";
                        IF150_DATA.ZFHR = entity.Operator ?? "";
                        IF150_DATA.ZDAT3 = DateTime.Now.ToString("yyyyMMdd");
                        IF150_DATA.ZTIM3 = DateTime.Now.ToString("HHmmss");
                        IF150_DATA.ZNAM3 = CurrentAccount.UserCode + "-" + CurrentAccount.UserName ?? "";
                        IF150_DATA.WADAT_IST = "";
                        IF150_DATA.ZMFHD = DateTime.Now.ToString("yyyyMMdd");
                        sapRequest1.RSQ_DATA.IS_DATA = IF150_DATA;

                        var sapResult1 = SAPHelper.Instance.PostToSAP(sapRequest1.HEAD.INIF_ID, sapRequest1);
                        if (!sapResult1.Flag)
                            return AjaxResult(false, sapResult1.Msg);

                        entity.SAP_VBELN = getValue(JObject.Parse(sapResult1.Data), "EV_VBLEN");
                        #endregion
                    }
                    #endregion
                }
                else
                {
                    entity.Creator = CurrentAccount.UserCode;
                    entity.CreateTime = DateTime.Now;
                }

                string msg = "";
                int isok = _Service.SaveEntity(keyValue, entity, out msg);
                result.success = isok > 0 ? true : false;
                result.returnMsg = isok > 0 ? Language.GetText("Common.Success") : msg;//操作成功
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
            catch (Exception ex)
            {
                result.success = false;
                result.returnMsg = Language.GetText("Common.ErrorWithOther2") + ex.Message;//操作失败：
                result.statusCode = ((int)HttpStatusCode.InternalServerError).ToString();
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
        }

        /// <summary>
        /// 功能描述: 导入 保存表单（新增、修改）
        /// 创　　建: admin
        /// 创建日期: 2021-10-13 14:01:18
        /// 任务编号: 成品发货明细
        /// </summary>
        /// <param name="jo">json参数, entity 实体对象数组</param>
        /// <returns></returns>
        [HttpPost]
        [Route("SaveBatchMM_ProductDispatchItem")]
        public HttpResponseMessage SaveBatchMM_ProductDispatchItem(JObject jo)
        {
            var userCode = CurrentAccount.UserCode;
            var userName = CurrentAccount.UserName;
            var result = new ResponseResult<object>();
            result.resultData = null;

            if (jo == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_5");//参数不能为空！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            //创建人编码 为空判断
            if (jo.SelectToken("CreatedByCode") == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_10");//缺少CreatedByCode参数！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            //创建人姓名 为空判断
            if (jo.SelectToken("CreatedByName") == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_11");//缺少CreatedByName参数！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            if (jo.SelectToken("Entity") == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_7");//缺少Entity参数！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            try
            {
                List<dynamic> upload_entity_list = JsonConvert.DeserializeObject<List<dynamic>>(getValue(jo, "Entity"));

                string keyValue = getValue(jo, "KeyValue");
                string CreatedByName = getValue(jo, "CreatedByName");
                string CreatedByCode = getValue(jo, "CreatedByCode");

                MM_ProductDispatchItem_Service _Service = new MM_ProductDispatchItem_Service();
                string msg = "";
                int isok = 1;
                //取出旧所有数据
                var old_entity_list = _Service.GetList("", out msg);
                //插入数组
                List<MM_ProductDispatchItemEntity> Insert_entity_list = new List<MM_ProductDispatchItemEntity>();
                //更新数组
                List<MM_ProductDispatchItemEntity> Update_entity_list = new List<MM_ProductDispatchItemEntity>();
                foreach (var item in upload_entity_list)
                {
                    try
                    {
                        MM_ProductDispatchItemEntity entity = new MM_ProductDispatchItemEntity();
                        //发货单号
                        entity.DocNum = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_12")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_12")];//发货单号
                        //柜号
                        entity.ContainerNO = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_13")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_13")];//柜号
                        //客户PO号
                        entity.CustomerPO = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_14")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_14")];//客户PO号
                        //计划发货数量/托
                        entity.PalletQty = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_15")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_15")];//计划发货数量/托
                        //计划发货数量/盒
                        entity.BoxQty = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_16")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_16")];//计划发货数量/盒
                        //集装箱ID
                        entity.ContainerID = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_17")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_17")];//集装箱ID
                        //车牌号
                        entity.CarNumber = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_18")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_18")];//车牌号
                        //叉车工
                        entity.ForkliftWorker = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_19")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_19")];//叉车工
                        //木工
                        entity.WoodWorker = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_20")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_20")];//木工
                        //备注
                        entity.Remark = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_21")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_21")];//备注
                        //附件
                        entity.AttachId = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_22")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_22")];//附件
                        //发货人
                        entity.Operator = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_23")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_23")];//发货人
                        //发货状态
                        entity.Status = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_24")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_24")];//发货状态
                        //创建人
                        entity.Creator = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_25")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_25")];//创建人
                        //创建时间
                        entity.CreateTime = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_26")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_26")];//创建时间
                        //最后修改人
                        entity.ModifyBy = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_27")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_27")];//最后修改人
                        //最后修改时间
                        entity.ModifyTime = item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_28")] == null ? "" : item[Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_28")];//最后修改时间
                                                                                                                                                                                                                               //状态(启用/停用)
                                                                                                                                                                                                                               //entity.Status = item["状态"] == null ? "启用" : item["状态"];
                                                                                                                                                                                                                               //创建日期// DateTime.Now;


                        //取出相似编码， 提示： 此处换上表中唯一编码（不是主键）
                        MM_ProductDispatchItemEntity old_entity = old_entity_list.FirstOrDefault(x => x.Id == entity.Id);
                        //判断旧列表中是否存在此编码
                        if (old_entity == null)
                        {
                            entity.Create();
                            //保存数组
                            Insert_entity_list.Add(entity);
                        }
                        else
                        {
                            entity.Id = old_entity.Id;
                            Update_entity_list.Add(entity);
                        }
                    }
                    catch (Exception ex)
                    {

                    }
                }

                if (Insert_entity_list.Count > 0)
                {
                    //批量新增
                    isok = _Service.SaveEntity_List(false, CreatedByName, Insert_entity_list, out msg);
                }
                if (Update_entity_list.Count > 0)
                {
                    //批量修改
                    isok = _Service.SaveEntity_List(true, CreatedByName, Update_entity_list, out msg);
                }

                result.success = isok > 0 ? true : false;
                result.returnMsg = isok > 0 ? Language.GetText("Common.Success") : msg;//操作成功
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
            catch (Exception ex)
            {
                result.success = false;
                result.returnMsg = Language.GetText("Common.ErrorWithOther2") + ex.Message;//操作失败：
                result.statusCode = ((int)HttpStatusCode.InternalServerError).ToString();
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
        }

        /// <summary>
        /// 功能描述: 删除, 通过主键删除
        /// 创　　建: admin
        /// 创建日期: 2021-10-13 14:01:18
        /// 任务编号: 成品发货明细
        /// </summary>
        /// <param name="jo">json参数</param>
        [HttpPost]
        [Route("DeleteMM_ProductDispatchItem")]
        public HttpResponseMessage DeleteMM_ProductDispatchItem(JObject jo)
        {
            var result = new ResponseResult<object>();
            result.resultData = null;

            if (jo == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_5");//参数不能为空！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            try
            {
                var userCode = CurrentAccount.UserCode;
                var userName = CurrentAccount.UserName;

                if (jo.SelectToken("Entity") == null)
                {
                    result.success = false;
                    result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_7");//缺少Entity参数！
                    return Request.CreateResponse(HttpStatusCode.OK, result);
                }
                //业务服务层
                MM_ProductDispatchItem_Service _Service = new MM_ProductDispatchItem_Service();
                MM_ProductDispatchItemEntity entity = JsonConvert.DeserializeObject<MM_ProductDispatchItemEntity>(getValue(jo, "Entity"));
                string Id = entity.Id;
                MM_ProductDispatchItemEntity model = _Service.GetEntity(Id);
                if (model == null)
                {
                    result.success = false;
                    result.returnMsg = Id + " 对象不存在";//对象不存在
                    return Request.CreateResponse(HttpStatusCode.OK, result);
                }

                //删除
                string msg = "";
                int isok = _Service.DeleteEntity(Id, out msg, userName);
                result.success = isok > 0 ? true : false;
                if (isok > 0)
                    result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_31");//删除操作成功
                else
                    result.returnMsg = "删除操作失败: " + msg;//删除操作失败:
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
            catch (Exception ex)
            {
                result.success = false;
                result.returnMsg = Language.GetText("Common.ErrorWithOther2") + ex.Message;//操作失败：
                result.statusCode = ((int)HttpStatusCode.InternalServerError).ToString();
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
        }

        /// <summary>
        /// 功能描述: 假删除, 通过主键删除, 删除标记设置为0
        /// 创　　建: admin
        /// 创建日期: 2021-10-13 14:01:18
        /// 任务编号: 成品发货明细
        /// </summary>
        /// <param name="jo">json参数</param>
        [HttpPost]
        [Route("RemoveMM_ProductDispatchItem")]
        public HttpResponseMessage RemoveMM_ProductDispatchItem(JObject jo)
        {
            var result = new ResponseResult<object>();
            result.resultData = null;

            if (jo == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_5");//参数不能为空！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            try
            {
                var userCode = CurrentAccount.UserCode;
                var userName = CurrentAccount.UserName;

                if (jo.SelectToken("Entity") == null)
                {
                    result.success = false;
                    result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_7");//缺少Entity参数！
                    return Request.CreateResponse(HttpStatusCode.OK, result);
                }
                //业务服务层
                MM_ProductDispatchItem_Service _Service = new MM_ProductDispatchItem_Service();
                MM_ProductDispatchItemEntity entity = JsonConvert.DeserializeObject<MM_ProductDispatchItemEntity>(getValue(jo, "Entity"));
                string Id = entity.Id;
                MM_ProductDispatchDetail_Service _DetailService = new MM_ProductDispatchDetail_Service();

                //删除
                _DetailService.RemoveForm(t => t.DispatchItemId == Id);
                int isok = _Service.RemoveForm(Id, userName);


                result.success = isok > 0 ? true : false;
                if (isok > 0)
                    result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_31");//删除操作成功
                else
                    result.returnMsg = Language.GetText("MaterialManage.MM_ProductDispatchItemController.Tips_33");//删除操作失败
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
            catch (Exception ex)
            {
                result.success = false;
                result.returnMsg = Language.GetText("Common.ErrorWithOther2") + ex.Message;//操作失败：
                result.statusCode = ((int)HttpStatusCode.InternalServerError).ToString();
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
        }

