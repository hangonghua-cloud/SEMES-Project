<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }

    .canvas .property-area-container > div.content .side-panel-property-area-body {
        overflow-y: visible;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.PlanApp.WorkOrderSort.edit.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.PlanApp.WorkOrderSort.edit.Tips_2'|translate}}</button>
    <button ng-click="vm.deleteForm()" class="btn side-panel-button" ng-show="vm.IsShowDelete">{{'Siemens.SimaticIT.PlanApp.WorkOrderSort.edit.Tips_3'|translate}}</button>
    <button ng-click="vm.addForm()" class="btn side-panel-button">{{'Siemens.SimaticIT.PlanApp.WorkOrderSort.edit.Tips_4'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form"
                       sit-layout="Horizontal"
                       sit-type="Fixed"
                       sit-mode="edit"
                       sit-columns="2">
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.RuleCode" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.PlanApp.WorkOrderSort.edit.Tips_5'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.RuleName" sit-validation="{required: true}"
                      sit-read-only="vm.isReadField">{{'Siemens.SimaticIT.PlanApp.WorkOrderSort.edit.Tips_6'|translate}}</sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.FieldName.value" sit-validation="{required: true}"
                      sit-options="vm.FieldName.options" sit-to-display="'ItemName'" sit-to-keep="'ItemCode'"
                      sit-read-only="false">{{'Siemens.SimaticIT.PlanApp.WorkOrderSort.edit.Tips_7'|translate}}</sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.IsAsc.value" sit-validation="{required: false}"
                      sit-options="vm.IsAsc.options" sit-to-display="'ItemName'" sit-to-keep="'ItemCode'"
                      sit-read-only="false">{{'Siemens.SimaticIT.PlanApp.WorkOrderSort.edit.Tips_8'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.SortCode" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.PlanApp.WorkOrderSort.edit.Tips_9'|translate}}</sit-property>
    </sit-property-grid>
</div>
<div id="itemlist" style="width:calc(100% - 2px); height: calc(100% - 180px);margin-top: 6px; padding:5px 16px 0 16px;clear: both; display: block;overflow-y: auto;">
    <div ui-grid="vm.gridOptionsItem" ui-grid-selection ui-grid-resize-columns ui-grid-auto-resize class="uigrid gridItem"></div>
</div>