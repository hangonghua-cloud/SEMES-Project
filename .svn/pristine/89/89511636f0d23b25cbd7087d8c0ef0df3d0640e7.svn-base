<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.edit.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.edit.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2" style="margin-left: 4px;">
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.PrinterOrder" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.edit.Tips_3'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.PlanOrder" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.edit.Tips_4'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.WorkOrder" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.edit.Tips_5'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialCode" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.edit.Tips_6'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Cylinder" sit-validation="{required: false}"
                          sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.edit.Tips_7'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.DesignColour" sit-validation="{required: false}"
                          sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.edit.Tips_8'|translate}}</sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.MeterNum" sit-validation="{required: true, min: 0}"
                          sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.edit.Tips_9'|translate}}</sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.ReelNum" sit-validation="{required: true, min: 0}"
                          sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.edit.Tips_10'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Reel" sit-validation="{required: false}"
                          sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.edit.Tips_11'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Pallet" sit-validation="{required: false}"
                          sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.edit.Tips_12'|translate}}</sit-property>
            <sit-property sit-widget="sit-datepicker" sit-value="vm.OrderDate" sit-validation="{required: false}"
                          sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.edit.Tips_13'|translate}}</sit-property>
            <sit-property sit-widget="sit-datepicker" sit-value="vm.DeliveryDate" sit-validation="{required: true}"
                          sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.edit.Tips_14'|translate}}</sit-property>
            <sit-property ng-show="false"></sit-property>
            <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Packaging" sit-validation="{required: false}"
                          sit-read-only="false" style="height: 80px;">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.edit.Tips_15'|translate}}</sit-property>
            <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                          sit-read-only="false" style="height: 80px;">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.edit.Tips_16'|translate}}</sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>
