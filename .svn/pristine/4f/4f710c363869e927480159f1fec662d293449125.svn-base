using ALP.Application.Entity.HTTPEntity;
using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace ALP.Application.Entity.SAPEntity.ToSAP
{
    /// <summary>
    /// 查询SAP库存
    /// </summary>
    public class IF135 : SAPRequestDto
    {
        public IF135_RSQ_DATA RSQ_DATA { get; set; }
    }

    public class IF135_RSQ_DATA
    {
        public List<IF135_DATA> IT_DATA { get; set; }

    }

    public class IF135_DATA
    {
        /// <summary>
        /// 工厂
        /// </summary>
        public string WERKS { get; set; } = "";
        /// <summary>
        /// 仓库
        /// </summary>
        public string ZCK { get; set; } = "";
        /// <summary>
        /// 库存地点
        /// </summary>
        public string LGORT { get; set; } = "";
        /// <summary>
        /// 物料编号
        /// </summary>
        public string MATNR { get; set; } = "";
    }
    /// <summary>
    /// 返回结果
    /// </summary>

    public class IF135_RETURN
    {
        /// <summary>
        /// 工厂
        /// </summary>
        public string WERKS { get; set; } = "";
        /// <summary>
        /// 名称
        /// </summary>
        public string NAME1 { get; set; } = "";
        /// <summary>
        /// 物料编号
        /// </summary>
        public string MATNR { get; set; } = "";
        /// <summary>
        /// 物料描述
        /// </summary>
        public string MAKTX { get; set; } = "";
        /// <summary>
        /// 长文本
        /// </summary>
        public string GRUN { get; set; } = "";
        /// <summary>
        /// 物料类型
        /// </summary>
        public string MTART { get; set; } = "";
        /// <summary>
        /// 物料组
        /// </summary>
        public string MATKL { get; set; } = "";
        /// <summary>
        /// 仓库
        /// </summary>
        public string ZCK { get; set; } = "";
        /// <summary>
        /// 库存地点
        /// </summary>
        public string LGORT { get; set; } = "";
        /// <summary>
        /// 批号
        /// </summary>
        public string CHARG { get; set; } = "";
        /// <summary>
        /// 非限制使用的估价的库存
        /// </summary>
        public decimal? LABST { get; set; }
        /// <summary>
        /// 基本计量单位
        /// </summary>
        public string MEINS { get; set; } = "";
        /// <summary>
        /// 特殊库存标识
        /// </summary>
        public string SOBKZ { get; set; } = "";
        /// <summary>
        /// 销售和分销凭证号
        /// </summary>
        public string VBELN { get; set; } = "";
        /// <summary>
        /// 销售和分销凭证的项目号
        /// </summary>
        public string POSNR { get; set; } = "";
    }
}
