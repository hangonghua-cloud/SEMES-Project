<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.FactoryModelApp.ModelLevel.ModelLeveledit.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.FactoryModelApp.ModelLevel.ModelLeveledit.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="1">
        <!-- TODO: Put here the properties of the entity managed by the service -->
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.LevelCode" width:200
                sit-validation="{required: true}"
                sit-read-only="true">{{'Siemens.SimaticIT.FactoryModelApp.ModelLevel.ModelLeveledit.Tips_3'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.LevelName" width:200
                sit-validation="{required: true}"
                sit-read-only="false">{{'Siemens.SimaticIT.FactoryModelApp.ModelLevel.ModelLeveledit.Tips_4'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Describe" width:200
                sit-validation="{required: false}"
                sit-read-only="false">{{'Siemens.SimaticIT.FactoryModelApp.ModelLevel.ModelLeveledit.Tips_5'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Level" width:200
                sit-validation="{required: true}"
                sit-read-only="true">{{'Siemens.SimaticIT.FactoryModelApp.ModelLevel.ModelLeveledit.Tips_6'|translate}}</sit-property>
</sit-property-grid>
</div>
