<style>
    .MainCommandActionButton {
        margin-top: 20px !important;
    }
</style>
<div id="itemlist" class="content-area content-area-relative" style="height: calc(19% - 0px) !important">
    <!--查询条件与功能按钮-->
    <div class="col-md-40" style="margin-left: 15px;">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit"
                               sit-columns="8">
                <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value"
                              sit-options="vm.typeFactory.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'">
                    {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentSpareParts.EP_EquipmentSparePartslist.Tips_1'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.EquipmentId" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentSpareParts.EP_EquipmentSparePartslist.Tips_2'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.EquipmentName" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentSpareParts.EP_EquipmentSparePartslist.Tips_3'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.SparePartsId" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentSpareParts.EP_EquipmentSparePartslist.Tips_4'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.SparePartsName" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentSpareParts.EP_EquipmentSparePartslist.Tips_5'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.SpecificationsModels"
                              sit-read-only="false" style="max-width:300px;">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentSpareParts.EP_EquipmentSparePartslist.Tips_6'|translate}}</sit-property>
                <!--<sit-property sit-widget="sit-text" sit-value="vm.searchParams.Manufacturer" sit-read-only="false" style="max-width:300px;">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentSpareParts.EP_EquipmentSparePartslist.Tips_7'|translate}}</sit-property>-->
                <sit-property sit-widget="sit-select" sit-read-only="false" sit-options="vm.TypeConfig.options"
                              sit-to-keep="'ItemValue'" sit-validation="{required: false}"
                              sit-value="vm.TypeConfig.selectedOption" sit-change="vm.selectCodad" sit-to-display="'ItemName'">
                    {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentSpareParts.EP_EquipmentSparePartslist.Tips_8'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-datepicker" sit-value="vm.StartDate" style="max-width:300px;"
                              sit-format="'yyyy-MM-dd'" sit-validation="{required: false}" sit-read-only="false">
                    {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentSpareParts.EP_EquipmentSparePartslist.Tips_9'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-datepicker" sit-value="vm.EndDate" style="max-width:300px;"
                              sit-format="'yyyy-MM-dd'" sit-validation="{required: false}" sit-read-only="false">

                </sit-property>
                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                                 :sit-tooltip="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentSpareParts.EP_EquipmentSparePartslist.Tips_10'|translate}}" ng-click="vm.searchButtonHandler" :sit-label="{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentSpareParts.EP_EquipmentSparePartslist.Tips_10'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div>
