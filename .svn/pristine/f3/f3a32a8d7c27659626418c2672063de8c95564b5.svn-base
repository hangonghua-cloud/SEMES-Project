<style>
    .MainCommandActionButton {
        margin-top: 20px !important;
    }

    .green {
        color: rgb(38, 228, 31)
    }

    .red {
        color: red
    }
</style>
<div id="itemlist" class="content-area content-area-relative" style="height: calc(93% - 30px) !important">
    <!--查询条件与功能按钮-->
    <div class="col-md-40" style="margin-left: 15px;">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit"
                               sit-columns="8">
                <sit-property sit-widget="sit-select" sit-read-only="false" style="max-width:300px;"
                              sit-options="vm.typeFactory.options" sit-to-keep="'ResourceCode'" sit-validation="{required: false}"
                              sit-value="vm.typeFactory.value" sit-to-display="'ResourceName'">
                    {{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_1'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-select" sit-read-only="false" style="max-width:300px;"
                              sit-options="vm.TypeConfig.options" sit-to-keep="'ItemValue'" sit-validation="{required: false}"
                              sit-value="vm.TypeConfig.value" sit-to-display="'ItemName'">
                    {{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_2'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.TestMethodCoading" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_3'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.TestMethodName" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_4'|translate}}</sit-property>
                <sit-property sit-widget="sit-select" sit-read-only="false" style="max-width:300px;"
                              sit-options="vm.StatusConfig.options" sit-to-keep="'ItemValue'" sit-validation="{required: false}"
                              sit-value="vm.StatusConfig.value" sit-to-display="'ItemName'">
                    {{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_5'|translate}}
                </sit-property>
                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                                 :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_6'|translate}}" ng-click="vm.searchButtonHandler" :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_6'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div>
    <!--右侧功能按钮-->
    <sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">




        <!-- <sit-command sit-icon="fa-minus-circle" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_7'|translate}}" ng-click="vm.delete3ButtonHandler"
                :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_7'|translate}}" ng-show="vm.isProcessButtonVisible" sit-type="main"></sit-command>
        <sit-command sit-icon="fa-pencil-square" sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_8'|translate}}" ng-click="vm.edit3ButtonHandler"
                :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_8'|translate}}" ng-show="vm.isProcessButtonVisible" sit-type="main"></sit-command> -->
        <sit-command sit-icon="fa-plus-square " sit-name="com.siemens.customcommand.add" ng-click="vm.add3ButtonHandler"
                     :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_9'|translate}}" :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_9'|translate}}" ng-show="vm.isShowProcessVisible" sit-type="main"></sit-command>

        <sit-command sit-icon="fa-trash-o" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_10'|translate}}"
                     ng-click="vm.delete2ButtonHandler" :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_10'|translate}}" ng-show="vm.isDetailButtonVisible" sit-type="main">
        </sit-command>
        <sit-command sit-icon="fa-pencil-square-o " sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_11'|translate}}"
                     ng-click="vm.edit2ButtonHandler" :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_11'|translate}}" ng-show="vm.isDetailButtonVisible" sit-type="main">
        </sit-command>
        <sit-command sit-icon="fa-plus-square-o " sit-name="com.siemens.customcommand.add"
                     ng-click="vm.add2ButtonHandler" :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_12'|translate}}" :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_12'|translate}}" ng-show="vm.isShowDetailVisible"
                     sit-type="main"></sit-command>


        <sit-command sit-icon="fa-trash" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_13'|translate}}"
                     ng-click="vm.deleteButtonHandler" :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_13'|translate}}" ng-show="vm.isButtonVisible"></sit-command>
        <sit-command sit-icon="fa-pencil" sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_14'|translate}}"
                     ng-click="vm.editButtonHandler" :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_14'|translate}}" ng-show="vm.isButtonVisible"></sit-command>
        <sit-command sit-icon="fa-plus" sit-name="com.siemens.customcommand.add" ng-click="vm.addButtonHandler"
                     :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_15'|translate}}" :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_15'|translate}}" sit-type="main"></sit-command>


    </sit-command-bar>
    <!-- grid列表 -->
    <div id="listClass" style="width:100%; height: 50%; padding:0px 16px 0 16px; margin-top: 30px;">
        <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
             ui-grid-pagination class="uigrid"></div>
    </div>

    <div id="listClass2" class="col-md-40" style="width:100%; height: 46%; padding:0px 16px 0 16px; margin-top: 3px;">
        <sit-tabset>
            <sit-tab heading="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_16'|translate}}" style="background-color: #204d74" select="vm.tabClick1()">
                <div ui-grid="vm.gridItemOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-selection
                     ui-grid-pagination class="uigrid" style="height:230px"></div>
                <!-- <div ui-grid="vm.gridPersonOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection ui-grid-pagination class="uigrid" style="height:99%"></div> -->
            </sit-tab>
            <sit-tab heading="{{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenancelist.Tips_17'|translate}}" style="background-color: #204d74" select="vm.tabClick2()">
                <div ui-grid="vm.gridMaterialOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-selection
                     ui-grid-pagination class="uigrid" style="height:230px"></div>
                <!-- <div ui-grid="vm.gridOptionsDetail" ui-grid-pinning ui-grid-auto-resize ui-grid-selection ui-grid-pagination class="uigrid" style="height:99%"></div> -->
            </sit-tab>

        </sit-tabset>
    </div>

</div>