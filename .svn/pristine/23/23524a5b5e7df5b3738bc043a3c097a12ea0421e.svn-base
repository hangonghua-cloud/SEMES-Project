VERSION '01.13'

///数据字典树形结构数据类型
[@Guid(e3cd17fb-04c8-49d0-8b22-ca5e953ead07)]
PARAMETERTYPE GetTreeList
WITH
    [@Guid(e98edff9-843d-4428-a0c6-e847b379853d)]
    id AS Guid
    [Optional]
    [Length = 255]
    [@Guid(009b437c-96e9-4b9a-85cb-3877c5973f82)]
    label AS string
    [Optional]
    [Length = 255]
    [@Guid(a76e965e-e423-4180-8825-a80314ae9b72)]
    CategoryCode AS string
    [Optional]
    [Length = 255]
    [@Guid(565d9d8a-79d6-4b77-a35c-9701c1186a8a)]
    ParentId AS string
    [Optional]
    [Length = 255]
    [@Guid(d1a43c63-ac45-4b2b-b1e6-5a8031f212cd)]
    icon AS string
    [@Guid(ec2f1bfd-41ce-458e-bfc6-3b05afbe5a5c)]
    expanded AS bool
    [Optional]
    [@Guid(97af5244-857e-4c78-9806-8704f3a28cdd)]
    SortNum AS decimal
    [@Guid(691c23b9-f229-4b61-ab67-07eaa80be4fc)]
    Isvalid AS bool
    [Optional]
    [@Guid(73bb6599-38e1-410d-8242-b90620c86f56)]
    [@GuidRef(f61397bf-4db1-4767-accf-c29a4bf0ddd7, e3cd17fb-04c8-49d0-8b22-ca5e953ead07)]
    children AS list of Siemens.SimaticIT.MasterData.BasicDataManageFBLib.MSModel.Types.GetTreeList
    [Optional]
    [Length = 255]
    [@Guid(92f4bc03-8f45-4be4-b67c-7d544a60602c)]
    CategoryName AS string

///获取工厂建模返回值数据类型
