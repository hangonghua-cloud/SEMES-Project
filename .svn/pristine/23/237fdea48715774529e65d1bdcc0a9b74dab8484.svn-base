<style>
    .MainCommandActionButton {
        margin-top: 20px !important;
    }
</style>
<div id="itemlist" class="content-area content-area-relative" style="height: calc(93% - 30px) !important">
    <!--查询条件与功能按钮-->
    <div class="col-md-40" style="margin-left: 15px;height: calc(13% - 10px) !important">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit"
                               sit-columns="8">
                <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value"
                              sit-options="vm.typeFactory.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'">
                    {{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_1'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.MaterialCode" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_2'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.MaterialName" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_3'|translate}}</sit-property>

                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.Spec" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_4'|translate}}</sit-property>

                <sit-property sit-widget="sit-select" sit-value="vm.MaterialClass.value"
                              sit-options="vm.MaterialClass.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                              style="max-width:300px;">{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_5'|translate}}</sit-property>

                <sit-property sit-widget="sit-select" sit-value="vm.typeOrderType.value"
                              sit-options="vm.typeOrderType.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                              style="max-width:300px;">{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_6'|translate}}</sit-property>

                <!--<sit-property sit-widget="sit-select" sit-value="vm.SmallClass.value" sit-options="vm.SmallClass.options"
                sit-to-display="'ItemName'" sit-to-keep="'ItemValue'" style="max-width:300px;">{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_7'|translate}}</sit-property>-->
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.BOMCode" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_8'|translate}}</sit-property>
                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                                 :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_9'|translate}}" ng-click="vm.searchButtonHandler" :sit-label="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_9'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div>
    <!--右侧功能按钮-->
    <sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">

        <sit-command sit-icon="fa-trash-o" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_10'|translate}}"
                     ng-click="vm.delete2ButtonHandler" :sit-label="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_10'|translate}}" ng-show="vm.isBaseBOMDeleteDetail" sit-type="main">
        </sit-command>
        <sit-command sit-icon="fa-pencil-square-o" sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_11'|translate}}"
                     ng-click="vm.edit2ButtonHandler" :sit-label="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_11'|translate}}" ng-show="vm.isBaseBOMEditDetail" sit-type="main">
        </sit-command>

        <sit-command sit-icon="fa-paste" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_12'|translate}}"
                     ng-click="vm.stickButtonHandler" :sit-label="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_12'|translate}}" ng-show="vm.isBaseBOMPaste"></sit-command>
        <sit-command sit-icon="fa-copy" sit-name="com.siemens.customcommand.copy" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_13'|translate}}"
                     ng-click="vm.CopyButtonHandler" :sit-label="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_13'|translate}}" ng-show="vm.isBaseBOMCopy"></sit-command>

        <sit-command sit-icon="fa-plus-square-o" sit-name="com.siemens.customcommand.add"
                     ng-click="vm.add2ButtonHandler" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_14'|translate}}" :sit-label="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_14'|translate}}" ng-show="vm.isBaseBOMAddDetail"
                     sit-type="main"></sit-command>

        <sit-command sit-icon="fa-trash" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_15'|translate}}"
                     ng-click="vm.deleteButtonHandler" :sit-label="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_15'|translate}}" ng-show="vm.isBaseBOMDelete"></sit-command>

        <sit-command sit-icon="fa-pencil" sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_16'|translate}}"
                     ng-click="vm.editButtonHandler" :sit-label="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_16'|translate}}" ng-show="vm.isBaseBOMEdit"></sit-command>

        <sit-command sit-icon="fa-plus" sit-name="com.siemens.customcommand.add" ng-click="vm.addButtonHandler"
                     :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_17'|translate}}" :sit-label="{{'Siemens.SimaticIT.MaterialApp.BOM.BOMlist.Tips_17'|translate}}" sit-type="main" ng-show="vm.isBaseBOMAdd"></sit-command>
    </sit-command-bar>
    <!-- grid列表 -->
    <div id="listClass" style="width:100%; height: 50%; padding:0px 16px 0 16px; margin-top: 3px;">
        <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
             ui-grid-pagination class="uigrid"></div>
    </div>
    <div id="listClass2" class="col-md-40" style="width:100%; height: 50%; padding:0px 16px 0 16px; margin-top: 3px;">
        <div ui-grid="vm.gridOptionsDetail" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
             ui-grid-pagination class="uigrid"></div>
    </div>
</div>