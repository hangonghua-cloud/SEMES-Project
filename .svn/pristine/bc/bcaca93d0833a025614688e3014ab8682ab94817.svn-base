<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.adddetail.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.adddetail.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form" sit-layout="Vertical" sit-type="Fluid" sit-mode="edit" sit-columns="1">
        <!-- TODO: Put here the properties of the entity managed by the service -->
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.WorkOrder" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.adddetail.Tips_3'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialCode" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.adddetail.Tips_4'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialName" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.adddetail.Tips_5'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Spec" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.adddetail.Tips_6'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.SmallClassName" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.adddetail.Tips_7'|translate}}</sit-property>
        <sit-property sit-widget="sit-alp-text-picker" sit-value="vm.currentItem.UserCode"
                      sit-validation="{required: true}" ng-click="vm.selectClick()" sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.adddetail.Tips_8'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.UserNames" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.adddetail.Tips_8'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.PrintNum"
                      sit-validation="{required: true,min: 1}" sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.adddetail.Tips_9'|translate}}</sit-property>
    </sit-property-grid>
</div>