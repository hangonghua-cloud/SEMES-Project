
<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.PlanApp.ProductRule.add.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.PlanApp.ProductRule.add.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form"
                       sit-layout="Horizontal"
                       sit-type="Fixed"
                       sit-mode="edit"
                       sit-columns="1">
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.RuleCode" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.PlanApp.ProductRule.add.Tips_3'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.RuleName" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.PlanApp.ProductRule.add.Tips_4'|translate}}</sit-property>
        <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.RuleContent" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.PlanApp.ProductRule.add.Tips_5'|translate}}</sit-property>
        <sit-property sit-widget="sit-checkbox"
                      sit-value="vm.IsEnabled"
                      sit-validation="{required: false}"
                      ng-show="true">
            {{'Siemens.SimaticIT.PlanApp.ProductRule.add.Tips_6'|translate}}
        </sit-property>
    </sit-property-grid>
</div>
