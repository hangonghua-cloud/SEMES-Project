<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <configSections>
    <!--log4Net 配置-->
    <section name="log4net" type="log4net.Config.Log4NetConfigurationSectionHandler,log4net"/>
  </configSections>
  <log4net>
    <appender name="RollingFile" type="log4net.Appender.RollingFileAppender,log4net">
      <param name="File" value="log/preproc.log"/>
      <param name="RollingStyle" value="Date"/>
      <param name="DatePattern" value="yyyy.MM.dd"/>
      <param name="StaticLogFileName" value="true"/>
      <param name="AppendToFile" value="false"/>
      <param name="MaximumFileSize" value="10MB"/>
      <param name="MaxSizeRollBackups" value="100"/>
      <param name="CountDirection" value="0"/>
      <layout type="log4net.Layout.PatternLayout,log4net">
        <param name="ConversionPattern" value="%d [%t] %-5p %c - %m%n"/>
        <param name="Header" value=""/>
        <param name="Footer" value=""/>
      </layout>
      <filter type="log4net.Filter.LevelRangeFilter">
        <param name="LevelMin" value="INFO"/>
        <param name="LevelMax" value="FATAL"/>
      </filter>
    </appender>

    <appender name="SmtpAppender" type="log4net.Appender.SmtpAppender">
      <layout type="log4net.Layout.PatternLayout" value="%d [%t] %-5p %c - %m%n"/>
      <filter type="log4net.Filter.LevelRangeFilter">
        <param name="LevelMin" value="WARN"/>
        <param name="LevelMax" value="FATAL"/>
      </filter>
      <lossy value="false"/>
      <bufferSize value="1"/>
      <subject value="Preproc Log"/>
      <to value="lijunjishu@kaitone.cn"/>
      <from value="lijunjishu@kaitone.cn"/>
      <smtpHost value="mail.kaitone.cn"/>
      <Authentication value="Basic"/>
      <Username value=""/>
      <Password value=""/>
    </appender>

    <appender name="ConsoleAppender" type="log4net.Appender.ConsoleAppender">
      <layout type="log4net.Layout.PatternLayout" value="%d [%t] %-5p %c - %m%n"/>
      <filter type="log4net.Filter.LevelRangeFilter">
        <param name="LevelMin" value="INFO"/>
        <param name="LevelMax" value="FATAL"/>
      </filter>
    </appender>

    <appender name="ColoredConsoleAppender" type="log4net.Appender.ColoredConsoleAppender">
      <layout type="log4net.Layout.PatternLayout" value="%d %m%n"/>
      <filter type="log4net.Filter.LevelRangeFilter">
        <param name="LevelMin" value="DEBUG"/>
        <param name="LevelMax" value="FATAL"/>
      </filter>
      <mapping>
        <level value="FATAL"/>
        <backColor value="Blue"/>
        <foreColor value="White"/>
      </mapping>
      <mapping>
        <level value="ERROR"/>
        <backColor value="Green"/>
        <foreColor value="White"/>
      </mapping>
      <mapping>
        <level value="WARN"/>
        <backColor value="Red"/>
        <foreColor value="White"/>
      </mapping>
      <!--<mapping>
        <level value="INFO" />
        <backColor value="Yellow" />
        <foreColor value="White" />
      </mapping>-->
      <mapping>
        <level value="DEBUG"/>
        <foreColor value="HighIntensity"/>
      </mapping>
    </appender>

    <appender name="OutputDebugStringAppender" type="log4net.Appender.OutputDebugStringAppender">
      <layout type="log4net.Layout.PatternLayout" value="%d [%t] %-5p %c - %m%n"/>
      <filter type="log4net.Filter.LevelRangeFilter">
        <param name="LevelMin" value="DEBUG"/>
        <param name="LevelMax" value="FATAL"/>
      </filter>
    </appender>

    <appender name="TelnetAppender" type="log4net.Appender.TelnetAppender">
      <param name="Port" value="10023"/>
      <layout type="log4net.Layout.PatternLayout" value="%d [%t] %-5p %c - %m%n"/>
      <filter type="log4net.Filter.LevelRangeFilter">
        <param name="LevelMin" value="DEBUG"/>
        <param name="LevelMax" value="FATAL"/>
      </filter>
    </appender>

    <!-- Define some output appenders -->
    <!-- Use the remoting appender -->
    <appender name="RemotingAppender" type="log4net.Appender.RemotingAppender">
      <!-- The remoting URL to the remoting server object -->
      <sink value="tcp://localhost:8085/LoggingSink"/>
      <!-- Send all events, do not discard events when the buffer is full -->
      <lossy value="false"/>
      <!-- The number of events to buffer before sending -->
      <bufferSize value="2"/>
      <!-- Do not store event data that is slow to generate -->
      <onlyFixPartialEventData value="true"/>
      <!-- Specify an evaluator to send the events immediatly under
			     certain conditions, e.g. when an error event ocurrs -->
      <filter type="log4net.Filter.LevelRangeFilter">
        <param name="LevelMin" value="DEBUG"/>
        <param name="LevelMax" value="FATAL"/>
      </filter>
      <layout type="log4net.Layout.PatternLayout" value="%d [%t] %-5p %c - %m%n"/>
    </appender>

    <!-- Setup the root category, add the appenders and set the default level -->
    <root Additivity="false">
      <level value="ALL"/>
      <!--<appender-ref ref="ConsoleAppender" />-->
      <appender-ref ref="ColoredConsoleAppender"/>
      <appender-ref ref="RollingFile"/>
      <!--<appender-ref ref="OutputDebugStringAppender" />-->
      <appender-ref ref="TelnetAppender"/>
      <!--<appender-ref ref="SmtpAppender" />-->
    </root>
  </log4net>
  <startup>
    
  <supportedRuntime version="v4.0" sku=".NETFramework,Version=v4.7.2"/></startup>
</configuration>
