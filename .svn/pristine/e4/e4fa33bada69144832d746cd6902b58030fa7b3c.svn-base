<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentRepairRecord.EP_EquipmentRepairRecordedit.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentRepairRecord.EP_EquipmentRepairRecordedit.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2" style="margin-left: 4px;">
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProcessId" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentRepairRecord.EP_EquipmentRepairRecordedit.Tips_3'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.EquipmentId" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentRepairRecord.EP_EquipmentRepairRecordedit.Tips_4'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.EquipmentName" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentRepairRecord.EP_EquipmentRepairRecordedit.Tips_5'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.RepairingType" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentRepairRecord.EP_EquipmentRepairRecordedit.Tips_6'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.EquipmentIdentifyCode" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentRepairRecord.EP_EquipmentRepairRecordedit.Tips_7'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.EquipmentType" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentRepairRecord.EP_EquipmentRepairRecordedit.Tips_8'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.RepairingPerson" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentRepairRecord.EP_EquipmentRepairRecordedit.Tips_9'|translate}}</sit-property>
            <sit-property sit-widget="sit-datepicker" sit-value="vm.currentItem.FinishTime" sit-validation="{required: true}"
                          sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentRepairRecord.EP_EquipmentRepairRecordedit.Tips_10'|translate}}</sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.TimeLength" sit-validation="{required: true, min: 0}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentRepairRecord.EP_EquipmentRepairRecordedit.Tips_11'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.RepairingContent" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentRepairRecord.EP_EquipmentRepairRecordedit.Tips_12'|translate}}</sit-property>
            <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentRepairRecord.EP_EquipmentRepairRecordedit.Tips_13'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ModifyBy" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentRepairRecord.EP_EquipmentRepairRecordedit.Tips_14'|translate}}</sit-property>
            <sit-property sit-widget="sit-datepicker" sit-value="vm.currentItem.ModifyTime" sit-validation="{required: true}"
                          sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentRepairRecord.EP_EquipmentRepairRecordedit.Tips_15'|translate}}</sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>
