<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2">
        <sit-property sit-widget="sit-select" sit-value="vm.Factory.value" sit-validation="{required: false}"
                      sit-options="vm.Factory.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                      sit-read-only="true">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_3'|translate}}</sit-property>
        <!-- <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductOrder" sit-validation="{required: true}"
                  sit-read-only="true">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_4'|translate}}</sit-property> -->
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.CustomerPO" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_5'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialCode" sit-validation="{required: false}"
                      sit-read-only="true">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_6'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ContainerNO" sit-validation="{required: false}"
                      sit-read-only="vm.isReadOnly3">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_7'|translate}}</sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.ProcessRoute.value" sit-validation="{required: false}"
                      sit-options="vm.ProcessRoute.options" sit-to-display="'ProcessName'" sit-to-keep="'ProcessCode'"
                      sit-read-only="vm.isReadOnly3">
            {{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_8'|translate}}
        </sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.OrderPieces"
                      sit-validation="{required: false,min:0}" sit-read-only="vm.isReadOnly3">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_9'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.OrderBox"
                      sit-validation="{required: false,min:0}" sit-read-only="vm.isReadOnly3">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_10'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.OrderPallet"
                      sit-validation="{required: false,min:0}" sit-read-only="vm.isReadOnly3">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_11'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.OrderStartPallet"
                      sit-validation="{required: false,min:0}" sit-read-only="vm.isReadOnly3">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_12'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.OrderWholePallet"
                      sit-validation="{required: false,min:0}" sit-read-only="vm.isReadOnly3">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_13'|translate}}</sit-property>

        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.DeliveryPieces"
                      sit-validation="{required: false,min:0}" sit-read-only="vm.isReadOnly2">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_14'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.DeliveryBox"
                      sit-validation="{required: false,min:0}" sit-read-only="vm.isReadOnly2">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_15'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.DeliveryPallet"
                      sit-validation="{required: false,min:0}" sit-read-only="vm.isReadOnly2">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_16'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.DeliveryStartPallet"
                      sit-validation="{required: false,min:0}" sit-read-only="vm.isReadOnly2">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_17'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.DeliveryWholePallet"
                      sit-validation="{required: false,min:0}" sit-read-only="vm.isReadOnly2">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_18'|translate}}</sit-property>

        <sit-property sit-widget="sit-datepicker" sit-value="vm.currentItem.GiveTime" sit-validation="{required: false}"
                      sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="false">
            {{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_19'|translate}}
        </sit-property>
        <!-- <sit-property sit-widget="sit-select" sit-value="vm.typeWO.value" sit-validation="{required: true}"
                      sit-options="vm.typeWO.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                      style="max-width:100px;">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_20'|translate}}</sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.POStatus.value" sit-validation="{required: true}"
                      sit-options="vm.POStatus.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                      style="max-width:100px;">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_21'|translate}}</sit-property> -->
        <sit-property sit-widget="sit-select" sit-value="vm.AvoidProduce.value" sit-validation="{required: true}"
                      sit-options="vm.AvoidProduce.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                      style="max-width:100px;" sit-read-only="vm.isReadOnly4">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_22'|translate}}</sit-property>

        <sit-property sit-widget="sit-select" sit-value="vm.typePort.value" sit-validation="{required: false}"
                      sit-options="vm.typePort.options" sit-to-display="'ItemName'" sit-to-keep="'ItemCode'" sit-read-only="false">
            {{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_23'|translate}}
        </sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.PlanApp.Plan.editOrder.Tips_24'|translate}}</sit-property>
    </sit-property-grid>
</div>