<style>
    .canvas .property-area-container div.command-bar-side-panel {
        padding-bottom: 40px;
    }

    .canvas .property-area-container > div.content .side-panel-property-area-body {
        overflow: visible;
        flex: none;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">
        {{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManagemerge.Tips_1'|translate}}
    </button>
    <button ng-click="vm.save()" class="btn side-panel-button">
        {{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManagemerge.Tips_2'|translate}}
    </button>
</div>
<div class="side-panel-property-area-body" style="height: calc(8% - 0px) !important;">
    <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="5">

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Qty" sit-validation="{required: false}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManagemerge.Tips_3'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-select" sit-value="vm.typeLocation.value" sit-validation="{required: true}"
                      sit-options="vm.typeLocation.options" sit-to-display="'LocationCode'" sit-to-keep="'LocationCode'"
                      sit-read-only="false">
            {{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManagemerge.Tips_4'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-select" sit-value="vm.typeBatch.value" sit-validation="{required: true}"
                      sit-options="vm.typeBatch.options" sit-to-display="'BatchNo'" sit-to-keep="'BatchNo'" sit-read-only="false">
            {{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManagemerge.Tips_5'|translate}}
        </sit-property>

    </sit-property-grid>
</div>
<div id="itemlist1"
     style="width:calc(100% - 2px); height: 80%;margin-top: 3px; padding:5px 16px 0 0px;clear: both; display: block;">
    <div ui-grid="vm.gridOptionsItem1" ui-grid-selection ui-grid-resize-columns ui-grid-auto-resize
         class="uigrid  gridItem"></div>
</div>