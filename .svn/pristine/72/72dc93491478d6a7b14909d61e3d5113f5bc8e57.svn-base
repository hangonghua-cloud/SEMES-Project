<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.TraitProcess.TraitProcessOperationadd.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.MaterialApp.TraitProcess.TraitProcessOperationadd.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form"
                       sit-layout="Horizontal"
                       sit-type="Fixed"
                       sit-mode="edit"
                       sit-columns="1">
        <sit-property sit-widget="sit-select" sit-value="vm.TypeFactory.value" sit-validation="{required: true}" sit-options="vm.TypeFactory.options"
                      sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.TraitProcess.TraitProcessOperationadd.Tips_3'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProcessCode" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.TraitProcess.TraitProcessOperationadd.Tips_4'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProcessName" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.TraitProcess.TraitProcessOperationadd.Tips_5'|translate}}</sit-property>
        <sit-property sit-widget="sit-alp-text-picker" sit-value="vm.currentItem.MaterialClass"
                      sit-validation="{required: true}" ng-click="vm.materialClick()" sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.TraitProcess.TraitProcessOperationadd.Tips_6'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.SmallClass"
                      sit-validation="{required: true}" sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.TraitProcess.TraitProcessOperationadd.Tips_7'|translate}}</sit-property>
        <sit-property sit-widget="sit-radio" sit-value="vm.IsEnabled.value" sit-options="vm.IsEnabled.options"
                      sit-change="" sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.TraitProcess.TraitProcessOperationadd.Tips_8'|translate}}</sit-property>
        <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.TraitProcess.TraitProcessOperationadd.Tips_9'|translate}}</sit-property>
    </sit-property-grid>
</div>
