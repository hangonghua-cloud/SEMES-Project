<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.PlanApp.Plan.Transfer.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.PlanApp.Plan.Transfer.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="1" style="margin-left: 4px;">
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialName" sit-validation="{required: false}"
                          sit-read-only="true">{{'Siemens.SimaticIT.PlanApp.Plan.Transfer.Tips_3'|translate}}</sit-property>
        </sit-property-grid>
        <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value" sit-validation="{required: true}"
                      sit-options="vm.typeFactory.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                      sit-change="vm.typeFactoryChange">
            {{'Siemens.SimaticIT.PlanApp.Plan.Transfer.Tips_4'|translate}}
        </sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.TypeOrder.value" sit-validation="{required: true}"
                      sit-options="vm.TypeOrder.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'">
            {{'Siemens.SimaticIT.PlanApp.Plan.Transfer.Tips_5'|translate}}
        </sit-property>
        <:sit-label sit-value="vm.currentItem.Labelvalue">
        </:sit-label>
        <sit-property sit-widget="sit-select" sit-value="vm.typeOperation.value" sit-validation="{required: false}" sit-options="vm.typeOperation.options"
                      sit-to-display="'OperationName'" sit-to-keep="'OperationCode'" sit-read-only="false">{{'Siemens.SimaticIT.PlanApp.Plan.Transfer.Tips_6'|translate}}</sit-property>
                   
        <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.PlanApp.Plan.Transfer.Tips_7'|translate}}</sit-property>
    </sit-property-grid>
</div>
