<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()"
            class="btn side-panel-button">
        {{'Siemens.SimaticIT.MaterialApp.MMRawMaterialDispatch.MMRawMaterialDispatchedit.Tips_1'|translate}}
    </button>
    <button ng-click="vm.save()" class="btn side-panel-button"
            ng-show="vm.validInputs">
        {{'Siemens.SimaticIT.MaterialApp.MMRawMaterialDispatch.MMRawMaterialDispatchedit.Tips_2'|translate}}
    </button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="1">

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.InvoiceNO" sit-validation="{required: false}"
                      sit-read-only="false">发票号</sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.LoadingBill"
                      sit-validation="{required: false}" sit-read-only="false">提单号</sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Volume" sit-validation="{required: false}"
                      sit-read-only="false">体积</sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ContainerID"
                      sit-validation="{required: false}" sit-read-only="false">集装箱ID</sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.CarNumber" sit-validation="{required: false}"
                      sit-read-only="false">车牌号</sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ForkliftWorker"
                      sit-validation="{required: false}" sit-read-only="false">叉车工</sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.WoodWorker" sit-validation="{required: false}"
                      sit-read-only="false">木工</sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.SealingNo" sit-validation="{required: false}"
                      sit-read-only="false">封箱号</sit-property>

    </sit-property-grid>
</div>