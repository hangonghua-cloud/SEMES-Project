<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="3" style="margin-left: 4px;">
            <sit-property sit-widget="sit-text" sit-value="vm.currentOrder.FactoryName" sit-validation="{required: false}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_3'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentOrder.PrinterOrder" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_4'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentOrder.PlanOrder" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_5'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentOrder.WorkOrder" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_6'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentOrder.MaterialCode" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_7'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentOrder.Cylinder" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_8'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentOrder.DesignColour" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_9'|translate}}</sit-property>

            <sit-property sit-widget="sit-numeric" sit-value="vm.currentOrder.MeterNum" sit-validation="{required: true, min: 0}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_10'|translate}}</sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentOrder.ReelNum" sit-validation="{required: true, min: 0}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_11'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentOrder.ProcessRoutName" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_12'|translate}}</sit-property>
            <!-- <sit-property sit-widget="sit-select" sit-value="vm.ProcessRoute.value" sit-validation="{required: false}" sit-options="vm.ProcessRoute.options"
                          sit-to-display="'ProcessName'" sit-to-keep="'ProcessCode'" sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_12'|translate}}</sit-property> -->
            <sit-property sit-widget="sit-select" sit-value="vm.typeProcessOperation.value" sit-validation="{required: true}" sit-options="vm.typeProcessOperation.options"
                          sit-to-display="'OperationName'" sit-to-keep="'OperationCode'" sit-read-only="false" sit-change="vm.processChange">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_13'|translate}}</sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.typeUserGroup.value" sit-validation="{required: true}" sit-options="vm.typeUserGroup.options"
                          sit-to-display="'PTeamName'" sit-to-keep="'PTeamCode'">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_14'|translate}}</sit-property>

            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.MeterNum" sit-validation="{required: true, min: 0}"
                          sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_15'|translate}}</sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.ReelNum" sit-validation="{required: false, min: 0}"
                          sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_16'|translate}}</sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.WeightNum" sit-validation="{required: false, min: 0}"
                          sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_17'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.WhiteBatchNo" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_18'|translate}}</sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.IsMergeBatch.value" sit-validation="{required: true}"
                          sit-options="vm.IsMergeBatch.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                          sit-change="vm.IsMergeBatchChange">
                {{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_19'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-datepicker" sit-value="vm.BatchDate" sit-validation="{required: false}"
                          sit-format="'yyyy-MM-dd'" sit-read-only="vm.isShowBatchDate" sit-change="vm.BatchDateChange">
                {{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_20'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.MergeBatch.value" sit-validation="{required: false}"
                          sit-options="vm.MergeBatch.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                          sit-read-only="!vm.isShowBatchDate"
                          sit-change="vm.MergeBatchChange">
                {{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_21'|translate}}
            </sit-property>

            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.BatchNo" sit-validation="{required: false}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_22'|translate}}</sit-property>
            <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                          sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.editBG.Tips_23'|translate}}</sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>
