<style>
    .colorLabel {
        border: 2px solid #379082;
        border-radius: 20px;
        width: 30px;
        height: 30px;
       margin-left: 10px;
    }
</style>
<div id="itemlist" class="content-area content-area-relative" style="height: calc(90% - 30px) !important">

    <sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">
        <sit-command sit-icon="fa fa-trash" sit-type="main" sit-name="com.siemens.customcommand.add" :sit-tooltip="{{'Siemens.SimaticIT.SystemApp.Sys_DataSegregateLabel.Sys_DataSegregateLabellist.Tips_1'|translate}}" ng-click="vm.deleteButtonHandler"
            :sit-label="{{'Siemens.SimaticIT.SystemApp.Sys_DataSegregateLabel.Sys_DataSegregateLabellist.Tips_1'|translate}}" ng-show="vm.isButtonVisible"></sit-command>
    </sit-command-bar>

    <div id="listClass" style="width:100%; height: 100%; padding:16px;">
        <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection ui-grid-pagination
            class="uigrid"></div>
    </div>
</div>