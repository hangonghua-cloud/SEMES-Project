<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairaddrepair.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairaddrepair.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form" sit-layout="Vertical" sit-type="Fluid" sit-mode="edit" sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="1"
                           style="margin-left: 4px;">
            <sit-property sit-widget="sit-date-time-picker" sit-format="'yyyy-MM-dd hh:mm:ss'"
                          sit-validation="{required: true}" sit-value="vm.currentItem.curFinishTime" sit-read-only="false">
                {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairaddrepair.Tips_3'|translate}}
            </sit-property>
            <!--<sit-property sit-widget="sit-text" sit-value="vm.currentItem.FinishTime2"></sit-property>-->
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.TimeLength"
                          sit-validation="{required: true}" sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairaddrepair.Tips_4'|translate}}</sit-property>
            <sit-property sit-widget="sit-alp-text-picker" sit-read-only="true" sit-validation="{required: true}"
                          sit-value="vm.currentItem.RepairingPersonName" ng-click="vm.SelectPeopleModal()">
                {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairaddrepair.Tips_5'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.RepairingContent"
                          sit-validation="{required: false}" sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMalfunctionRepair.EP_EquipmentMalfunctionRepairaddrepair.Tips_6'|translate}}</sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>