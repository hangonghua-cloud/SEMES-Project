        /// <summary>
        /// 功能描述: 保存表单（新增、修改）
        /// 创　　建: liyongguo
        /// 创建日期: 2021-08-20 15:42:02
        /// 任务编号: 原材料库存详表
        /// </summary>
        /// <param name="jo">json参数, 包含keyValue 主键值, entity 实体对象 </param>
        /// <returns></returns>
        [HttpPost]
        [Route("SaveMM_RawMaterialStock")]
        public HttpResponseMessage SaveMM_RawMaterialStock(JObject jo)
        {
            var userCode = CurrentAccount.UserCode;
            var userName = CurrentAccount.UserName;
            var result = new ResponseResult<object>();
            result.resultData = null;

            if (jo == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_5");//参数不能为空！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            //判断主键内容是否为空, 为空新增, 有值修改
            if (jo.SelectToken("KeyValue") == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_6");//缺少KeyValue参数！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            if (jo.SelectToken("Entity") == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_7");//缺少Entity参数！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            string keyValue = getValue(jo, "KeyValue");
            string queryJson = getValue(jo, "Entity");
            try
            {

                MM_RawMaterialStockEntity entity = JsonConvert.DeserializeObject<MM_RawMaterialStockEntity>(getValue(jo, "Entity"));




                string msg = "";
                int isok = _rawMaterialStockService.SaveEntity(keyValue, entity, out msg);
                result.success = isok > 0 ? true : false;
                result.returnMsg = isok > 0 ? Language.GetText("Common.Success") : msg;//操作成功
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
            catch (Exception ex)
            {
                result.success = false;
                result.returnMsg = Language.GetText("Common.ErrorWithOther2") + ex.Message;//操作失败：
                result.statusCode = ((int)HttpStatusCode.InternalServerError).ToString();
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
        }

        /// <summary>
        /// 功能描述: 导入 保存表单（新增、修改）
        /// 创　　建: liyongguo
        /// 创建日期: 2021-08-20 15:42:02
        /// 任务编号: 原材料库存详表
        /// </summary>
        /// <param name="jo">json参数, entity 实体对象数组</param>
        /// <returns></returns>
        [HttpPost]
        [Route("SaveBatchMM_RawMaterialStock")]
        public HttpResponseMessage SaveBatchMM_RawMaterialStock(JObject jo)
        {
            var userCode = CurrentAccount.UserCode;
            var userName = CurrentAccount.UserName;
            var result = new ResponseResult<object>();
            result.resultData = null;

            if (jo == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_5");//参数不能为空！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            //创建人编码 为空判断
            if (jo.SelectToken("CreatedByCode") == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_10");//缺少CreatedByCode参数！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            //创建人姓名 为空判断
            if (jo.SelectToken("CreatedByName") == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_11");//缺少CreatedByName参数！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            if (jo.SelectToken("Entity") == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_7");//缺少Entity参数！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            try
            {
                List<dynamic> upload_entity_list = JsonConvert.DeserializeObject<List<dynamic>>(getValue(jo, "Entity"));

                string keyValue = getValue(jo, "KeyValue");
                string CreatedByName = getValue(jo, "CreatedByName");
                string CreatedByCode = getValue(jo, "CreatedByCode");


                string msg = "";
                int isok = 1;
                Dictionary<string, object> dic = new Dictionary<string, object>();
                //取出旧所有数据
                var old_entity_list = _rawMaterialStockService.GetList(dic, out msg);
                //插入数组
                List<MM_RawMaterialStockEntity> Insert_entity_list = new List<MM_RawMaterialStockEntity>();
                //更新数组
                List<MM_RawMaterialStockEntity> Update_entity_list = new List<MM_RawMaterialStockEntity>();
                foreach (var item in upload_entity_list)
                {
                    try
                    {
                        MM_RawMaterialStockEntity entity = new MM_RawMaterialStockEntity();
                        //物料编码
                        entity.MaterialCode = item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_12")] == null ? "" : item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_12")];//物料编码
                        //物料名称
                        entity.MaterialName = item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_13")] == null ? "" : item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_13")];//物料名称
                        //批次号
                        entity.BatchNo = item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_14")] == null ? "" : item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_14")];//批次号
                        //数量
                        entity.Qty = item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_15")] == null ? "" : item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_15")];//数量
                        //单位
                        entity.Unit = item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_16")] == null ? "" : item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_16")];//单位
                        //供应商
                        entity.SupplierCode = item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_17")] == null ? "" : item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_17")];//供应商
                        //仓库
                        entity.WhsCode = item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_18")] == null ? "" : item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_18")];//仓库
                        //库位
                        entity.LocationCode = item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_19")] == null ? "" : item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_19")];//库位
                        //创建人
                        entity.Creator = item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_20")] == null ? "" : item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_20")];//创建人
                        //创建时间
                        entity.CreateTime = item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_21")] == null ? "" : item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_21")];//创建时间
                        //修改人
                        entity.ModifyBy = item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_22")] == null ? "" : item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_22")];//修改人
                        //修改时间
                        entity.ModifyTime = item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_23")] == null ? "" : item[Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_23")];//修改时间
                        //状态(启用/停用)
                        //entity.Status = item["状态"] == null ? "启用" : item["状态"];
                        //创建日期// DateTime.Now;
                        //entity.CreatedDateTime = DateTimeOffset.Now;
                        ////是否删除
                        //entity.IsDeleted = false;
                        //entity.CreatedByCode = CreatedByCode;
                        //entity.CreatedByName = CreatedByName;

                        //取出相似编码， 提示： 此处换上表中唯一编码（不是主键）
                        MM_RawMaterialStockEntity old_entity = old_entity_list.FirstOrDefault(x => x.Id == entity.Id);
                        //判断旧列表中是否存在此编码
                        if (old_entity == null)
                        {
                            entity.Create();
                            //保存数组
                            Insert_entity_list.Add(entity);
                        }
                        else
                        {
                            entity.Id = old_entity.Id;
                            Update_entity_list.Add(entity);
                        }
                    }
                    catch (Exception ex)
                    {

                    }
                }

                if (Insert_entity_list.Count > 0)
                {
                    //批量新增
                    isok = _rawMaterialStockService.SaveEntity_List(false, CreatedByName, Insert_entity_list, out msg);
                }
                if (Update_entity_list.Count > 0)
                {
                    //批量修改
                    isok = _rawMaterialStockService.SaveEntity_List(true, CreatedByName, Update_entity_list, out msg);
                }

                result.success = isok > 0 ? true : false;
                result.returnMsg = isok > 0 ? Language.GetText("Common.Success") : msg;//操作成功
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
            catch (Exception ex)
            {
                result.success = false;
                result.returnMsg = Language.GetText("Common.ErrorWithOther2") + ex.Message;//操作失败：
                result.statusCode = ((int)HttpStatusCode.InternalServerError).ToString();
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
        }

        /// <summary>
        /// 功能描述: 删除, 通过主键删除
        /// 创　　建: liyongguo
        /// 创建日期: 2021-08-20 15:42:02
        /// 任务编号: 原材料库存详表
        /// </summary>
        /// <param name="jo">json参数</param>
        [HttpPost]
        [Route("DeleteMM_RawMaterialStock")]
        public HttpResponseMessage DeleteMM_RawMaterialStock(JObject jo)
        {
            var result = new ResponseResult<object>();
            result.resultData = null;

            if (jo == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_5");//参数不能为空！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            try
            {
                var userCode = CurrentAccount.UserCode;
                var userName = CurrentAccount.UserName;

                if (jo.SelectToken("Entity") == null)
                {
                    result.success = false;
                    result.returnMsg = Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_7");//缺少Entity参数！
                    return Request.CreateResponse(HttpStatusCode.OK, result);
                }
                //业务服务层

                MM_RawMaterialStockEntity entity = JsonConvert.DeserializeObject<MM_RawMaterialStockEntity>(getValue(jo, "Entity"));
                string Id = entity.Id;
                MM_RawMaterialStockEntity model = _rawMaterialStockService.GetEntity(Id);
                if (model == null)
                {
                    result.success = false;
                    result.returnMsg = Id + " 对象不存在";//对象不存在
                    return Request.CreateResponse(HttpStatusCode.OK, result);
                }

                //删除
                string msg = "";
                int isok = _rawMaterialStockService.DeleteEntity(Id, out msg, userCode);
                result.success = isok > 0 ? true : false;
                if (isok > 0)
                    result.returnMsg = Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_26");//删除操作成功
                else
                    result.returnMsg = "删除操作失败: " + msg;//删除操作失败:
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
            catch (Exception ex)
            {
                result.success = false;
                result.returnMsg = Language.GetText("Common.ErrorWithOther2") + ex.Message;//操作失败：
                result.statusCode = ((int)HttpStatusCode.InternalServerError).ToString();
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
        }

        /// <summary>
        /// 功能描述: 假删除, 通过主键删除, 删除标记设置为0
        /// 创　　建: liyongguo
        /// 创建日期: 2021-08-20 15:42:02
        /// 任务编号: 原材料库存详表
        /// </summary>
        /// <param name="jo">json参数</param>
        [HttpPost]
        [Route("RemoveMM_RawMaterialStock")]
        public HttpResponseMessage RemoveMM_RawMaterialStock(JObject jo)
        {
            var result = new ResponseResult<object>();
            result.resultData = null;

            if (jo == null)
            {
                result.success = false;
                result.returnMsg = Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_5");//参数不能为空！
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }

            try
            {
                var userCode = CurrentAccount.UserCode;
                var userName = CurrentAccount.UserName;

                if (jo.SelectToken("Entity") == null)
                {
                    result.success = false;
                    result.returnMsg = Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_7");//缺少Entity参数！
                    return Request.CreateResponse(HttpStatusCode.OK, result);
                }
                //业务服务层

                MM_RawMaterialStockEntity entity = JsonConvert.DeserializeObject<MM_RawMaterialStockEntity>(getValue(jo, "Entity"));


                //删除
                int isok = _rawMaterialStockService.RemoveForm(t => t.Id == entity.Id);
                result.success = isok > 0 ? true : false;
                if (isok > 0)
                    result.returnMsg = Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_26");//删除操作成功
                else
                    result.returnMsg = Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_28");//删除操作失败
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
            catch (Exception ex)
            {
                result.success = false;
                result.returnMsg = Language.GetText("Common.ErrorWithOther2") + ex.Message;//操作失败：
                result.statusCode = ((int)HttpStatusCode.InternalServerError).ToString();
                return Request.CreateResponse(HttpStatusCode.OK, result);
            }
        }

