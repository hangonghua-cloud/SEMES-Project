        #region 合批
        [HttpPost]
        [Route("RawMaterialStockMerge")]
        public HttpResponseMessage RawMaterialStockMerge(JObject jo)
        {
            try
            {
                var qty = getValue(jo, "Qty");
                var locationCode = getValue(jo, "LocationCode");
                var batchNo = getValue(jo, "BatchNo");
                var data = JsonConvert.DeserializeObject<List<MM_RawMaterialStockEntity>>(getValue(jo, "data"));

                //合批业务
                string associateNo = DateTime.Now.ToString("yyyyMMddHHmmss");

                #region 出库
                List<MM_RawMaterialOutEntity> lstOutEntity = new List<MM_RawMaterialOutEntity>();
                foreach (var item in data)
                {
                    var outEntity = Tools.Mapper<MM_RawMaterialOutEntity>(item);
                    outEntity.Id = Guid.NewGuid().ToString();
                    outEntity.OutType = "12";
                    outEntity.Creator = CurrentAccount.UserCode;
                    outEntity.CreateTime = DateTime.Now;
                    outEntity.ModifyBy = CurrentAccount.UserCode;
                    outEntity.ModifyTime = DateTime.Now;
                    outEntity.AssociateNo = associateNo;
                    lstOutEntity.Add(outEntity);
                }
                #endregion

                #region 入库
                var inEntity = Tools.Mapper<MM_RawMaterialInEntity>(data.First());
                inEntity.Id = Guid.NewGuid().ToString();
                inEntity.InType = "12";
                inEntity.LocationCode = locationCode;
                inEntity.BatchNo = batchNo ?? "";
                inEntity.Qty = qty.ToDecimal();
                inEntity.Creator = CurrentAccount.UserCode;
                inEntity.CreateTime = DateTime.Now;
                inEntity.ModifyBy = CurrentAccount.UserCode;
                inEntity.ModifyTime = DateTime.Now;
                inEntity.AssociateNo = associateNo;
                inEntity.SupplierCode = inEntity.SupplierCode ?? "";
                #endregion

                #region 库存
                var stockEntity = Tools.Clone(data.Find(t => t.BatchNo == batchNo));
                stockEntity.Id = Guid.NewGuid().ToString();
                stockEntity.LocationCode = locationCode;
                stockEntity.BatchNo = batchNo ?? "";
                stockEntity.SupplierCode = stockEntity.SupplierCode ?? "";
                stockEntity.Qty = qty.ToDecimal();
                stockEntity.Creator = CurrentAccount.UserCode;
                stockEntity.CreateTime = DateTime.Now;
                stockEntity.ModifyBy = CurrentAccount.UserCode;
                stockEntity.ModifyTime = DateTime.Now;
                stockEntity.IsFrozen = "0";
                #endregion

                #region 同步SAP
                var factoryCode = inEntity.FactoryCode;

                var SAPSyncSwitch = _keyParameterItemService.Get_ExpressionEntity(t => t.EnCode == "Switch" && t.ItemCode == "SAPSync"
                     && t.Remark1 == factoryCode);
                if (SAPSyncSwitch?.ItemValue == "1")
                {
                    //获取物料信息
                    var arrMaterialCode = lstOutEntity.Select(t => t.MaterialCode).Distinct().ToArray();
                    var materialList = _materialService.Get_ExpressionList(t => arrMaterialCode.Contains(t.MaterialCode)).ToList();

                    IF102 sapRequest = new IF102();
                    sapRequest.HEAD = new SapHeadDto();
                    sapRequest.HEAD.INIF_ID = SAPInterface.IF102.ToString();

                    sapRequest.RSQ_DATA = new IF102_RSQ_DATA();
                    IF102_HEAD IF102_HEAD = new IF102_HEAD();
                    IF102_HEAD.BLDAT = DateTime.Now.ToString("yyyyMMdd");
                    IF102_HEAD.BUDAT = DateTime.Now.ToString("yyyyMMdd");
                    sapRequest.RSQ_DATA.IS_HEAD = IF102_HEAD;

                    List<IF102_ITEM> IT_ITEM = new List<IF102_ITEM>();
                    foreach (var item in lstOutEntity)
                    {
                        IF102_ITEM IF102_ITEM = new IF102_ITEM();
                        IF102_ITEM.BWART = "311";
                        IF102_ITEM.MATNR = materialList.Find(t => t.MaterialCode == item.MaterialCode)?.SAPMaterialCode;
                        IF102_ITEM.WERKS = item.FactoryCode;
                        IF102_ITEM.LGORT = item.LocationCode;
                        IF102_ITEM.CHARG = item.BatchNo;
                        IF102_ITEM.ERFMG = item.Qty.ToString();
                        IF102_ITEM.ERFME = item.Unit;
                        IF102_ITEM.UMWRK = inEntity?.FactoryCode;
                        IF102_ITEM.UMLGO = inEntity?.LocationCode;
                        IF102_ITEM.UMCHA = inEntity?.BatchNo;
                        IT_ITEM.Add(IF102_ITEM);
                    }
                    sapRequest.RSQ_DATA.IT_ITEM = IT_ITEM;

                    var sapResult = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                    if (!sapResult.Flag)
                        return AjaxResult(false, sapResult.Msg);

                    foreach (var item in lstOutEntity)
                    {
                        item.IsPosted = sapResult.Flag ? "1" : ""; ;
                        item.PostedMsg = sapResult.Msg;
                        item.PostedTime = DateTime.Now;
                        item.PostedUser = CurrentAccount.UserCode + "-" + CurrentAccount.UserName;
                        item.SAP_MBLNR = getValue(JObject.Parse(sapResult.Data), "EV_MBLNR");
                    }

                    inEntity.IsPosted = sapResult.Flag ? "1" : ""; ;
                    inEntity.PostedMsg = sapResult.Msg;
                    inEntity.PostedTime = DateTime.Now;
                    inEntity.PostedUser = CurrentAccount.UserCode + "-" + CurrentAccount.UserName;
                    inEntity.SAP_MBLNR = getValue(JObject.Parse(sapResult.Data), "EV_MBLNR");
                }
                #endregion

                string msg = "";
                TransactionOptions transactionOption = new TransactionOptions();
                //设置事务隔离级别
                transactionOption.IsolationLevel = System.Transactions.IsolationLevel.ReadCommitted;
                // 设置事务超时时间为60秒
                transactionOption.Timeout = new TimeSpan(0, 0, 60);
                using (var ts = new TransactionScope(TransactionScopeOption.Required, transactionOption))
                //using (var ts = new TransactionScope())
                {
                    _rawMaterialOutBLL.SaveEntity_List(false, "", lstOutEntity, out msg); //新增出库记录
                    _rawMaterialInBLL.SaveEntity("", inEntity, out msg); //新增入库记录
                    _rawMaterialStockService.Delete(data);//删除原库存
                    _rawMaterialStockService.SaveEntity("", stockEntity, out msg); //新增合批库存

                    ts.Complete();
                }

                return AjaxResult(true, Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_41"));//操作成功
            }
            catch (Exception ex)
            {
                return AjaxResult(false, Language.GetText("Common.ErrorWithOther2") + ex.Message);//操作失败
            }
        }

        #endregion

        #region 原材料库存管理-退库
        /// <summary>
        /// 功能描述: 
        /// 创　　建: Dragon
        /// 创建日期: 2024-04-09
        /// </summary>
        /// <param name="jo">json参数</param>
        [HttpPost]
        [Route("RawMaterialStockTuiKu")]
        public HttpResponseMessage RawMaterialStockTuiKu(JObject jo)
        {
            try
            {
                //业务服务层
                var lstInEntity = JsonConvert.DeserializeObject<List<MM_RawMaterialInEntity>>(getValue(jo, "data"));
                if (lstInEntity == null || lstInEntity.Count == 0)
                    return AjaxResult(false, Language.GetText("MaterialManage.MM_RawMaterialStockController.Tips_43"));//没有要保存的行

                var docNum = DateTime.Now.ToString("yyyyMMddHHmmss");
                #region 1、新增入库记录
                var dicList = _dataItemDetailService.GetDataItemList("TuiKuMode").ToList();
                foreach (var item in lstInEntity)
                {
                    item.Id = item.GenGuid().ToString();
                    item.DocNum = docNum;
                    item.Creator = CurrentAccount.UserCode;
                    item.CreateTime = DateTime.Now;
                    item.MoveType = dicList.Find(t => t.Description == item.MoveType)?.ItemValue; //对应退库的移动类型
                    item.IsDeleted = false;
                }
                #endregion

                #region 2、新增库存
                List<MM_RawMaterialStockEntity> insertStockList = new List<MM_RawMaterialStockEntity>();
                List<MM_RawMaterialStockEntity> updateStockList = new List<MM_RawMaterialStockEntity>();
                foreach (var item in lstInEntity)
                {
                    var stockEntity = _rawMaterialStockService.Get_ExpressionEntity(t => t.FactoryCode == item.FactoryCode
                         && t.MaterialCode == item.MaterialCode && t.LocationCode == item.LocationCode && t.BatchNo == item.BatchNo);
                    if (stockEntity == null) //新增
                    {
                        stockEntity = Tools.Mapper<MM_RawMaterialStockEntity>(item);
                        stockEntity.Id = Guid.NewGuid().ToString();
                        stockEntity.IsFrozen = "0";
                        stockEntity.Creator = CurrentAccount.UserCode;
                        stockEntity.CreateTime = DateTime.Now;
                        stockEntity.ModifyBy = CurrentAccount.UserCode;
                        stockEntity.ModifyTime = DateTime.Now;
                        stockEntity.BatchNo = stockEntity.BatchNo ?? "";
                        stockEntity.SupplierCode = stockEntity.SupplierCode ?? "";
                        insertStockList.Add(stockEntity);
                    }
                    else
                    {
                        stockEntity.Qty += item.Qty;
                        stockEntity.ModifyBy = CurrentAccount.UserCode;
                        stockEntity.ModifyTime = DateTime.Now;
                        stockEntity.BatchNo = stockEntity.BatchNo ?? "";
                        stockEntity.SupplierCode = stockEntity.SupplierCode ?? "";
                        updateStockList.Add(stockEntity);
                    }
                }
                #endregion

                #region 同步SAP
                var factoryCode = lstInEntity.First().FactoryCode;

                var SAPSyncSwitch = _keyParameterItemService.Get_ExpressionEntity(t => t.EnCode == "Switch" && t.ItemCode == "SAPSync"
                    && t.Remark1 == factoryCode);
                if (SAPSyncSwitch?.ItemValue == "1")
                {
                    var arrMaterialCode = lstInEntity.Select(t => t.MaterialCode).Distinct().ToArray();
                    var materialList = _materialService.Get_ExpressionList(t => arrMaterialCode.Contains(t.MaterialCode)).ToList();

                    IF116 sapRequest = new IF116();
                    sapRequest.HEAD = new SapHeadDto();
                    sapRequest.HEAD.INIF_ID = SAPInterface.IF116.ToString();

                    sapRequest.RSQ_DATA = new IF116_RSQ_DATA();
                    IF116_HEAD IF116_HEAD = new IF116_HEAD();
                    IF116_HEAD.BLDAT = DateTime.Now.ToString("yyyyMMdd");
                    IF116_HEAD.BUDAT = DateTime.Now.ToString("yyyyMMdd");
                    sapRequest.RSQ_DATA.IS_HEAD = IF116_HEAD;

                    List<IF116_ITEM> IT_ITEM = new List<IF116_ITEM>();
                    foreach (var item in lstInEntity)
                    {
                        var matItem = materialList.Find(t => t.MaterialCode == item.MaterialCode);

                        IF116_ITEM IF116_ITEM = new IF116_ITEM();
                        IF116_ITEM.BWART = item.MoveType ?? "";
                        IF116_ITEM.MATNR = matItem?.SAPMaterialCode ?? "";
                        IF116_ITEM.WERKS = item.FactoryCode ?? "";
                        IF116_ITEM.LGORT = item.LocationCode ?? "";
                        IF116_ITEM.CHARG = item.BatchNo ?? "";
                        IF116_ITEM.ERFMG = item.Qty.ToString() ?? "";
                        IF116_ITEM.ERFME = item.Unit ?? "";
                        IF116_ITEM.KOSTL = item.WorkShopCode ?? "";
                        IF116_ITEM.AUFNR = "";
                        IF116_ITEM.SGTXT = "";
                        IT_ITEM.Add(IF116_ITEM);
                    }
                    sapRequest.RSQ_DATA.IT_ITEM = IT_ITEM;

                    var sapResult = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                    if (!sapResult.Flag)
                        return AjaxResult(false, sapResult.Msg);

                    foreach (var item in lstInEntity)
                    {
                        item.IsPosted = sapResult.Flag ? "1" : "";
                        item.PostedMsg = sapResult.Msg;
                        item.PostedTime = DateTime.Now;
                        item.PostedUser = CurrentAccount.UserCode + "-" + CurrentAccount.UserName;
                        item.SAP_MBLNR = getValue(JObject.Parse(sapResult.Data), "EV_MBLNR");
                        item.SAP_MJAHR = getValue(JObject.Parse(sapResult.Data), "EV_MJAHR");
                    }
                }
                #endregion

                string msg = "";
                TransactionOptions transactionOption = new TransactionOptions();
                //设置事务隔离级别
                transactionOption.IsolationLevel = System.Transactions.IsolationLevel.ReadCommitted;
                // 设置事务超时时间为60秒
                transactionOption.Timeout = new TimeSpan(0, 0, 60);
                using (var ts = new TransactionScope(TransactionScopeOption.Required, transactionOption))
                //using (var ts = new TransactionScope())
                {
                    _rawMaterialInBLL.SaveEntity_List(false, "", lstInEntity, out msg);

                    if (insertStockList.Count > 0)
                        _rawMaterialStockService.SaveEntity_List(false, "", insertStockList, out msg);

                    if (updateStockList.Count > 0)
                        _rawMaterialStockService.SaveEntity_List(true, "", updateStockList, out msg);

                    ts.Complete();
                }

                return AjaxResult(true, Language.GetText("Common.Success"));//操作成功
            }
            catch (Exception ex)
            {
                return AjaxResult(false, Language.GetText("Common.ErrorWithOther2") + ex.Message);//操作失败
            }
        }
        #endregion
    }
}
