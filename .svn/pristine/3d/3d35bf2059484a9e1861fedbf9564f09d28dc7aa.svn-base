<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()"
            class="btn side-panel-button">
        {{'Siemens.SimaticIT.PlanApp.Plan.edit.Tips_1'|translate}}
    </button>
    <button ng-click="vm.save()" class="btn side-panel-button"
            ng-show="vm.validInputs">
        {{'Siemens.SimaticIT.PlanApp.Plan.edit.Tips_2'|translate}}
    </button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form" sit-layout="Vertical" sit-type="Fluid" sit-mode="edit" sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2"
                           style="margin-left: 4px;">
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductOrder"
                          sit-validation="{required: true}" sit-read-only="true">
                {{'Siemens.SimaticIT.PlanApp.Plan.edit.Tips_3'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.typeClientSelect.value"
                          sit-validation="{required: true}" sit-options="vm.typeClientSelect.options" sit-to-display="'ItemName'"
                          sit-to-keep="'ItemCode'" sit-read-only="false">
                {{'Siemens.SimaticIT.PlanApp.Plan.edit.Tips_4'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.typeOrderTypeSelect.value"
                          sit-validation="{required: false}" sit-options="vm.typeOrderTypeSelect.options"
                          sit-to-display="'ItemName'" sit-to-keep="'ItemValue'" style="max-width:100px;" sit-read-only="vm.orderTypeReadonly">
                {{'Siemens.SimaticIT.PlanApp.Plan.edit.Tips_5'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductPlanNo"
                          sit-validation="{required: false}" sit-read-only="false">
                {{'Siemens.SimaticIT.PlanApp.Plan.edit.Tips_6'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-datepicker" sit-value="vm.OrderDate" sit-validation="{required: true}"
                          sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="false">
                {{'Siemens.SimaticIT.PlanApp.Plan.edit.Tips_7'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-datepicker" sit-value="vm.DeliveryDate" sit-validation="{required: true}"
                          sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="false">
                {{'Siemens.SimaticIT.PlanApp.Plan.edit.Tips_8'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-datepicker" sit-value="vm.BoxDate" sit-validation="{required: true}"
                          sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="false">
                {{'Siemens.SimaticIT.PlanApp.Plan.edit.Tips_9'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.typeOrderStatusSelect.value"
                          sit-validation="{required: false}" sit-options="vm.typeOrderStatusSelect.options"
                          sit-to-display="'ItemName'" sit-to-keep="'ItemValue'" style="max-width:100px;" sit-read-only="true">
                {{'Siemens.SimaticIT.PlanApp.Plan.edit.Tips_10'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Salesman" sit-validation="{required: false}"
                          sit-read-only="false">{{'Siemens.SimaticIT.PlanApp.Plan.edit.Tips_11'|translate}}</sit-property>
            <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Technology"
                          sit-validation="{required: true}" style="min-height:500px;height:500px;" sit-read-only="false">
                {{'Siemens.SimaticIT.PlanApp.Plan.edit.Tips_12'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                          style="min-height:500px;height:500px;" sit-read-only="false">
                {{'Siemens.SimaticIT.PlanApp.Plan.edit.Tips_13'|translate}}
            </sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>