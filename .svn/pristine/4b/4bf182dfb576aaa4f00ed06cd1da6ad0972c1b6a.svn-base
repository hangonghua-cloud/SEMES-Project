        /// <summary>
        /// 自制半成品工单创建-SAP工单创建接口
        /// </summary>
        public (bool Flag, string Msg, string Data) PM_OwnProductOrderTOSAP(PM_OwnProductOrderEntity entity)
        {
            IF110 sapRequest = new IF110();
            sapRequest.HEAD = new SapHeadDto();
            sapRequest.HEAD.INIF_ID = SAPInterface.IF110.ToString();

            var materialEntity = new Base_Material_Service().Get_ExpressionEntity(t => t.MaterialCode == entity.MaterialCode);

            sapRequest.RSQ_DATA = new IF110_RSQ_DATA();
            IF110_DATA iF110_DATA = new IF110_DATA();
            iF110_DATA.WERKS = entity.FactoryCode ?? "";
            iF110_DATA.MATNR = materialEntity?.SAPMaterialCode ?? "";
            iF110_DATA.AUART = entity.FactoryCode ?? "";
            iF110_DATA.GAMNG = entity.PlanQty.ToString() ?? "";
            iF110_DATA.GSTRP = entity.CreateTime.Value.ToString("yyyyMMdd");
            iF110_DATA.GLTRP = entity.CreateTime.Value.ToString("yyyyMMdd");
            iF110_DATA.ABLAD = entity.WorkOrder ?? "";
            iF110_DATA.PLNNR_ALT = entity.ProcessRoute ?? "";
            iF110_DATA.BOMCODE = entity.BOMCode ?? "";
            iF110_DATA.TXT = entity.Remark ?? "";
            sapRequest.RSQ_DATA.IS_DATA = iF110_DATA;

            var result = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
            return result;

        }

        /// <summary>
        /// 半成品工单状态修改-SAP结案
        /// </summary>
        /// <param name="entities"></param>
        /// <param name="postUser">过账人员</param>
        /// <returns></returns>
        public bool PM_OwnProductOrderStatusTOSAP(List<PM_OwnProductOrderEntity> entities, string postUser)
        {
            var isbool = true;
            try
            {
                var dicList = new DataItemDetailService().GetDataItemList("WorkOrderStatus").ToList();//工单状态转换成SAP定义的

                IF128 sapRequest = new IF128();
                sapRequest.HEAD = new SapHeadDto();
                sapRequest.HEAD.INIF_ID = SAPInterface.IF128.ToString();
                sapRequest.RSQ_DATA = new IF128_RSQ_DATA();
                List<IF128_HEAD> IT_HEAD = new List<IF128_HEAD>();
                foreach (var item in entities)
                {
                    IF128_HEAD iF128_HEAD = new IF128_HEAD();
                    iF128_HEAD.AUFNR = item.SAP_AUFNR;
                    iF128_HEAD.APRIO = dicList.Find(t => t.ItemValue == "9")?.Description;
                    IT_HEAD.Add(iF128_HEAD);
                }
                sapRequest.RSQ_DATA.IT_HEAD = IT_HEAD;
                var sapResult = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                if (!sapResult.Flag)
                {
                    isbool = false;
                }

                var IT_RETURNs = JsonConvert.DeserializeObject<List<IF128_RSP_DATA>>(getValue(JObject.Parse(sapResult.Data), "IT_RETURN"));
                List<PM_OwnProductOrderEntity> workOrderEntities = new List<PM_OwnProductOrderEntity>();
                foreach (var item in IT_RETURNs)
                {
                    var workEntity = new PM_OwnProductOrder_Service().Get_ExpressionEntity(t => t.SAP_AUFNR == item.AUFNR);
                    if (workEntity != null)
                    {
                        if (item.STATUS == "S")
                        {
                            workEntity.Update_IsPosted = "1";
                            workEntity.Update_PostedMsg = item.MESSAGE;
                            workEntity.Update_PostedTime = DateTime.Now;
                            workEntity.Update_PostedUser = postUser;
                            workEntity.OrderStatus = "9";
                        }
                        else
                        {
                            workEntity.Update_PostedMsg = item.MESSAGE;
                            workEntity.Update_PostedTime = DateTime.Now;
                            workEntity.Update_PostedUser = postUser;
                        }
                        workOrderEntities.Add(workEntity);
                    }

                }
                string msg = "";
                new PM_OwnProductOrder_Service().SaveEntity_List(true, "", workOrderEntities, out msg);
            }
            catch (Exception ex)
            {
                throw;
            }
            return isbool;
        }

        /// <summary>
        /// 生产工单状态修改-SAP结案
        /// </summary>
        /// <param name="entities"></param>
        /// <param name="postUser">过账人员</param>
        /// <returns></returns>
        public bool PL_WorkOrderStatusTOSAP(List<PL_WorkOrderEntity> entities, string postUser)
        {
            var isbool = true;
            try
            {
                var dicList = new DataItemDetailService().GetDataItemList("WorkOrderStatus").ToList();//工单状态转换成SAP定义的

                IF128 sapRequest = new IF128();
                sapRequest.HEAD = new SapHeadDto();
                sapRequest.HEAD.INIF_ID = SAPInterface.IF128.ToString();
                sapRequest.RSQ_DATA = new IF128_RSQ_DATA();
                List<IF128_HEAD> IT_HEAD = new List<IF128_HEAD>();
                foreach (var item in entities)
                {
                    IF128_HEAD iF128_HEAD = new IF128_HEAD();
                    iF128_HEAD.AUFNR = item.SAP_AUFNR;
                    iF128_HEAD.APRIO = dicList.Find(t => t.ItemValue == "9")?.Description;
                    IT_HEAD.Add(iF128_HEAD);
                }
                sapRequest.RSQ_DATA.IT_HEAD = IT_HEAD;
                var sapResult = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                if (!sapResult.Flag)
                {
                    isbool = false;
                }

                var IT_RETURNs = JsonConvert.DeserializeObject<List<IF128_RSP_DATA>>(getValue(JObject.Parse(sapResult.Data), "IT_RETURN"));
                List<PL_WorkOrderEntity> workOrderEntities = new List<PL_WorkOrderEntity>();
                foreach (var item in IT_RETURNs)
                {
                    var workOrderList = new PL_WorkOrder_Service().Get_ExpressionList(t => t.SAP_AUFNR == item.AUFNR).ToList();
                    if (workOrderList.Count > 0)
                    {
                        workOrderList.ForEach(t =>
                        {
                            if (item.STATUS == "S")
                            {
                                t.Update_IsPosted = "1";
                                t.Update_PostedMsg = item.MESSAGE;
                                t.Update_PostedTime = DateTime.Now;
                                t.Update_PostedUser = postUser;
                                t.OrderStatus = "9";
                            }
                            else
                            {
                                t.Update_PostedMsg = item.MESSAGE;
                                t.Update_PostedTime = DateTime.Now;
                                t.Update_PostedUser = postUser;
                            }
                            workOrderEntities.Add(t);
                        });
                    }

                }
                if (workOrderEntities.Count > 0)
                {
                    string msg = "";
                    new PL_WorkOrder_Service().SaveEntity_List(true, "SAP", workOrderEntities, out msg);
                }
            }
            catch (Exception ex)
            {
                throw;
            }
            return isbool;
        }

        /// <summary>
        /// 工单发布-SAP工单创建接口
        /// </summary>
        public bool PL_WorkOrderTOSAP(List<PL_WorkOrderEntity> workOrderList, string postUser)
        {
            var isbool = true;

            try
            {
                IF110 sapRequest = new IF110();
                sapRequest.HEAD = new SapHeadDto();
                sapRequest.HEAD.INIF_ID = SAPInterface.IF106.ToString();
                sapRequest.RSQ_DATA = new IF110_RSQ_DATA();
                if (workOrderList.Any())
                {
                    foreach (var item in workOrderList)
                    {
                        var PL_BOM = new PL_BOM_Service().Get_ExpressionEntity(t => t.WorkOrder == item.WorkOrder);
                        IF110_DATA iF110_DATA = new IF110_DATA();
                        iF110_DATA.WERKS = item.FactoryCode;
                        iF110_DATA.MATNR = item.MaterialCode;
                        iF110_DATA.AUART = item.FactoryCode;
                        iF110_DATA.GAMNG = item.OrderPieces.ToString();
                        iF110_DATA.GSTRP = item.CreateTime.Value.ToString("yyyyMMdd");
                        iF110_DATA.GLTRP = item.GiveTime.Value.ToString("yyyyMMdd");
                        iF110_DATA.ABLAD = item.WorkOrder;
                        iF110_DATA.PLNNR_ALT = item.Process;
                        iF110_DATA.BOMCODE = PL_BOM.BOMCode;
                        iF110_DATA.KDAUF = item.ProductOrder;
                        iF110_DATA.KDPOS = item.Orderline;
                        iF110_DATA.TXT = item.Remark;
                        sapRequest.RSQ_DATA.IS_DATA = iF110_DATA;
                        var result = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                        var isPosted = result.Flag ? "1" : "";
                        var postedMsg = result.Msg;
                        var data = result.Data;
                        item.IsPosted = isPosted;
                        item.PostedMsg = postedMsg;
                        item.PostedTime = DateTime.Now;
                        item.PostedUser = postUser;
                        if (isPosted == "1")
                        {
                            item.SAP_AUFNR = getValue(JObject.Parse(data), "EV_AUFNR");
                        }
                        else
                        {
                            isbool = false;
                        }
                        new RepositoryFactory().BaseRepository().Update(item);
                    }
                }
                else
                {
                    isbool = false;
                }

            }
            catch (Exception ex)
            {
                throw;
            }
            return isbool;
        }

        public (bool, string) WorkOrderCreateToSAP(List<PL_WorkOrderEntity> workOrderList, string postUser, List<PL_BOMEntity> plBOMList)
        {
            IF110 sapRequest = new IF110();
            sapRequest.HEAD = new SapHeadDto();
            sapRequest.HEAD.INIF_ID = SAPInterface.IF110.ToString();
            sapRequest.RSQ_DATA = new IF110_RSQ_DATA();

            //物料集合
            var arrMaterialCode = workOrderList.Select(t => t.MaterialCode).Distinct().ToArray();
            var materialList = new Base_Material_Service().Get_ExpressionList(t => arrMaterialCode.Contains(t.MaterialCode)).ToList();

            //生产张数、放量张数、大小转换  用于sap接口
            var dylist = new PL_WorkOrder_Service().GetWorkOrderYield(workOrderList.First().ProductOrder);
            if (dylist.Count < 1 || dylist.ToList().Any(t => t.Yield == null))
                return (false, "没有获取到良率");

            //工单 大小转换
            var arrWorkOrder = workOrderList.Select(t => t.WorkOrder).ToArray();
            var plMaterialList = new PL_Material_Service().Get_ExpressionList(t => arrWorkOrder.Contains(t.WorkOrder) && t.IsDeleted == false).ToList();
            var arrPLMaterialId = plMaterialList.Select(t => t.Id).ToArray();
            var plMaterialFacetList = new PL_MaterialFacet_Service().Get_ExpressionList(t => arrPLMaterialId.Contains(t.MaterialId)
                && t.AttrCode == "DXZH").ToList();

            foreach (var item in workOrderList.OrderBy(t => t.Orderline))
            {
                var plMaterialEntity = plMaterialList.Find(t => t.WorkOrder == item.WorkOrder);
                if (plMaterialEntity == null)
                    return (false, $"工单[{item.WorkOrder}]物料没有数据");

                var plMaterialFacetEntity = plMaterialFacetList.Find(t => t.MaterialId == plMaterialEntity.Id);
                if (plMaterialFacetEntity == null || string.IsNullOrEmpty(plMaterialFacetEntity.AttrValue))
                    return (false, $"工单[{item.WorkOrder}]没有大小张转换");

                var dxzh = plMaterialFacetEntity.AttrValue.ToDecimal();
                var totalSheets = Math.Ceiling((item.OrderPieces / dxzh).Value);
                var yield = (Decimal)dylist.Find(t => t.WorkOrder == item.WorkOrder)?.Yield;
                if (yield <= 0 || yield > 1)
                    return (false, "良率必须在0-1之间");

                var actualQty = Math.Ceiling(totalSheets / yield);
                item.TotalSheets = totalSheets;
                item.ActualSheets = actualQty;

                var PL_BOM = plBOMList.Find(T => T.WorkOrder == item.WorkOrder);
                IF110_DATA iF110_DATA = new IF110_DATA();
                iF110_DATA.WERKS = item.FactoryCode ?? "";
                iF110_DATA.MATNR = materialList.Find(t => t.MaterialCode == item.MaterialCode)?.SAPMaterialCode ?? "";
                iF110_DATA.AUART = item.FactoryCode ?? "";
                //iF110_DATA.GAMNG = (item.ActualSheets * dxzh).ToString() ?? "";
                iF110_DATA.GAMNG = item.OrderPieces.ToString() ?? ""; //韩总要求改成下单片数 2024-06-11
                //iF110_DATA.GSTRP = item.CreateTime.Value.ToString("yyyyMMdd");
                iF110_DATA.GSTRP = DateTime.Now.ToString("yyyyMMdd");//韩总要求改成当前日期 2024-09-09
                iF110_DATA.GLTRP = item.GiveTime.Value.ToString("yyyyMMdd");
                iF110_DATA.ABLAD = item.WorkOrder ?? "";
                iF110_DATA.PLNNR_ALT = item.Process ?? "";
                iF110_DATA.BOMCODE = PL_BOM.BOMCode ?? "";
                iF110_DATA.KDAUF = item.ProductOrder ?? "";
                iF110_DATA.KDPOS = item.Orderline ?? "";
                iF110_DATA.TXT = item.Remark ?? "";
                sapRequest.RSQ_DATA.IS_DATA = iF110_DATA;

                var result = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                if (!result.Flag)
                    return (false, result.Msg);

                item.IsPosted = result.Flag ? "1" : ""; ;
                item.PostedMsg = result.Msg;
                item.PostedTime = DateTime.Now;
                item.PostedUser = postUser;
                item.SAP_AUFNR = getValue(JObject.Parse(result.Data), "EV_AUFNR");
                new RepositoryFactory().BaseRepository().Update(item);
            }

            return (true, "");
        }

        /// <summary>
        /// 原材料发货-SAP销售交货单过账
        /// </summary>
        public void RawMaterialDispatchToSAP()
        {
            try
            {
                IF106 sapRequest = new IF106();
                sapRequest.HEAD = new SapHeadDto();
                sapRequest.HEAD.INIF_ID = SAPInterface.IF106.ToString();
                sapRequest.RSQ_DATA = new IF106_RSQ_DATA();
                //获取成品发货数据
                string sql = string.Format(@"SELECT * FROM dbo.MM_RawMaterialDispatch WHERE Status='3' AND ISNULL(IsPosted,'')=''");
                var ProductDispatchItems = new RepositoryFactory().BaseRepository().FindList<MMRawMaterialDispatchEntity>(sql);
                if (ProductDispatchItems.Any())
                {
                    foreach (var item in ProductDispatchItems)
                    {
                        IF106_HEAD IF106_HEAD = new IF106_HEAD();
                        IF106_HEAD.ZGZ = "G";
                        IF106_HEAD.VSTEL = item.FactoryCode;
                        IF106_HEAD.VSTEL = item.DeliveryNo;
                        IF106_HEAD.WADAT_IST = Convert.ToDateTime(item.PostDate).ToString("yyyyMMdd");
                        IF106_HEAD.ZMESDATE = DateTime.Now.ToString("yyyyMMdd");
                        IF106_HEAD.ZMESTIME = DateTime.Now.ToString("hhmmss");
                        sapRequest.RSQ_DATA.IS_HEAD = IF106_HEAD;
                        var result = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                        var isPosted = result.Flag ? "1" : "";
                        var postedMsg = result.Msg;
                        var data = result.Data;

                        item.IsPosted = isPosted;
                        item.PostedMsg = postedMsg;
                        item.PostedTime = DateTime.Now;
                        item.PostedUser = "SAP";
                        if (isPosted == "1")
                        {
                            item.SAP_MBLNR = getValue(JObject.Parse(data), "EV_MBLNR");
                            item.SAP_VBELN = getValue(JObject.Parse(data), "EV_VBLEN");

                        }
                        new RepositoryFactory().BaseRepository().Update(item);
                    }
                }
            }
            catch (Exception ex)
            {
                throw;
            }
        }

