                IT_ITEM3.Add(IF152_ITEM3);
            }
            sapRequest.RSQ_DATA.IT_ITEM3 = IT_ITEM3;

            var result = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
            var dataList = data.ToDataList<MM_RawMaterialInEntity>();
            foreach (var item in dataList)
            {
                item.IsPosted = result.Flag ? "0" : "";
                item.PostedMsg = result.Msg;
                item.PostedTime = DateTime.Now;
                item.PostedUser = "SAP";
            }
            string msg = "";
            new MM_RawMaterialIn_Service().SaveEntity_List(true, "", dataList, out msg);
        }
        #endregion

        #region 自制半成品报工入库-SAP <0 IF122
        public void OwnProductBG_InWhs2()
        {
            IF122 sapRequest = new IF122();
            sapRequest.HEAD = new SapHeadDto();
            sapRequest.HEAD.INIF_ID = SAPInterface.IF122.ToString();
            sapRequest.RSQ_DATA = new IF122_RSQ_DATA();

            // 获取明细数据
            string sql = string.Format(@"SELECT TOP 900 a.Id,
                                           a.CreateTime,
                                           a.Creator,
                                           a.FactoryCode,
                                           a.SAPInType,
                                           b.SAP_AUFNR,
                                           ABS(a.Qty) Qty,
                                           a.LocationCode,
	                                       a.BatchNo,
										   c.SAPMaterialCode
                                    FROM dbo.MM_RawMaterialIn a
                                        INNER JOIN dbo.PM_OwnProductOrder b
                                            ON a.WorkOrder = b.WorkOrder
								        INNER JOIN dbo.Base_Material c ON a.MaterialCode=c.MaterialCode
                                    WHERE a.InType = '9'
                                          AND ISNULL(a.IsPosted, '') = ''
										  AND a.Qty<0
										  ORDER BY a.CreateTime ");
            var data = new RepositoryFactory().BaseRepository().FindTable(sql);
            if (data.Rows.Count == 0)
                return;

            foreach (DataRow item in data.Rows)
            {
                string id = item["Id"].ToString();
                var entity = new MM_RawMaterialIn_Service().Get_ExpressionEntity(t => t.Id == id);
                if (entity == null)
                {
                    continue;
                }

                IF122_HEAD IF122_HEAD = new IF122_HEAD();
                IF122_HEAD.BUDAT = item["CreateTime"].ToDate().ToString("yyyyMMdd") ?? "";
                IF122_HEAD.BKTXT = item["Creator"].ToString() ?? "";
                IF122_HEAD.LFSNR = "";
                IF122_HEAD.AUFNR = item["SAP_AUFNR"].ToString() ?? "";
                IF122_HEAD.MATNR = item["SAPMaterialCode"].ToString() ?? "";
                IF122_HEAD.ERFMG = item["Qty"].ToString().Replace("-", "") ?? "";
                IF122_HEAD.LGOBE = item["LocationCode"].ToString() ?? "";
                IF122_HEAD.CHARG = item["BatchNo"].ToString() ?? "";
                IF122_HEAD.PWERK = item["FactoryCode"].ToString() ?? "";
                sapRequest.RSQ_DATA.IS_HEAD = IF122_HEAD;

                var sapResult = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                entity.IsPosted = sapResult.Flag ? "1" : "";
                entity.PostedMsg = sapResult.Msg;
                entity.PostedTime = DateTime.Now;
                entity.PostedUser = "SAP";
                if (sapResult.Flag)
                {
                    entity.SAP_MBLNR = getValue(JObject.Parse(sapResult.Data), "EV_MBLNR");
                    entity.SAP_MJAHR = getValue(JObject.Parse(sapResult.Data), "EV_MJAHR");
                }

                string msg = "";
                new MM_RawMaterialIn_Service().SaveEntity(entity.Id, entity, out msg);
            }
        }
        #endregion

        #region 成品发货-SAP IF150、106
        public void ProductDispatch()
        {
            var productDispatchItemList = new MM_ProductDispatchItem_Service().Get_ExpressionList(t => string.IsNullOrEmpty(t.IsPosted)
                && t.Status == "3").OrderBy(t => t.CreateTime).Take(900).ToList();
            if (productDispatchItemList.Count == 0)
                return;

            var arrId = productDispatchItemList.Select(t => t.Id).ToArray();
            var productOutList = new MM_ProductOut_Service().Get_ExpressionList(t => arrId.Contains(t.BusinessId)).ToList();

            foreach (var item in productDispatchItemList)
            {
                #region IF150 交货单修改
                IF150 sapRequest1 = new IF150();
                sapRequest1.HEAD = new SapHeadDto();
                sapRequest1.HEAD.INIF_ID = SAPInterface.IF150.ToString();

                sapRequest1.RSQ_DATA = new IF150_RSQ_DATA();
                IF150_DATA IF150_DATA = new IF150_DATA();
                IF150_DATA.ZGZ = item.PostMark;
                IF150_DATA.VSTEL = item.FactoryCode ?? "";
                IF150_DATA.VBELN = item.DocNum ?? "";
                IF150_DATA.ZFPN = item.InvoiceNO ?? "";
                IF150_DATA.ZTDN = item.LoadingBill ?? "";
                IF150_DATA.ZJS = item.BoxNum == null ? "" : item.BoxNum.ToString() ?? "";
                IF150_DATA.ZJZID = item.ContainerID ?? "";
                IF150_DATA.ZFXN = item.SealingNo ?? "";
                IF150_DATA.ZCID = item.CarNumber ?? "";
                IF150_DATA.ZCCG = item.ForkliftWorker ?? "";
                IF150_DATA.ZMG = item.WoodWorker ?? "";
                IF150_DATA.ZFHR = item.Operator ?? "";
                IF150_DATA.ZDAT3 = DateTime.Now.ToString("yyyyMMdd");
                IF150_DATA.ZTIM3 = DateTime.Now.ToString("HHmmss");
                IF150_DATA.ZNAM3 = item.Operator ?? "";
                IF150_DATA.WADAT_IST = item.PostDate == null ? DateTime.Now.ToString("yyyyMMdd") : item.PostDate.Value.ToString("yyyyMMdd");
                sapRequest1.RSQ_DATA.IS_DATA = IF150_DATA;

                List<IF150_ITEM> IT_ITEM = new List<IF150_ITEM>();
                var details = productOutList.FindAll(t => t.BusinessId == item.Id);
                var arrMaterialCode = details.Select(t => t.MaterialCode).Distinct().ToArray();
                var materialList = new Base_Material_Service().Get_ExpressionList(t => arrMaterialCode.Contains(t.MaterialCode)).ToList();
                foreach (var groupItem in details.GroupBy(t => t.MaterialCode))
                {
                    int i = 1;
                    foreach (var detail in groupItem)
                    {
                        IF150_ITEM IF150_ITEM = new IF150_ITEM();
                        IF150_ITEM.POSNR = detail.LineNum ?? "";
                        if (groupItem.Count() > 1)
                        {
                            IF150_ITEM.ZPOSNR = i.ToString() ?? "";
                        }
                        IF150_ITEM.VGBEL = detail.ProductOrder ?? "";
                        IF150_ITEM.VGPOS = detail.OrderLine ?? "";
                        IF150_ITEM.MATNR = materialList.Find(t => t.MaterialCode == detail.MaterialCode)?.SAPMaterialCode ?? "";
                        IF150_ITEM.LFIMG = detail.PieceQty.ToString() ?? "";
                        IF150_ITEM.LGORT = detail.LocationCode ?? "";
                        IF150_ITEM.CHARG = "";
                        IT_ITEM.Add(IF150_ITEM);

                        i += 1;
                    }
                }
                sapRequest1.RSQ_DATA.IT_ITEM = IT_ITEM;
                var sapResult1 = SAPHelper.Instance.PostToSAP(sapRequest1.HEAD.INIF_ID, sapRequest1);

                item.IsPosted = sapResult1.Flag ? "1" : "";
                item.PostedMsg = sapResult1.Msg;
                item.PostedTime = DateTime.Now;
                item.PostedUser = "SAP";
                if (sapResult1.Flag)
                {
                    item.SAP_MBLNR = getValue(JObject.Parse(sapResult1.Data), "EV_MBLNR");
                    item.SAP_VBELN = getValue(JObject.Parse(sapResult1.Data), "EV_VBLEN");
                }
                #endregion

                #region IF106 交货单过账
                //IF106 sapRequest = new IF106();
                //sapRequest.HEAD = new SapHeadDto();
                //sapRequest.HEAD.INIF_ID = SAPInterface.IF106.ToString();

                //sapRequest.RSQ_DATA = new IF106_RSQ_DATA();
                //IF106_HEAD IF106_HEAD = new IF106_HEAD();
                //IF106_HEAD.ZGZ = item.PostMark ?? "";
                //IF106_HEAD.VSTEL = item.FactoryCode ?? "";
                //IF106_HEAD.VBELN = item.DocNum ?? "";
                //IF106_HEAD.WADAT_IST = DateTime.Now.ToString("yyyyMMdd");
                //IF106_HEAD.ZMESDATE = DateTime.Now.ToString("yyyyMMdd");
                //IF106_HEAD.ZMESTIME = DateTime.Now.ToString("HHmmss");
                //sapRequest.RSQ_DATA.IS_HEAD = IF106_HEAD;

                //var sapResult = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);

                //item.IsPosted = sapResult.Flag ? "1" : "";
                //item.PostedMsg = sapResult.Msg;
                //item.PostedTime = DateTime.Now;
                //item.PostedUser = "SAP";
                //if (sapResult.Flag)
                //{
                //    item.SAP_MBLNR = getValue(JObject.Parse(sapResult.Data), "EV_MBLNR");
                //    item.SAP_VBELN = getValue(JObject.Parse(sapResult.Data), "EV_VBLEN");
                //}
                #endregion
            }

            string msg = "";
            new MM_ProductDispatchItem_Service().SaveEntity_List(true, "", productDispatchItemList, out msg);
        }
        #endregion

        #region 库存查询 IF135
        public void StockQuery()
        {
            IF135 sapRequest = new IF135();
            sapRequest.HEAD = new SapHeadDto();
            sapRequest.HEAD.INIF_ID = SAPInterface.IF135.ToString();
            sapRequest.RSQ_DATA = new IF135_RSQ_DATA();

            var keyEntity = new Base_KeyParameterItem_Service().Get_ExpressionEntity(t => t.EnCode == "String" && t.ItemCode == "StockSyncFactory");
            var factoryCode = keyEntity?.ItemValue;
            if (string.IsNullOrEmpty(factoryCode))
                return;

            List<IF135_DATA> IT_DATA = new List<IF135_DATA>();

            IF135_DATA IF135_DATA = new IF135_DATA();
            IF135_DATA.WERKS = factoryCode;
            IT_DATA.Add(IF135_DATA);
            sapRequest.RSQ_DATA.IT_DATA = IT_DATA;

            var result = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
            if (result.Flag)
            {
                var data = JsonConvert.DeserializeObject<List<IF135_RETURN>>(getValue(result.Data.ToJObject(), "ET_RETURN"));

                DataTable dt = Tools.ToDataTable(data);
                //调用存储过程
                SqlParameter[] parameters = {
                    new SqlParameter("@FactoryCode",SqlDbType.VarChar, 50),
                    new SqlParameter("@Stock", dt)
                };
                parameters[0].Value = factoryCode;

                //执行存贮过程
                Data.Dapper.SqlDatabase db = new Data.Dapper.SqlDatabase();
                db.ExecuteProcedure("Pro_StockQuery", parameters);

            }
        }
        #endregion
    }
}
