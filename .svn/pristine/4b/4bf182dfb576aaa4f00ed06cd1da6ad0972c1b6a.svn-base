        #region 自制半成品报工-SAP IF152
        public void OwnProductBG()
        {
            IF152 sapRequest = new IF152();
            sapRequest.HEAD = new SapHeadDto();
            sapRequest.HEAD.INIF_ID = SAPInterface.IF152.ToString();
            sapRequest.RSQ_DATA = new IF152_RSQ_DATA();

            IF152_HEAD IF152_HEAD = new IF152_HEAD();
            IF152_HEAD.ZBTYPE = SAPBusinessType.自制半成品报工.GetHashCode().ToString();
            IF152_HEAD.ZTYPE = SAPBusinessType.自制半成品报工.ToString();
            sapRequest.RSQ_DATA.IS_HEAD = IF152_HEAD;

            // 获取明细数据
            string sql = string.Format(@"SELECT TOP 900 a.Id,
                                       a.CreateTime,
                                       a.FactoryCode,
                                       b.SAP_AUFNR,
                                       b.ProcessRoute,
                                       a.BGProcess,
                                       a.Creator,
                                       a.BGQty,
                                       a.BadQty,
									   a.VGW01,
									   a.VGW02,
									   a.VGW03,
									   a.VGW04,
									   a.VGW05,
									   a.VGW06
                                FROM dbo.PM_OwnProductBG a
                                    INNER JOIN dbo.PM_OwnProductOrder b
                                        ON a.WorkOrder = b.WorkOrder
                                WHERE ISNULL(a.IsPosted, '') = ''
								AND (a.BGQty+a.BadQty)<>0
								ORDER BY a.CreateTime ");
            var data = new RepositoryFactory().BaseRepository().FindTable(sql);
            if (data.Rows.Count == 0)
                return;

            List<IF152_ITEM1> IT_ITEM1 = new List<IF152_ITEM1>();
            foreach (DataRow item in data.Rows)
            {
                //报工数量超过10000，自动过滤掉，sap限制
                var bgQty = Convert.ToDecimal(item["BGQty"].ToString());
                if (bgQty > 10000)
                    continue;

                IF152_ITEM1 IF152_ITEM1 = new IF152_ITEM1();
                IF152_ITEM1.MESID = item["Id"].ToString() ?? "";
                IF152_ITEM1.ZTIME = item["CreateTime"].ToDate().ToString("yyyyMMddHHmmssfff") ?? "";
                IF152_ITEM1.WERKS = item["FactoryCode"].ToString() ?? "";
                IF152_ITEM1.AUFNR = item["SAP_AUFNR"].ToString() ?? "";
                IF152_ITEM1.PLNNR_ALT = item["ProcessRoute"].ToString() ?? "";
                IF152_ITEM1.KTSCH = item["BGProcess"].ToString() ?? "";
                IF152_ITEM1.BUDAT = item["CreateTime"].ToDate().ToString("yyyyMMdd") ?? "";
                IF152_ITEM1.TXT1 = item["Creator"].ToString() ?? "";
                IF152_ITEM1.NUM1 = item["BGQty"].ToString() ?? "";
                IF152_ITEM1.NUM2 = item["BadQty"].ToString() ?? "";
                IF152_ITEM1.TXT2 = "";
                IF152_ITEM1.VGW01 = item["VGW01"].ToString() ?? "";
                IF152_ITEM1.VGW02 = item["VGW02"].ToString() ?? "";
                IF152_ITEM1.VGW03 = item["VGW03"].ToString() ?? "";
                IF152_ITEM1.VGW04 = item["VGW04"].ToString() ?? "";
                IF152_ITEM1.VGW05 = item["VGW05"].ToString() ?? "";
                IF152_ITEM1.VGW06 = item["VGW06"].ToString() ?? "";
                IT_ITEM1.Add(IF152_ITEM1);
            }
            sapRequest.RSQ_DATA.IT_ITEM1 = IT_ITEM1;

            var result = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
            var dataList = data.ToDataList<PM_OwnProductBGEntity>();
            foreach (var item in dataList)
            {
                item.IsPosted = result.Flag ? "0" : "";
                item.PostedMsg = result.Msg;
                item.PostedTime = DateTime.Now;
                item.PostedUser = "SAP";

                if (item.BGQty > 10000)
                {
                    item.PostedMsg = "数量超过10000，SAP不允许";
                }
            }
            string msg = "";
            new PM_OwnProductBG_Service().SaveEntity_List(true, "", dataList, out msg);
        }
        #endregion

        #region 流转卡报工 物料消耗-SAP IF152
        public void TransferCardBG_MatConsume()
        {
            IF152 sapRequest = new IF152();
            sapRequest.HEAD = new SapHeadDto();
            sapRequest.HEAD.INIF_ID = SAPInterface.IF152.ToString();
            sapRequest.RSQ_DATA = new IF152_RSQ_DATA();

            IF152_HEAD IF152_HEAD = new IF152_HEAD();
            IF152_HEAD.ZBTYPE = SAPBusinessType.领退料.GetHashCode().ToString();
            IF152_HEAD.ZTYPE = SAPBusinessType.领退料.ToString();
            sapRequest.RSQ_DATA.IS_HEAD = IF152_HEAD;

            // 获取明细数据
            string sql = string.Format(@"SELECT TOP 900 a.Id,
                                       a.CreateTime,
									   a.Creator,
                                       a.FactoryCode,
                                       b.SAP_AUFNR,
                                       a.MaterialCode,
                                       a.BatchNo,
                                       a.Qty,
                                       a.LocationCode,
                                       a.MaterialType
                                FROM dbo.MM_RawMaterialOut a
                                    INNER JOIN dbo.PL_WorkOrder b
                                        ON a.WorkOrder = b.WorkOrder
                                WHERE a.BGType = '1'
                                      AND a.OutType = '1'
                                      AND ISNULL(a.IsPosted, '') = ''
									  AND a.Qty<>0
									  ORDER BY a.CreateTime ");
            var data = new RepositoryFactory().BaseRepository().FindTable(sql);
            if (data.Rows.Count == 0)
                return;

            var arrMaterialCode = data.AsEnumerable().Select(row => row.Field<string>("MaterialCode")).Distinct();
            var materialList = new Base_Material_Service().Get_ExpressionList(t => arrMaterialCode.Contains(t.MaterialCode)).ToList();

            List<IF152_ITEM2> IT_ITEM2 = new List<IF152_ITEM2>();
            foreach (DataRow item in data.Rows)
            {
                IF152_ITEM2 IF152_ITEM2 = new IF152_ITEM2();
                IF152_ITEM2.MESID = item["Id"].ToString() ?? "";
                IF152_ITEM2.ZTIME = item["CreateTime"].ToDate().ToString("yyyyMMddHHmmssfff") ?? "";
                IF152_ITEM2.WERKS = item["FactoryCode"].ToString() ?? "";
                IF152_ITEM2.AUFNR = item["SAP_AUFNR"].ToString() ?? "";
                IF152_ITEM2.BUDAT = item["CreateTime"].ToDate().ToString("yyyyMMdd") ?? "";
                IF152_ITEM2.BKTXT = "";
                IF152_ITEM2.MTSNR = "";
                IF152_ITEM2.MATNR = materialList.Find(t => t.MaterialCode == item["MaterialCode"].ToString())?.SAPMaterialCode ?? "";
                IF152_ITEM2.CHARG = item["BatchNo"].ToString() ?? "";
                IF152_ITEM2.ERFMG = item["Qty"].ToString() ?? "";
                IF152_ITEM2.ISHS = item["MaterialType"].ToString() ?? "";
                IF152_ITEM2.LGORT = item["LocationCode"].ToString() ?? "";
                IF152_ITEM2.SGTXT = item["Creator"].ToString() ?? "";
                IT_ITEM2.Add(IF152_ITEM2);
            }
            sapRequest.RSQ_DATA.IT_ITEM2 = IT_ITEM2;

            var result = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
            var dataList = data.ToDataList<MM_RawMaterialOutEntity>();
            foreach (var item in dataList)
            {
                item.IsPosted = result.Flag ? "0" : "";
                item.PostedMsg = result.Msg;
                item.PostedTime = DateTime.Now;
                item.PostedUser = "SAP";
            }
            string msg = "";
            new MM_RawMaterialOut_Service().SaveEntity_List(true, "", dataList, out msg);
        }
        #endregion

