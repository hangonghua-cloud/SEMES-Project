                IF152_ITEM1.BUDAT = item["CreateTime"].ToDate().ToString("yyyyMMdd") ?? "";
                IF152_ITEM1.TXT1 = item["Creator"].ToString() ?? "";
                IF152_ITEM1.NUM1 = item["Qty"].ToString() ?? "";
                IF152_ITEM1.NUM2 = item["BadQty"].ToString() ?? "";
                IF152_ITEM1.TXT2 = "";
                IF152_ITEM1.VGW01 = item["VGW01"].ToString() ?? "";
                IF152_ITEM1.VGW02 = item["VGW02"].ToString() ?? "";
                IF152_ITEM1.VGW03 = item["VGW03"].ToString() ?? "";
                IF152_ITEM1.VGW04 = item["VGW04"].ToString() ?? "";
                IF152_ITEM1.VGW05 = item["VGW05"].ToString() ?? "";
                IF152_ITEM1.VGW06 = item["VGW06"].ToString() ?? "";
                IT_ITEM1.Add(IF152_ITEM1);
            }
            sapRequest.RSQ_DATA.IT_ITEM1 = IT_ITEM1;

            var result = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
            var dataList = data.ToDataList<PM_PackingBGTransferCardEntity>();
            foreach (var item in dataList)
            {
                item.IsPosted = result.Flag ? "0" : "";
                item.PostedMsg = result.Msg;
                item.PostedTime = DateTime.Now;
                item.PostedUser = "SAP";

                if (item.Qty > 10000)
                {
                    item.PostedMsg = "数量超过10000，SAP不允许";
                }
            }
            string msg = "";
            new PM_PackingBGTransferCard_Service().SaveEntity_List(true, "", dataList, out msg);
        }
