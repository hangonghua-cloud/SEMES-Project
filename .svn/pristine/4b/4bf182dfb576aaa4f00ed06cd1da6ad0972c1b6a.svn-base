        #region 包装报工入库-SAP >0 IF152
        public void PackingBG_InWhs()
        {
            IF152 sapRequest = new IF152();
            sapRequest.HEAD = new SapHeadDto();
            sapRequest.HEAD.INIF_ID = SAPInterface.IF152.ToString();
            sapRequest.RSQ_DATA = new IF152_RSQ_DATA();

            IF152_HEAD IF152_HEAD = new IF152_HEAD();
            IF152_HEAD.ZBTYPE = SAPBusinessType.包装入库.GetHashCode().ToString();
            IF152_HEAD.ZTYPE = SAPBusinessType.包装入库.ToString();
            sapRequest.RSQ_DATA.IS_HEAD = IF152_HEAD;

            // 获取明细数据
            string sql = string.Format(@"SELECT TOP 900 a.Id,
                                       a.CreateTime,
                                       a.Creator,
                                       a.FactoryCode,
                                       a.SAPInType,
                                       b.SAP_AUFNR,
                                       a.PieceQty,
                                       a.LocationCode,
                                       a.ProductOrder,
                                       a.LineNum,
									   CASE a.SAPInType WHEN '1' THEN b.SAP_AUFNR WHEN '2' THEN  c.SAP_AUFNR ELSE '' END S_WorkOrder,
									   CASE a.SAPInType WHEN '1' THEN '' WHEN '2' THEN a.ProductOrder ELSE '' END T_ProductOrder,
									   CASE a.SAPInType WHEN '1' THEN '' WHEN '2' THEN a.LineNum ELSE '' END T_LineNum
                                FROM dbo.MM_ProductIn a
                                    INNER JOIN dbo.PL_WorkOrder b
                                        ON a.WorkOrder = b.WorkOrder
									LEFT JOIN dbo.PL_WorkOrder c ON a.S_WorkOrder=c.WorkOrder
                                WHERE a.InType = '1' AND a.PieceQty > 0
                                      AND ISNULL(a.IsPosted, '') = ''
									  ORDER BY a.CreateTime ");
            var data = new RepositoryFactory().BaseRepository().FindTable(sql);
            if (data.Rows.Count == 0)
                return;

            List<IF152_ITEM3> IT_ITEM3 = new List<IF152_ITEM3>();
            foreach (DataRow item in data.Rows)
            {
                IF152_ITEM3 IF152_ITEM3 = new IF152_ITEM3();
                IF152_ITEM3.MESID = item["Id"].ToString() ?? "";
                IF152_ITEM3.ZTIME = item["CreateTime"].ToDate().ToString("yyyyMMddHHmmssfff") ?? "";
                IF152_ITEM3.WERKS = item["FactoryCode"].ToString() ?? "";
                IF152_ITEM3.ZTYPE = item["SAPInType"].ToString() ?? "";
                IF152_ITEM3.BUDAT = item["CreateTime"].ToDate().ToString("yyyyMMdd") ?? "";
                IF152_ITEM3.BKTXT = item["Creator"].ToString() ?? ""; ;
                IF152_ITEM3.LFSNR = "";
                IF152_ITEM3.AUFNR = item["S_WorkOrder"].ToString() ?? "";
                IF152_ITEM3.ERFMG = item["PieceQty"].ToString() ?? "";
                IF152_ITEM3.LGOBE = item["LocationCode"].ToString() ?? "";
                IF152_ITEM3.CHARG = "";
                IF152_ITEM3.UMMAT_KDAUF = item["T_ProductOrder"].ToString() ?? "";
                IF152_ITEM3.UMMAT_KDPOS = item["T_LineNum"].ToString() ?? "";
                IT_ITEM3.Add(IF152_ITEM3);
            }
            sapRequest.RSQ_DATA.IT_ITEM3 = IT_ITEM3;

            var result = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
            var dataList = data.ToDataList<MM_ProductInEntity>();
            foreach (var item in dataList)
            {
                item.IsPosted = result.Flag ? "0" : "";
                item.PostedMsg = result.Msg;
                item.PostedTime = DateTime.Now;
                item.PostedUser = "SAP";
            }
            string msg = "";
            new MM_ProductIn_Service().SaveEntity_List(true, "", dataList, out msg);
        }
        #endregion

        #region 包装报工入库-SAP <0 IF122
        public void PackingBG_InWhs2()
        {
            IF122 sapRequest = new IF122();
            sapRequest.HEAD = new SapHeadDto();
            sapRequest.HEAD.INIF_ID = SAPInterface.IF122.ToString();
            sapRequest.RSQ_DATA = new IF122_RSQ_DATA();

            // 获取明细数据
            string sql = string.Format(@"SELECT TOP 900 a.Id,
                                       a.CreateTime,
                                       a.Creator,
                                       a.FactoryCode,
                                       a.SAPInType,
                                       b.SAP_AUFNR,
									   d.SAPMaterialCode,
                                       ABS(a.PieceQty) PieceQty,
                                       a.LocationCode,
                                       a.ProductOrder,
                                       a.LineNum,
									   CASE a.SAPInType WHEN '1' THEN b.SAP_AUFNR WHEN '2' THEN  c.SAP_AUFNR ELSE '' END S_WorkOrder,
									   CASE a.SAPInType WHEN '1' THEN '' WHEN '2' THEN a.ProductOrder ELSE '' END T_ProductOrder,
									   CASE a.SAPInType WHEN '1' THEN '' WHEN '2' THEN a.LineNum ELSE '' END T_LineNum
                                FROM dbo.MM_ProductIn a
                                    INNER JOIN dbo.PL_WorkOrder b
                                        ON a.WorkOrder = b.WorkOrder
									LEFT JOIN dbo.PL_WorkOrder c ON a.S_WorkOrder=c.WorkOrder
									LEFT JOIN dbo.Base_Material d ON a.MaterialCode=d.MaterialCode
                                WHERE a.InType = '1' AND a.PieceQty < 0
                                      AND ISNULL(a.IsPosted, '') = ''
									  ORDER BY a.CreateTime ");
            var data = new RepositoryFactory().BaseRepository().FindTable(sql);
            if (data.Rows.Count == 0)
                return;

            foreach (DataRow item in data.Rows)
            {
                string id = item["Id"].ToString();
                var entity = new MM_ProductIn_Service().Get_ExpressionEntity(t => t.Id == id);
                if (entity == null)
                {
                    continue;
                }

                IF122_HEAD IF122_HEAD = new IF122_HEAD();
                IF122_HEAD.BUDAT = item["CreateTime"].ToDate().ToString("yyyyMMdd") ?? "";
                IF122_HEAD.BKTXT = item["Creator"].ToString() ?? "";
                IF122_HEAD.LFSNR = "";
                IF122_HEAD.AUFNR = item["SAP_AUFNR"].ToString() ?? "";
                IF122_HEAD.MATNR = item["SAPMaterialCode"].ToString() ?? "";
                IF122_HEAD.ERFMG = item["PieceQty"].ToString();
                IF122_HEAD.LGOBE = item["LocationCode"].ToString() ?? "";
                IF122_HEAD.CHARG = "";
                IF122_HEAD.PWERK = item["FactoryCode"].ToString() ?? "";
                sapRequest.RSQ_DATA.IS_HEAD = IF122_HEAD;

                var sapResult = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                entity.IsPosted = sapResult.Flag ? "1" : "";
                entity.PostedMsg = sapResult.Msg;
                entity.PostedTime = DateTime.Now;
                entity.PostedUser = "SAP";
                if (sapResult.Flag)
                {
                    entity.SAP_MBLNR = getValue(JObject.Parse(sapResult.Data), "EV_MBLNR");
                    entity.SAP_MJAHR = getValue(JObject.Parse(sapResult.Data), "EV_MJAHR");
                }

                string msg = "";
                new MM_ProductIn_Service().SaveEntity(entity.Id, entity, out msg);
            }
        }
        #endregion

