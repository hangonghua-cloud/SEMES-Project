        /// <summary>
        /// 自制半成品报工物料消耗-SAP工单领退料
        /// </summary>
        public void OwnProductBGMatConsumeToSAP()
        {
            try
            {
                IF112 sapRequest = new IF112();
                sapRequest.HEAD = new SapHeadDto();
                sapRequest.HEAD.INIF_ID = SAPInterface.IF112.ToString();
                sapRequest.RSQ_DATA = new IF112_RSQ_DATA();
                string dbsql = string.Format(@"
                
                SELECT a.*,b.SAP_AUFNR FROM dbo.MM_RawMaterialOut a
                INNER JOIN  dbo.PM_OwnProductOrder b ON a.WorkOrder=b.WorkOrder
                WHERE a.BGType='4' AND a.OutType='1' AND ISNULL(a.IsPosted,'')=''");
                var MM_RawMaterialOutLists = new RepositoryFactory().BaseRepository().FindList<SAPMM_RawMaterialOutEntity>(dbsql);
                if (MM_RawMaterialOutLists.Any())
                {
                    foreach (var items in MM_RawMaterialOutLists.GroupBy(t => t.SAP_AUFNR))
                    {
                        IF112_DATA IF112_DATA = new IF112_DATA();

                        IF112_DATA.AUFNR = items.FirstOrDefault().SAP_AUFNR;
                        IF112_DATA.BUDAT = items.FirstOrDefault().PostDate == null ? "" : items.FirstOrDefault().PostDate.Value.ToString("yyyyMMdd");
                        IF112_DATA.BKTXT = items.FirstOrDefault().Creator;
                        IF112_DATA.MTSNR = items.FirstOrDefault().WorkOrder;
                        sapRequest.RSQ_DATA.IS_DATA = IF112_DATA;
                        List<IF112_ITEM> IS_ITEM = new List<IF112_ITEM>();
                        foreach (var item in items)
                        {
                            IF112_ITEM IF112_ITEM = new IF112_ITEM();
                            IF112_ITEM.MATNR = item.MaterialCode;
                            IF112_ITEM.WERKS = item.FactoryCode;
                            IF112_ITEM.CHARG = item.BatchNo;
                            IF112_ITEM.ERFMG = item.Qty.ToString();
                            IF112_ITEM.ISHS = item.MaterialClass;
                            IF112_ITEM.LGORT = item.LocationCode;
                            IS_ITEM.Add(IF112_ITEM);
                        }
                        sapRequest.RSQ_DATA.IS_ITEM = IS_ITEM;
                        var result = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                        var isPosted = result.Flag ? "1" : "";
                        var postedMsg = result.Msg;
                        var data = result.Data;
                        foreach (var item in items)
                        {
                            //查找出库表信息
                            var MM_RawMaterialOut = new MM_RawMaterialOut_Service().Get_ExpressionEntity(t => t.Id == item.Id);
                            MM_RawMaterialOut.IsPosted = isPosted;
                            MM_RawMaterialOut.PostedMsg = postedMsg;
                            MM_RawMaterialOut.PostedTime = DateTime.Now;
                            MM_RawMaterialOut.PostedUser = "SAP";
                            MM_RawMaterialOut.SAP_MBLNR = getValue(JObject.Parse(data), "EV_MBLNR");
                            MM_RawMaterialOut.SAP_MJAHR = getValue(JObject.Parse(data), "EV_MJAHR");
                            new RepositoryFactory().BaseRepository().Update(MM_RawMaterialOut);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                throw;
            }
        }

        /// <summary>
        ///    包装报工  流转卡报工物料消耗-SAP工单领退料
        /// </summary>
        public void CardAndPackBGMatConsumeToSAP()
        {
            try
            {
                IF112 sapRequest = new IF112();
                sapRequest.HEAD = new SapHeadDto();
                sapRequest.HEAD.INIF_ID = SAPInterface.IF112.ToString();
                sapRequest.RSQ_DATA = new IF112_RSQ_DATA();
                string dbsql = string.Format(@"
                SELECT a.*,b.SAP_AUFNR FROM dbo.MM_RawMaterialOut a
                INNER JOIN  dbo.PL_WorkOrder b ON a.WorkOrder=b.WorkOrder
                WHERE a.BGType IN('1','3') AND a.OutType='1' AND ISNULL(a.IsPosted,'')=''");
                var MM_RawMaterialOutLists = new RepositoryFactory().BaseRepository().FindList<SAPMM_RawMaterialOutEntity>(dbsql);
                if (MM_RawMaterialOutLists.Any())
                {
                    foreach (var items in MM_RawMaterialOutLists.GroupBy(t => t.SAP_AUFNR))
                    {
                        IF112_DATA IF112_DATA = new IF112_DATA();

                        IF112_DATA.AUFNR = items.FirstOrDefault().SAP_AUFNR;
                        IF112_DATA.BUDAT = items.FirstOrDefault().PostDate == null ? "" : items.FirstOrDefault().PostDate.Value.ToString("yyyyMMdd");
                        IF112_DATA.BKTXT = items.FirstOrDefault().Creator;
                        IF112_DATA.MTSNR = items.FirstOrDefault().WorkOrder;
                        sapRequest.RSQ_DATA.IS_DATA = IF112_DATA;
                        List<IF112_ITEM> IS_ITEM = new List<IF112_ITEM>();
                        foreach (var item in items)
                        {
                            IF112_ITEM IF112_ITEM = new IF112_ITEM();
                            IF112_ITEM.MATNR = item.MaterialCode;
                            IF112_ITEM.WERKS = item.FactoryCode;
                            IF112_ITEM.CHARG = item.BatchNo;
                            IF112_ITEM.ERFMG = item.Qty.ToString();
                            IF112_ITEM.ISHS = item.MaterialClass;
                            IF112_ITEM.LGORT = item.LocationCode;
                            IS_ITEM.Add(IF112_ITEM);
                        }
                        sapRequest.RSQ_DATA.IS_ITEM = IS_ITEM;
                        var result = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                        var isPosted = result.Flag ? "1" : "";
                        var postedMsg = result.Msg;
                        var data = result.Data;
                        foreach (var item in items)
                        {
                            //查找出库表信息
                            var MM_RawMaterialOut = new MM_RawMaterialOut_Service().Get_ExpressionEntity(t => t.Id == item.Id);
                            MM_RawMaterialOut.IsPosted = isPosted;
                            MM_RawMaterialOut.PostedMsg = postedMsg;
                            MM_RawMaterialOut.PostedTime = DateTime.Now;
                            MM_RawMaterialOut.PostedUser = "SAP";
                            MM_RawMaterialOut.SAP_MBLNR = getValue(JObject.Parse(data), "EV_MBLNR");
                            MM_RawMaterialOut.SAP_MJAHR = getValue(JObject.Parse(data), "EV_MJAHR");
                            new RepositoryFactory().BaseRepository().Update(MM_RawMaterialOut);
                        }
                    }
                }
            }
            catch (Exception ex)
            {
                throw;
            }
        }

        /// <summary>
        /// 原材料调拨-SAP调拨过账
        /// </summary>
        public void RawMaterialDBToSAP()
        {
            try
            {
                IF102 sapRequest = new IF102();
                sapRequest.HEAD = new SapHeadDto();
                sapRequest.HEAD.INIF_ID = SAPInterface.IF102.ToString();
                sapRequest.RSQ_DATA = new IF102_RSQ_DATA();

                //获取调拨数据
                string dbSql = string.Format(@"
	                          SELECT a.* ,
	                          b.Id AS Bid,
	                          b.FactoryCode AS BFactoryCode,
	                          B.LocationCode AS BLocationCode,
	                          b.BatchNo AS BBatchNo FROM dbo.MM_RawMaterialOut a
							  INNER JOIN dbo.MM_RawMaterialIn b ON a.AssociateNo=a.AssociateNo
							  WHERE ISNULL(a.IsPosted,'')=''");
                var RawMaterialDBLists = new RepositoryFactory().BaseRepository().FindList<MM_SelectRawMaterialOutEntity>(dbSql);

                if (RawMaterialDBLists.Any())
                {
                    foreach (var items in RawMaterialDBLists.GroupBy(t => t.PostDate))
                    {
                        IF102_HEAD IF102_HEAD = new IF102_HEAD();
                        IF102_HEAD.BLDAT = DateTime.Now.ToString("yyyyMMdd");
                        IF102_HEAD.BUDAT = items.FirstOrDefault().PostDate.ToString("yyyyMMdd"); ;
                        sapRequest.RSQ_DATA.IS_HEAD = IF102_HEAD;

                        List<IF102_ITEM> IS_ITEM = new List<IF102_ITEM>();
                        foreach (var item in items)
                        {
                            IF102_ITEM IF102_ITEM = new IF102_ITEM();
                            IF102_ITEM.BWART = "311";
                            IF102_ITEM.MATNR = item.MaterialCode;
                            IF102_ITEM.WERKS = item.FactoryCode;
                            IF102_ITEM.CHARG = item.BatchNo;
                            IF102_ITEM.ERFMG = item.Qty.ToString();
                            IF102_ITEM.ERFME = item.Unit;
                            IF102_ITEM.UMWRK = item.BFactoryCode;
                            IF102_ITEM.UMLGO = item.BLocationCode;
                            IF102_ITEM.UMCHA = item.BBatchNo;
                            IS_ITEM.Add(IF102_ITEM);
                        }
                        sapRequest.RSQ_DATA.IT_ITEM = IS_ITEM;
                        var result = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                        var isPosted = result.Flag ? "1" : "";
                        var postedMsg = result.Msg;
                        var data = result.Data;
                        foreach (var item in items)
                        {
                            //查找出库表信息
                            var MM_RawMaterialOut = new MM_RawMaterialOut_Service().Get_ExpressionEntity(t => t.Id == item.Id);

                            MM_RawMaterialOut.IsPosted = isPosted;
                            MM_RawMaterialOut.PostedMsg = postedMsg;
                            MM_RawMaterialOut.PostedTime = DateTime.Now;
                            MM_RawMaterialOut.PostedUser = "SAP";
                            MM_RawMaterialOut.SAP_MBLNR = getValue(JObject.Parse(data), "EV_MBLNR");
                            new RepositoryFactory().BaseRepository().Update(MM_RawMaterialOut);
                            // item.SAPYear = getValue(JObject.Parse(data), "EV_MJAHR");

                            //查找入库表信息
                            var MM_RawMaterialin = new MM_RawMaterialIn_Service().Get_ExpressionEntity(t => t.Id == item.Bid);
                            MM_RawMaterialin.IsPosted = isPosted;
                            MM_RawMaterialin.PostedMsg = postedMsg;
                            MM_RawMaterialin.PostedTime = DateTime.Now;
                            MM_RawMaterialin.PostedUser = "SAP";
                            MM_RawMaterialin.SAP_MBLNR = getValue(JObject.Parse(data), "EV_MBLNR");
                            new RepositoryFactory().BaseRepository().Update(MM_RawMaterialin);
                        }

                    }
                }


            }
            catch (Exception ex)
            {
                throw;
            }
        }

        /// <summary>
        /// 原材料出库-SAP领退料过账
        /// </summary>
        public void RawMaterialOutWhsToSAP()
        {
            try
            {
                IF116 sapRequest = new IF116();
                sapRequest.HEAD = new SapHeadDto();
                sapRequest.HEAD.INIF_ID = SAPInterface.IF116.ToString();
                sapRequest.RSQ_DATA = new IF116_RSQ_DATA();

                IF116_HEAD IF116_HEAD = new IF116_HEAD();
                IF116_HEAD.BLDAT = DateTime.Now.ToString("yyyyMMdd");
                IF116_HEAD.BUDAT = DateTime.Now.ToString("yyyyMMdd");
                sapRequest.RSQ_DATA.IS_HEAD = IF116_HEAD;

                //获取明细数据
                string smallSql = string.Format(@"SELECT * FROM dbo.MM_RawMaterialOut WHERE OutType='10' AND ISNULL(IsPosted,'')=''");
                var RawMaterialOunLists = new RepositoryFactory().BaseRepository().FindList<MM_RawMaterialOutEntity>(smallSql);
                if (RawMaterialOunLists.Any())
                {
                    List<IF116_ITEM> IT_ITEM = new List<IF116_ITEM>();
                    foreach (var item in RawMaterialOunLists)
                    {
                        IF116_ITEM IF116_ITEM = new IF116_ITEM();
                        IF116_ITEM.BWART = item.MoveType;
                        IF116_ITEM.MATNR = item.MaterialCode;
                        IF116_ITEM.WERKS = item.FactoryCode;
                        IF116_ITEM.LGORT = item.LocationCode;
                        IF116_ITEM.CHARG = item.BatchNo;
                        IF116_ITEM.ERFMG = item.Qty.ToString();
                        IF116_ITEM.ERFME = item.Unit;
                        IF116_ITEM.KOSTL = item.WorkShopCode;
                        IF116_ITEM.AUFNR = item.ProductOrder;
                        IF116_ITEM.SGTXT = "";
                        IT_ITEM.Add(IF116_ITEM);
                    }
                    sapRequest.RSQ_DATA.IT_ITEM = IT_ITEM;

                    var result = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                    var isPosted = result.Flag ? "1" : "";
                    var postedMsg = result.Msg;
                    var data = result.Data;
                    //更新采购入库单据

                    foreach (var item in RawMaterialOunLists)
                    {
                        item.IsPosted = isPosted;
                        item.PostedMsg = postedMsg;
                        item.PostedTime = DateTime.Now;
                        item.PostedUser = "SAP";
                        item.SAP_MBLNR = getValue(JObject.Parse(data), "EV_MBLNR");
                        item.SAP_MJAHR = getValue(JObject.Parse(data), "EV_MJAHR");

                        new RepositoryFactory().BaseRepository().Update(item);
                    }

                }
            }
            catch (Exception ex)
            {
                throw;
            }
        }
        /// <summary>
        /// 成品发货-SAP销售交货单冲销过账
        /// </summary>
        public void ProductDispatchItemOffToSAP()
        {
            try
            {
                IF106 sapRequest = new IF106();
                sapRequest.HEAD = new SapHeadDto();
                sapRequest.HEAD.INIF_ID = SAPInterface.IF106.ToString();
                sapRequest.RSQ_DATA = new IF106_RSQ_DATA();
                //获取成品发货数据
                string sql = string.Format(@"SELECT * FROM dbo.MM_ProductDispatchItem WHERE PostMark='R' AND  ISNULL(Off_IsPosted,'')='' ");
                var ProductDispatchItems = new RepositoryFactory().BaseRepository().FindList<MM_ProductDispatchItemEntity>(sql);
                if (ProductDispatchItems.Any())
                {
                    foreach (var item in ProductDispatchItems)
                    {
                        IF106_HEAD IF106_HEAD = new IF106_HEAD();
                        IF106_HEAD.ZGZ = "R";
                        IF106_HEAD.VSTEL = item.FactoryCode;
                        IF106_HEAD.VSTEL = item.DocNum;
                        IF106_HEAD.WADAT_IST = Convert.ToDateTime(item.SendTime).ToString("yyyyMMdd");
                        IF106_HEAD.ZMESDATE = DateTime.Now.ToString("yyyyMMdd");
                        IF106_HEAD.ZMESTIME = DateTime.Now.ToString("hhmmss");
                        sapRequest.RSQ_DATA.IS_HEAD = IF106_HEAD;
                        var result = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                        var Off_IsPosted = result.Flag ? "1" : "";
                        var Off_PostedMsg = result.Msg;
                        var data = result.Data;

                        item.Off_IsPosted = Off_IsPosted;
                        item.Off_PostedMsg = Off_PostedMsg;
                        item.Off_PostedTime = DateTime.Now;
                        item.Off_PostedUser = "SAP";
                        if (Off_IsPosted == "1")
                        {
                            item.Off_SAP_MBLNR = getValue(JObject.Parse(data), "EV_MBLNR");
                            item.Off_SAP_VBELN = getValue(JObject.Parse(data), "EV_VBLEN");

                        }
                        new RepositoryFactory().BaseRepository().Update(item);
                    }
                }
            }
            catch (Exception ex)
            {
                throw;
            }
        }

