        /// <summary>
        /// 采购入库-SAP采购订单入库
        /// </summary>
        public void PurchaseInWhsToSAP()
        {
            try
            {
                IF108 sapRequest = new IF108();
                sapRequest.HEAD = new SapHeadDto();
                sapRequest.HEAD.INIF_ID = SAPInterface.IF108.ToString();
                sapRequest.RSQ_DATA = new IF108_RSQ_DATA();

                IF108_HEAD IF108_HEAD = new IF108_HEAD();
                IF108_HEAD.BLDAT = DateTime.Now.ToString("yyyyMMdd");
                IF108_HEAD.BUDAT = DateTime.Now.ToString("yyyyMMdd");
                sapRequest.RSQ_DATA.IS_HEAD = IF108_HEAD;

                //获取明细数据
                string smallSql = string.Format(@"SELECT * FROM dbo.MM_RawMaterialIn WHERE InType='10' AND ISNULL(IsPosted,'')=''");
                var RawMaterialInLists = new RepositoryFactory().BaseRepository().FindList<MM_RawMaterialInEntity>(smallSql);
                if (RawMaterialInLists.Any())
                {
                    List<IF108_ITEM> IT_ITEM = new List<IF108_ITEM>();
                    foreach (var item in RawMaterialInLists)
                    {
                        IF108_ITEM IF108_ITEM = new IF108_ITEM();
                        IF108_ITEM.BWART = "101";
                        IF108_ITEM.MATNR = item.MaterialCode;
                        IF108_ITEM.WERKS = item.FactoryCode;
                        IF108_ITEM.LGORT = item.LocationCode;
                        IF108_ITEM.CHARG = string.IsNullOrEmpty(item.BatchNo) ? "" : item.BatchNo;
                        IF108_ITEM.ERFMG = item.Qty.ToString();
                        IF108_ITEM.ERFME = item.Unit;
                        IF108_ITEM.LIFNR = item.SupplierCode;
                        IF108_ITEM.EBELN = item.PurchaseOrder;
                        IF108_ITEM.EBELP = item.LineNum;
                        IT_ITEM.Add(IF108_ITEM);
                    }
                    sapRequest.RSQ_DATA.IT_ITEM = IT_ITEM;
                    var result = SAPHelper.Instance.PostToSAP(sapRequest.HEAD.INIF_ID, sapRequest);
                    var isPosted = result.Flag ? "1" : "";
                    var postedMsg = result.Msg;
                    var data = result.Data;
                    //更新采购入库单据

                    foreach (var item in RawMaterialInLists)
                    {
                        item.IsPosted = isPosted;
                        item.PostedMsg = postedMsg;
                        item.PostedTime = DateTime.Now;
                        item.PostedUser = "SAP";
                        if (isPosted == "1")
                        {
                            item.SAP_MBLNR = getValue(JObject.Parse(data), "EV_MBLNR");
                            item.SAP_MJAHR = getValue(JObject.Parse(data), "EV_MJAHR");

                        }
                        new RepositoryFactory().BaseRepository().Update(item);
                    }

                }
            }
            catch (Exception ex)
            {
                throw;
            }
        }

