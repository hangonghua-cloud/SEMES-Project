<style>
    .MainCommandActionButton {
        margin-top: 20px !important;
    }
</style>
<div id="itemlist" class="content-area content-area-relative" style="height: calc(93% - 30px) !important">
    <!--查询条件与功能按钮-->
    <div class="col-md-40" style="margin-left: 15px;">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit"
                               sit-columns="8">
                <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value"
                              sit-validation="{required: false}" sit-options="vm.typeFactory.options"
                              sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="false"
                              sit-change="vm.typeFactoryChange">{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_1'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.ProductOrder" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_2'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.ContainerNO" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_3'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.MaterialCode" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_4'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.MMXH" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_5'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.Spec" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_6'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.FlowCardId" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_7'|translate}}</sit-property>
                <sit-property sit-widget="sit-select" sit-read-only="false" sit-options="vm.Process.options"
                              style="max-width:300px;" sit-to-keep="'ResourceCode'" sit-validation="{required: false}"
                              sit-value="vm.Process.value" sit-change="vm.ProcessChange" sit-to-display="'ResourceName'">
                    {{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_8'|translate}}
                </sit-property>
                <!--<sit-property sit-widget="sit-text" sit-value="vm.currentItem.TestMachine" sit-validation="{required: true}"
                              sit-read-only="false">{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_9'|translate}}</sit-property>-->
                <!-- <sit-property sit-widget="sit-select" sit-read-only="false" sit-options="vm.TestMachineConfig.options"
                              style="max-width:300px;" sit-to-keep="'ResourceCode'" sit-validation="{required: false}"
                              sit-value="vm.TestMachineConfig.value" sit-to-display="'ResourceName'">
                    {{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_9'|translate}}
                </sit-property> -->
                <!-- <sit-property sit-widget="sit-select" sit-read-only="false" sit-options="vm.ListTypeConfig.options"
                              style="max-width:300px;" sit-to-keep="'ItemValue'" sit-validation="{required: false}"
                              sit-value="vm.ListTypeConfig.selectedOption" sit-change="vm.selectProcess"
                              sit-to-display="'ItemName'">
                    {{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_10'|translate}}
                </sit-property> -->
                <sit-property sit-widget="sit-select" sit-read-only="false" sit-options="vm.LaboratoryConfig.options"
                              style="max-width:300px;" sit-to-keep="'ItemValue'" sit-validation="{required: false}"
                              sit-value="vm.LaboratoryConfig.selectedOption" sit-change="vm.selectProcess"
                              sit-to-display="'ItemName'">
                    {{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_11'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-select" sit-read-only="false" sit-options="vm.DeterminationConfig.options"
                              style="max-width:300px;" sit-to-keep="'ItemValue'" sit-validation="{required: false}"
                              sit-value="vm.DeterminationConfig.selectedOption" sit-change="vm.selectProcess"
                              sit-to-display="'ItemName'">
                    {{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_12'|translate}}
                </sit-property>
                <!--<sit-property sit-widget="sit-alp-text-picker"
                              sit-read-only="false"
                              sit-validation="{required: false}"
                              sit-value="vm.searchParams.TestMachineName"
                              ng-click="vm.SelectResourceModal()">
                    {{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_13'|translate}}
                </sit-property>-->
                <!--<sit-property sit-widget="sit-text" sit-value="vm.searchParams.InspectorName" sit-read-only="false" style="max-width:300px;">{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_14'|translate}}</sit-property>-->
                <sit-property sit-widget="sit-datepicker" sit-value="vm.StartDate" style="max-width:300px;"
                              sit-format="'yyyy-MM-dd'" sit-validation="{required: false}" sit-read-only="false">
                    {{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_15'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-datepicker" sit-value="vm.EndDate" style="max-width:300px;"
                              sit-format="'yyyy-MM-dd'" sit-validation="{required: false}" sit-read-only="false">
                </sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.DeptName" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_16'|translate}}</sit-property>
                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                                 :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_17'|translate}}" ng-click="vm.searchButtonHandler" :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_17'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div>
    <!--右侧功能按钮-->
    <sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">
        <sit-command sit-icon="fa-eye" sit-name="com.siemens.customcommand.search" :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_18'|translate}}"
                     ng-click="vm.selectButtonHandler" ng-show="vm.isButtonVisible" :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_18'|translate}}"></sit-command>
        <sit-command sit-icon="fa-trash" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_19'|translate}}"
                     ng-click="vm.deleteButtonHandler" :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_19'|translate}}" ng-show="vm.isButtonVisible"></sit-command>
        <sit-command sit-icon="fa-pencil-square-o" sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_20'|translate}}"
                     ng-click="vm.qualityButtonHandler" :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_20'|translate}}" ng-show="vm.isButtonVisible"></sit-command>
        <sit-command sit-icon="fa-pencil" sit-name="com.siemens.customcommand.lab" ng-click="vm.labButtonHandler"
                     :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_21'|translate}}" :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_21'|translate}}" sit-type="main" ng-show="vm.isButtonVisible"></sit-command>
        <sit-command sit-icon="fa-plus" sit-name="com.siemens.customcommand.add" ng-click="vm.addButtonHandler"
                     :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_22'|translate}}" :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_PollingDetail.QC_PollingDetaillist.Tips_22'|translate}}" sit-type="main"></sit-command>
    </sit-command-bar>
    <!-- grid列表 -->
    <div id="listClass1" style="width:100%; height: 44%; padding:0px 16px 0 16px; margin-top: 90px;">
        <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
             ui-grid-pagination class="uigrid"></div>
    </div>
    <div id="listClass2" style="width:100%; height: 45%; padding:0px 16px 0 16px; margin-top: 3px;">
        <div ui-grid="vm.gridOptionsItem" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
             ui-grid-pagination class="uigrid"></div>
    </div>
</div>