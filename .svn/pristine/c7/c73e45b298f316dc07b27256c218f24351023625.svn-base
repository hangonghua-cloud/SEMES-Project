<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.MMReceiptNotice.ReceiptNoticeeditDetail.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.MaterialApp.MMReceiptNotice.ReceiptNoticeeditDetail.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2">
        <!-- TODO: Put here the properties of the entity managed by the service -->
        <sit-property sit-widget="sit-text" sit-value="vm.mainCurrentItem.ReceiptCode" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.MMReceiptNotice.ReceiptNoticeeditDetail.Tips_3'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductOrder" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.MMReceiptNotice.ReceiptNoticeeditDetail.Tips_4'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialCode" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.MMReceiptNotice.ReceiptNoticeeditDetail.Tips_5'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialName" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.MMReceiptNotice.ReceiptNoticeeditDetail.Tips_6'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Unit" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.MMReceiptNotice.ReceiptNoticeeditDetail.Tips_7'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.mainCurrentItem.ArrivalQty" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.MMReceiptNotice.ReceiptNoticeeditDetail.Tips_8'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.SupplierName" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.MMReceiptNotice.ReceiptNoticeeditDetail.Tips_9'|translate}}</sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.BatchNo" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.MMReceiptNotice.ReceiptNoticeeditDetail.Tips_10'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.Qty" sit-validation="{required: true, min: 0}"
                      sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.MMReceiptNotice.ReceiptNoticeeditDetail.Tips_11'|translate}}</sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.typeWarehouse.value" sit-validation="{required: true}"
                      sit-options="vm.typeWarehouse.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                      sit-change="vm.WarehouseChange">
            {{'Siemens.SimaticIT.MaterialApp.MMReceiptNotice.ReceiptNoticeeditDetail.Tips_12'|translate}}
        </sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.Location.value" sit-validation="{required: true}"
                      sit-options="vm.Location.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'">
            {{'Siemens.SimaticIT.MaterialApp.MMReceiptNotice.ReceiptNoticeeditDetail.Tips_13'|translate}}
        </sit-property>
    </sit-property-grid>
</div>