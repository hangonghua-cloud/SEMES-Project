<style>
    .MainCommandActionButton {
        margin-top: 20px !important;
    }

    .green {
        color: rgb(38, 228, 31)
    }

    .red {
        color: red
    }
</style>
<div id="itemlist" class="content-area content-area-relative" style="height: calc(93% - 30px) !important">
    <!--查询条件与功能按钮-->
    <div class="col-md-40" style="margin-left: 15px;">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit"
                               sit-columns="8">
                <sit-property sit-widget="sit-select" sit-value="vm.Factory.value" sit-validation="{required: false}"
                              sit-options="vm.Factory.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                              sit-read-only="false" sit-change="vm.FactoryChange">{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_1'|translate}}</sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.Process.value" sit-validation="{required: false}"
                              sit-options="vm.Process.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                              sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_2'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.ExeWorkOrder" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_3'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.ContainerNO" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_4'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.CardCode" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_5'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.Spec" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_6'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.MaterialCode" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_7'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.LocationName" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_8'|translate}}</sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.typeTransfer.value"
                              sit-options="vm.typeTransfer.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                              sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_9'|translate}}</sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.typeEnalbed.value"
                              sit-options="vm.typeEnalbed.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                              sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_10'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.MMXH" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_11'|translate}}</sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.typeWorkOrder.value"
                              sit-options="vm.typeWorkOrder.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                              sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_12'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.UserName" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_13'|translate}}</sit-property>
                <sit-property sit-widget="sit-date-time-picker" sit-value="vm.StartTime" sit-format="'yyyy-MM-dd'"
                              sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_14'|translate}}</sit-property>
                <sit-property sit-widget="sit-date-time-picker" sit-value="vm.EndTime" sit-format="'yyyy-MM-dd'"
                              sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_15'|translate}}</sit-property>
                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                                 :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_16'|translate}}" ng-click="vm.searchButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_16'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div>
    <!--右侧功能按钮-->
    <sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">

        <sit-command sit-icon="fa-fast-backward" sit-name="com.siemens.customcommand.rollback" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_17'|translate}}"
                     ng-click="vm.rollbackButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.TransferCardResume.Tips_17'|translate}}" ng-show="vm.isButtonVisible"></sit-command>
    </sit-command-bar>
    <!-- grid列表 -->
    <div id="listClass" style="width:100%; height: 90%; padding:0px 16px 0 16px; margin-top: 90px;">
        <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
             ui-grid-pagination class="uigrid"></div>
    </div>

</div>