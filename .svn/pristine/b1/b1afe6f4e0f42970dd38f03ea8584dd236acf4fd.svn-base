using ALP.Application.Entity.AppManage;
using System.Data.Entity.ModelConfiguration;

namespace ALP.Application.Mapping.AppManage
{
    /// <summary>
    /// 创 建：超级管理员
    /// 日 期：2019-07-25 11:08
    /// 描 述：模具调拨记录
    /// </summary>
    public class AppVersionMap : EntityTypeConfiguration<AppVersionEntity>
    {
        public AppVersionMap()
        {
            #region 表、主键
            //表
            this.ToTable("App_AppVersion");
            //主键
            this.HasKey(t => t.Id);
            #endregion
        }
    }
}
