<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.MMSaleDomestic.SaleDomesticedit.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.MaterialApp.MMSaleDomestic.SaleDomesticedit.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2" style="margin-left: 4px;">
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductOrder" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.MMSaleDomestic.SaleDomesticedit.Tips_3'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialCode" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.MMSaleDomestic.SaleDomesticedit.Tips_4'|translate}}</sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.typeWarehouse.value" sit-validation="{required: true}"
                          sit-options="vm.typeWarehouse.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                          sit-change="vm.WarehouseChange">{{'Siemens.SimaticIT.MaterialApp.MMSaleDomestic.SaleDomesticedit.Tips_5'|translate}}</sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.typeLocation.value" sit-validation="{required: true}"
                          sit-options="vm.typeLocation.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'">
                {{'Siemens.SimaticIT.MaterialApp.MMSaleDomestic.SaleDomesticedit.Tips_6'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.PieceQty" sit-validation="{required: true, min: 0}"
                          sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.MMSaleDomestic.SaleDomesticedit.Tips_7'|translate}}</sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.BoxQty" sit-validation="{required: true, min: 0}"
                          sit-read-only="false" sit-change="vm.BoxQtyChange">{{'Siemens.SimaticIT.MaterialApp.MMSaleDomestic.SaleDomesticedit.Tips_8'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                          sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.MMSaleDomestic.SaleDomesticedit.Tips_9'|translate}}</sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>
