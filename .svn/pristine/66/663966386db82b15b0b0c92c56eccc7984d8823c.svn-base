<style>
    .MainCommandActionButton {
        margin-top: 20px !important;
    }
</style>
<div id="itemlist" class="content-area content-area-relative" style="height: calc(93% - 30px) !important">
    <!--查询条件与功能按钮-->
    <div class="col-md-40" style="margin-left: 15px;height: calc(16% - 5px) !important">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit"
                               sit-columns="8">
                <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value"
                              sit-options="vm.typeFactory.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'">
                    {{'Siemens.SimaticIT.PlanApp.OrderMaterial.Tips_1'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.ProductOrder" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.PlanApp.OrderMaterial.Tips_2'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.MaterialName" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.PlanApp.OrderMaterial.Tips_3'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.Spec" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.PlanApp.OrderMaterial.Tips_4'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.Customer" sit-read-only="false"
                              style="max-width:300px;">客户{{'Siemens.SimaticIT.PlanApp.OrderMaterial.Tips_4'|translate}}</sit-property>

                <sit-property sit-widget="sit-select" sit-value="vm.typeOrderStatus.value"
                              sit-validation="{required: false}" sit-options="vm.typeOrderStatus.options"
                              sit-to-display="'ItemName'" sit-to-keep="'ItemValue'" style="max-width:100px;">{{'Siemens.SimaticIT.PlanApp.OrderMaterial.Tips_6'|translate}}</sit-property>

                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                                 :sit-tooltip="{{'Siemens.SimaticIT.PlanApp.OrderMaterial.Tips_7'|translate}}" ng-click="vm.searchButtonHandler" :sit-label="{{'Siemens.SimaticIT.PlanApp.OrderMaterial.Tips_7'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div>
    <!--右侧功能按钮-->
    <!--<sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">

        <sit-command sit-icon="fa-arrow-right" sit-name="com.siemens.customcommand.add" ng-click="vm.editConsume" :sit-tooltip="{{'Siemens.SimaticIT.PlanApp.OrderMaterial.Tips_8'|translate}}"
                     :sit-label="{{'Siemens.SimaticIT.PlanApp.OrderMaterial.Tips_8'|translate}}" ng-show="vm.isButtonVisible" sit-type="main"></sit-command>
        <sit-command sit-icon="fa-arrow-left " sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.PlanApp.OrderMaterial.Tips_9'|translate}}" ng-click="vm.editButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.PlanApp.OrderMaterial.Tips_9'|translate}}" ng-show="vm.isButtonVisible"></sit-command>

        <sit-command sit-icon="fa-building-o" sit-name="com.siemens.customcommand.add" ng-click="vm.addButtonHandler" :sit-tooltip="{{'Siemens.SimaticIT.PlanApp.OrderMaterial.Tips_10'|translate}}"
                     :sit-label="{{'Siemens.SimaticIT.PlanApp.OrderMaterial.Tips_10'|translate}}" ng-show="vm.isButtonVisible"></sit-command>
    </sit-command-bar>-->
    <!-- grid列表 -->
    <div id="listClass" style="width:100%; height: 95%; padding:0px 16px 0 16px; margin-top: 3px;">
        <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
             ui-grid-pagination class="uigrid"></div>
    </div>
</div>