<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()"
            class="btn side-panel-button">
        {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.add.Tips_1'|translate}}
    </button>
    <button ng-click="vm.save()" class="btn side-panel-button"
            ng-show="vm.validInputs">
        {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.add.Tips_2'|translate}}
    </button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2">
        <!-- TODO: Put here the properties of the entity managed by the service -->

        <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value" sit-validation="{required: true}"
                      sit-options="vm.typeFactory.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                      sit-read-only="false" sit-change="vm.typeFactoryChange">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.add.Tips_3'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-select" sit-value="vm.typeProcess.value" sit-validation="{required: true}"
                      sit-options="vm.typeProcess.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                      sit-read-only="false">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.add.Tips_4'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-alp-text-picker" sit-value="vm.currentItem.MaterialCode"
                      sit-validation="{required: true}" ng-click="vm.materialClick()" sit-read-only="false">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.add.Tips_5'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialName" sit-validation="{required: true}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.add.Tips_6'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.SmallClassName" sit-validation="{required: true}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.add.Tips_7'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Spec" sit-validation="{required: true}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.add.Tips_8'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.PlanQty" sit-validation="{required: true}"
                      sit-read-only="false">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.add.Tips_9'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.UnitName"
                      sit-validation="{required: true}" sit-read-only="true">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.add.Tips_13'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProcessRouteName"
                      sit-validation="{required: true}" sit-read-only="true">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.add.Tips_10'|translate}}
        </sit-property>

        <!-- <sit-property sit-widget="sit-select" sit-value="vm.typeProcessOperation.value" sit-validation="{required: false}" sit-options="vm.typeProcessOperation.options"
              sit-to-display="'ProcessName'" sit-to-keep="'ProcessCode'" sit-read-only="false" sit-change="vm.processOperationChange">{{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.add.Tips_10'|translate}}</sit-property> -->

        <sit-property sit-widget="sit-select" sit-value="vm.typeBom.value" sit-validation="{required: true}"
                      sit-options="vm.typeBom.options" sit-to-display="'BOMCode'" sit-to-keep="'Id'" sit-read-only="false">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.add.Tips_11'|translate}}

        </sit-property>

        <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                      sit-read-only="false">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.add.Tips_12'|translate}}
        </sit-property>

    </sit-property-grid>
</div>