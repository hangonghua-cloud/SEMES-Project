<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManageedit.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManageedit.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="1" style="margin-left: 4px;">
            <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value" sit-validation="{required: false}" sit-options="vm.typeFactory.options"
                          sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="true" sit-change="vm.typeFactoryChange" sit-validation="{required: true}">{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManageedit.Tips_3'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.FactoryCode" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManageedit.Tips_4'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.TraitCode" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManageedit.Tips_5'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.TraitName" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManageedit.Tips_6'|translate}}</sit-property>
            <sit-property sit-widget="sit-radio" sit-value="vm.IsEnabled.value" sit-options="vm.IsEnabled.options"
                          sit-change="" sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManageedit.Tips_7'|translate}}</sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>
