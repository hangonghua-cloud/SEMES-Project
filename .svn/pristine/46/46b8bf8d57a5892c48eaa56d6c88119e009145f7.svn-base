<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.QualityApp.QC_IQCQualityCheckList.QC_IQCQualityCheckListedit.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.QualityApp.QC_IQCQualityCheckList.QC_IQCQualityCheckListedit.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="1" style="margin-left: 4px;">
            <!--<sit-property sit-widget="sit-text" sit-value="vm.currentItem.ReceivingNotificationLineNumber" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.QualityApp.QC_IQCQualityCheckList.QC_IQCQualityCheckListedit.Tips_3'|translate}}</sit-property>-->
            <sit-property sit-widget="sit-alp-text-picker"
                          sit-read-only="true"
                          sit-validation="{required: true}"
                          sit-value="vm.currentItem.ReceivingNotificationLineNumber"
                          ng-click="vm.SelectReceivingModal()">
                          {{'Siemens.SimaticIT.QualityApp.QC_IQCQualityCheckList.QC_IQCQualityCheckListedit.Tips_3'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.TestListNumber" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.QualityApp.QC_IQCQualityCheckList.QC_IQCQualityCheckListedit.Tips_4'|translate}}</sit-property>
            <sit-property sit-widget="sit-select"
                          sit-read-only="false" style="max-width:300px;"
                          sit-options="vm.MaterialCheckClassConfig.options"
                          sit-to-keep="'ItemValue'" sit-validation="{required: true}"
                          sit-value="vm.MaterialCheckClassConfig.selectedOption"
                          sit-to-display="'ItemName'">
                {{'Siemens.SimaticIT.QualityApp.QC_IQCQualityCheckList.QC_IQCQualityCheckListedit.Tips_5'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialCode" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.QualityApp.QC_IQCQualityCheckList.QC_IQCQualityCheckListedit.Tips_6'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialName" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.QualityApp.QC_IQCQualityCheckList.QC_IQCQualityCheckListedit.Tips_7'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.SupplierCode" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.QualityApp.QC_IQCQualityCheckList.QC_IQCQualityCheckListedit.Tips_8'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.SupplierName" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.QualityApp.QC_IQCQualityCheckList.QC_IQCQualityCheckListedit.Tips_9'|translate}}</sit-property>
            <!--<sit-property sit-widget="sit-alp-text-picker"
                          sit-read-only="true"
                          sit-validation="{required: true}"
                          sit-value="vm.currentItem.MaterialName"
                          ng-click="vm.SelectMaterialModal()">
                {{'Siemens.SimaticIT.QualityApp.QC_IQCQualityCheckList.QC_IQCQualityCheckListedit.Tips_7'|translate}}
            </sit-property>-->
            <sit-property sit-widget="sit-select"
                          sit-read-only="false" style="max-width:300px;"
                          sit-options="vm.MaterialClassConfig.options"
                          sit-to-keep="'ItemValue'" sit-validation="{required: true}"
                          sit-value="vm.MaterialClassConfig.selectedOption"
                          sit-change="vm.selectClass"
                          sit-to-display="'ItemName'">
                {{'Siemens.SimaticIT.QualityApp.QC_IQCQualityCheckList.QC_IQCQualityCheckListedit.Tips_10'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-select"
                          sit-read-only="false" style="max-width:300px;"
                          sit-options="vm.CheckMethoddConfig.options"
                          sit-to-keep="'Id'" sit-validation="{required: true}"
                          sit-value="vm.CheckMethoddConfig.selectedOption"
                          sit-to-display="'TestMethodName'">
                {{'Siemens.SimaticIT.QualityApp.QC_IQCQualityCheckList.QC_IQCQualityCheckListedit.Tips_11'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.ArriveNoticeQuantities" sit-validation="{required: true, min: 0}"
                          sit-read-only="false">{{'Siemens.SimaticIT.QualityApp.QC_IQCQualityCheckList.QC_IQCQualityCheckListedit.Tips_12'|translate}}</sit-property>
            <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                          sit-read-only="false">{{'Siemens.SimaticIT.QualityApp.QC_IQCQualityCheckList.QC_IQCQualityCheckListedit.Tips_13'|translate}}</sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>