using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;
using System.Threading.Tasks;

namespace Lib.Model.Dto
{
    [Serializable]
    public class QRCode
    {
        /// <summary>
        /// 条码类型
        /// </summary>
        public string Type { get; set; } = "QRCode";
        /// <summary>
        /// 条码
        /// </summary>
        public string Value { get; set; }
        /// <summary>
        /// 宽度
        /// </summary>
        public string Width { get; set; }
        /// <summary>
        /// 高度
        /// </summary>
        public string Height { get; set; }
    }
}
