<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()"
            class="btn side-panel-button">
        {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.edit.Tips_1'|translate}}
    </button>
    <button ng-click="vm.save()" class="btn side-panel-button"
            ng-show="vm.validInputs">
        {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.edit.Tips_2'|translate}}
    </button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2">
        <!-- TODO: Put here the properties of the entity managed by the service -->
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.WorkOrder" sit-validation="{required: true}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.edit.Tips_3'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value" sit-validation="{required: true}"
                      sit-options="vm.typeFactory.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                      sit-read-only="true" sit-change="vm.typeFactoryChange">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.edit.Tips_4'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-select" sit-value="vm.Process.value" sit-validation="{required: true}"
                      sit-options="vm.Process.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.edit.Tips_5'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialCode" sit-validation="{required: true}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.edit.Tips_6'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialName" sit-validation="{required: true}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.edit.Tips_7'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.SmallClassName" sit-validation="{required: true}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.edit.Tips_8'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Spec" sit-validation="{required: true}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.edit.Tips_9'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.PlanQty" sit-validation="{required: true}"
                      sit-read-only="false">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.edit.Tips_10'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.UnitName" sit-validation="{required: true}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.edit.Tips_14'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProcessRouteName"
                      sit-validation="{required: true}" sit-read-only="true">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.edit.Tips_11'|translate}}
        </sit-property>

        <!-- <sit-property sit-widget="sit-select" sit-value="vm.typeProcessOperation.value" sit-validation="{required: false}" sit-options="vm.typeProcessOperation.options"
                sit-to-display="'ProcessName'" sit-to-keep="'ProcessCode'" sit-read-only="false" sit-change="vm.processOperationChange">{{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.edit.Tips_11'|translate}}</sit-property> -->

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.BOMCode" sit-validation="{required: true}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.edit.Tips_12'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                      sit-read-only="false">
            {{'Siemens.SimaticIT.ProductionApp.OwnProductOrder.edit.Tips_13'|translate}}
        </sit-property>

    </sit-property-grid>
</div>