<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.ProductDatafile.ProductDatafileadd.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.MaterialApp.ProductDatafile.ProductDatafileadd.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="2">
        <!-- TODO: Put here the properties of the entity managed by the service -->
        <sit-property sit-widget="sit-datepicker" sit-value="vm.CreateTime" sit-format="'yyyy-MM-dd'" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.ProductDatafile.ProductDatafileadd.Tips_3'|translate}}</sit-property>
        <sit-property sit-widget="sit-datepicker" sit-value="vm.EndCreateTime" sit-format="'yyyy-MM-dd'" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.ProductDatafile.ProductDatafileadd.Tips_4'|translate}}</sit-property>
        <sit-property sit-widget="sit-alp-text-picker" sit-value="vm.currentItem.TableEntity" sit-validation="{required: true}"
                      sit-read-only="true" ng-click="vm.selectClick()">
            {{'Siemens.SimaticIT.MaterialApp.ProductDatafile.ProductDatafileadd.Tips_5'|translate}}
        </sit-property>
    </sit-property-grid>
</div>
