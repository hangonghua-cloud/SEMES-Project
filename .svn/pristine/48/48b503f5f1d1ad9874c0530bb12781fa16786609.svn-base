using System;
using System.Collections.Generic;
using System.Linq;
using System.Web;

namespace ALP.WebApi.Util
{
    /// <summary>
    /// 请求头参数键枚举
    /// </summary>
    public enum RequestHeaderKey
    {
        /// <summary>
        /// 用户主键ID
        /// </summary>
        UserCode,
        /// <summary>
        /// 用户名称
        /// </summary>
        UserName,
        /// <summary>
        /// 设备标识码
        /// </summary>
        UDID,
        /// <summary>
        /// 签名
        /// </summary>
        Sign,
        /// <summary>
        /// 终端类型
        /// </summary>
        TerminalType,
    }
}