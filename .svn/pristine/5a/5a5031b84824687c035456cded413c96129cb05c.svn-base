<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }

    .ui-grid-cell {
        overflow: inherit;
    }

    .multi-advanced-selection .dropdown,
    .multi-advanced-selection .dropup {
        min-width: 50px !important;
    }

    .canvas .property-area-container > div.content .side-panel-property-area-body {
        overflow-y: visible;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManageaddDetail.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManageaddDetail.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="1">
        <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2" style="margin-left: 4px;">

            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.TraitValue" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManageaddDetail.Tips_3'|translate}}</sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.Attr.value" sit-validation="{required: false}"
                          sit-options="vm.Attr.options" sit-to-display="'TempName'" sit-to-keep="'TempCode'"
                          sit-change="vm.AttrChange">{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManageaddDetail.Tips_4'|translate}}</sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>
<div id="itemlist"
     style="width:calc(100% - 2px); height: calc(100% - 200px);margin-top: 6px; padding:5px 16px 0 0px;clear: both; display: block;overflow-y: auto;">
    <div ui-grid="vm.gridOptionsItem" ui-grid-selection ui-grid-resize-columns ui-grid-auto-resize
         class="uigrid uigrid-edit gridItem"></div>
</div>