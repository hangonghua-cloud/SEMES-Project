<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.ProductionApp.PMOwnSemiProductOrder.add.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.ProductionApp.PMOwnSemiProductOrder.add.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2">
        <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value" sit-validation="{required: true}"
                      sit-options="vm.typeFactory.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                      sit-read-only="false" sit-change="vm.typeFactoryChange">{{'Siemens.SimaticIT.ProductionApp.PMOwnSemiProductOrder.add.Tips_3'|translate}}</sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.typeProcess.value" sit-validation="{required: true}"
                      sit-options="vm.typeProcess.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                      sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PMOwnSemiProductOrder.add.Tips_4'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductOrder" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PMOwnSemiProductOrder.add.Tips_5'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ContainerNO" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PMOwnSemiProductOrder.add.Tips_6'|translate}}</sit-property>
        <!-- <sit-property sit-widget="sit-text" sit-value="vm.currentItem.CustomerCode" sit-validation="{required: true}"
            sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PMOwnSemiProductOrder.add.Tips_7'|translate}}</sit-property> -->
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.CustomerName" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PMOwnSemiProductOrder.add.Tips_8'|translate}}</sit-property>
        <sit-property sit-widget="sit-alp-text-picker" sit-value="vm.currentItem.MaterialCode"
                      sit-validation="{required: true}" ng-click="vm.materialClick()" sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PMOwnSemiProductOrder.add.Tips_9'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialName" sit-validation="{required: false}"
                      sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PMOwnSemiProductOrder.add.Tips_10'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Spec" sit-validation="{required: false}"
                      sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PMOwnSemiProductOrder.add.Tips_11'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.UnitName" sit-validation="{required: false}"
                      sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PMOwnSemiProductOrder.add.Tips_12'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.ProductQty"
                      sit-validation="{required: true,min:0}" sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PMOwnSemiProductOrder.add.Tips_13'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.PalletNum"
                      sit-validation="{required: true,min:0}" sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PMOwnSemiProductOrder.add.Tips_14'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.VolumeNum"
                      sit-validation="{required: true,min:0}" sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PMOwnSemiProductOrder.add.Tips_15'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.Meters" sit-validation="{required: true,min:0}"
                      sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PMOwnSemiProductOrder.add.Tips_16'|translate}}</sit-property>
    </sit-property-grid>
</div>