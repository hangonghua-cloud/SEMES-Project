<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageTransfer.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageTransfer.Tips_2'|translate}}</button>

</div>

<sit-property-grid sit-id="add_form"
                   sit-layout="Horizontal"
                   sit-type="Fixed"
                   sit-mode="edit"
                   sit-columns="3">
    <sit-property sit-widget="sit-select" sit-value="vm.FactoryName.value" sit-validation="{required: true}" sit-options="vm.FactoryName.options"
                  sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-change="vm.typeFactoryChange">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageTransfer.Tips_3'|translate}}</sit-property>
    <sit-property sit-widget="sit-text" sit-value="vm.currentItem.FactoryCode" sit-validation="{required: true}"
                  sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageTransfer.Tips_4'|translate}}</sit-property>
    <sit-property sit-widget="sit-text" sit-value="vm.currentItem.WhsName" sit-validation="{required: true}"
                  sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageTransfer.Tips_5'|translate}}</sit-property>
    <sit-property sit-widget="sit-text" sit-value="vm.currentItem.LocationName" sit-validation="{required: true}"
                  sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageTransfer.Tips_6'|translate}}</sit-property>
    <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                  sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageTransfer.Tips_7'|translate}}</sit-property>
</sit-property-grid>
<div id="itemlist2"
     style="width:calc(100% - 2px); height: 60%;margin-top: 6px; padding:5px 16px 0 0px;clear: both; display: block;">
    <div ui-grid="vm.gridOptionsDetail" ui-grid-selection ui-grid-resize-columns ui-grid-auto-resize
         class="uigrid  gridItem"></div>
</div>
