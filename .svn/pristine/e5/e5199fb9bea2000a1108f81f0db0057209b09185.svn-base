                          sit-options="vm.TypeConfig.options" sit-to-keep="'ItemValue'" sit-validation="{required: true}"
                          sit-value="vm.TypeConfig.selectedOption" sit-change="vm.selectCodad" sit-to-display="'ItemName'">
                {{'Siemens.SimaticIT.QualityApp.QC_TestMethodMaintenance.QC_TestMethodMaintenanceedit.Tips_4'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.TestMethodCoading"
