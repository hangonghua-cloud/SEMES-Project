<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.MMSaleDomestic.SaleDomesticOutadd.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.MaterialApp.MMSaleDomestic.SaleDomesticOutadd.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2" style="margin-left: 4px;">
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.DocNum" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.MMSaleDomestic.SaleDomesticOutadd.Tips_3'|translate}}</sit-property>
            <sit-property sit-widget="sit-datepicker" sit-value="vm.currentItem.DeliveryDate" sit-validation="{required: true}"
                          sit-format="'yyyy-MM-dd'" sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.MMSaleDomestic.SaleDomesticOutadd.Tips_4'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.LicensePlate" sit-validation="{required: false}"
                          sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.MMSaleDomestic.SaleDomesticOutadd.Tips_5'|translate}}</sit-property>
            <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                          sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.MMSaleDomestic.SaleDomesticOutadd.Tips_6'|translate}}</sit-property>

        </sit-property-grid>
    </sit-property-grid>
</div>
