<!--人员-->
<style>
    .green {
        color: rgb(38, 228, 31)
    }

    .red {
        color: red
    }

    .MainCommandActionButton {
        margin-top: 20px !important;
    }
</style>
<div id="itemlist" class="content-area content-area-relative" style="height: calc(90% - 30px) !important">
    <div class="col-md-40" style="margin-left: 10px;">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit"
                               sit-columns="6">
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.Code" sit-read-only="false">
                    {{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_1'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.Name" sit-read-only="false">
                    {{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_2'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.DeptName" sit-read-only="false">
                    {{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_3'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-select" sit-read-only="false" sit-options="vm.typePositionSelect.options"
                              sit-validation="{required: false}" sit-to-keep="'ItemValue'"
                              sit-value="vm.typePositionSelect.selectedOption" sit-to-display="'ItemName'">{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_4'|translate}}</sit-property>

                <!-- <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value"
                    sit-validation="{required: false}" sit-options="vm.typeFactory.options"
                    sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="false">{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_5'|translate}}
                </sit-property> -->
                <sit-property sit-id="mySelect" sit-widget="sit-multi-select"
                              sit-selected-string="vm.multiSelectFactory.value" sit-options="vm.multiSelectFactory.options"
                              sit-split-list="'true'" sit-read-only="false">{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_5'|translate}}</sit-property>

                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                                 :sit-tooltip="{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_6'|translate}}" ng-click="vm.searchButtonHandler" :sit-label="{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_6'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
        <sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">

            <!--
            <sit-command sit-icon="fa fa-pencil-square-o" sit-type="main" sit-name="com.siemens.customcommand.search"
                :sit-tooltip="{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_7'|translate}}" ng-show="vm.isButtonVisible" ng-click="vm.printButtonHandler" :sit-label="{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_7'|translate}}"></sit-command>
            <sit-command sit-icon="fa fa-lock" sit-type="main" sit-name="com.siemens.customcommand.search"
            :sit-tooltip="{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_8'|translate}}" ng-show="vm.isButtonVisible" ng-click="vm.SetPermissions" :sit-label="{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_8'|translate}}"></sit-command>
            <sit-command sit-icon="fa fa-refresh" sit-type="main" sit-name="com.siemens.customcommand.search" :sit-tooltip="{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_9'|translate}}" ng-click="vm.doneButtonHandler"
                :sit-label="{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_9'|translate}}"></sit-command> -->
            <sit-command sit-icon="fa-trash " sit-type="main" sit-name="com.siemens.customcommand.search"
                         :sit-tooltip="{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_10'|translate}}" ng-click="vm.deleteButtonHandler" ng-show="vm.isButtonVisible" :sit-label="{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_10'|translate}}">
            </sit-command>
            <sit-command sit-icon="fa-pencil-square-o " sit-type="main" sit-name="com.siemens.customcommand.search"
                         :sit-tooltip="{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_11'|translate}}" ng-click="vm.editButtonHandler" ng-show="vm.isButtonVisible" :sit-label="{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_11'|translate}}">
            </sit-command>
            <sit-command sit-icon="fa-plus " sit-type="main" sit-name="com.siemens.customcommand.search"
                         :sit-tooltip="{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_12'|translate}}" ng-click="vm.addButtonHandler" ng-show="vm.is_addValueButtonHandler" :sit-label="{{'Siemens.SimaticIT.SystemApp.Persons.Personslist.Tips_12'|translate}}">
            </sit-command>
        </sit-command-bar>
    </div>
    <div id="listClass" style="width:100%; height: 100%; padding:0px 16px 0 16px; margin-top: 30px;">
        <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
             ui-grid-pagination class="uigrid"></div>
    </div>
</div>