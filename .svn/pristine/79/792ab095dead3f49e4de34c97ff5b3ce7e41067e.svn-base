<style>
    .canvas .property-area-container div.command-bar-side-panel {
        padding-bottom: 40px;
    }

    .canvas .property-area-container > div.content .side-panel-property-area-body {
        overflow: visible;
        flex: none;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.select.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button">{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.select.Tips_2'|translate}}</button>
    <button ng-click="vm.neglect()" ng-show="vm.validInputs" class="btn side-panel-button">{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.select.Tips_3'|translate}}</button>
</div>
<div class="side-panel-property-area-body" style="height: calc(8% - 0px) !important;">
    <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="6">
        <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value" sit-validation="{required: false}"
                      sit-options="vm.typeFactory.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                      sit-read-only="false" sit-change="vm.typeFactoryChagne">{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.select.Tips_4'|translate}}</sit-property>

        <sit-property sit-widget="sit-select" sit-value="vm.typeWorkShop.value" sit-validation="{required: false}"
                      sit-options="vm.typeWorkShop.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                      sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.select.Tips_5'|translate}}</sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.searchParams1.MaterialCode" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.select.Tips_6'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.searchParams1.Spec" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.select.Tips_7'|translate}}</sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.typeErrorReason.value" sit-validation="{required: false}"
                      sit-options="vm.typeErrorReason.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                      sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.select.Tips_8'|translate}}</sit-property>
        <sit-command-bar sit-type="action">
            <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                         :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.select.Tips_9'|translate}}" ng-click="vm.search" :sit-label="{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.select.Tips_9'|translate}}">
            </sit-command>
        </sit-command-bar>
    </sit-property-grid>
</div>
<div id="itemlist1"
     style="width:calc(100% - 2px); height: 40%;margin-top: 3px; padding:5px 16px 0 0px;clear: both; display: block;">
    <div ui-grid="vm.gridOptionsItem1" ui-grid-selection ui-grid-resize-columns ui-grid-auto-resize ui-grid-pagination
         class="uigrid  gridItem"></div>
</div>
<div id="itemlist2"
     style="width:calc(100% - 2px); height: 38%;margin-top: 6px; padding:5px 16px 0 0px;clear: both; display: block;">
    <div ui-grid="vm.gridOptionsItem2" ui-grid-selection ui-grid-resize-columns ui-grid-auto-resize
         class="uigrid  gridItem"></div>
</div>