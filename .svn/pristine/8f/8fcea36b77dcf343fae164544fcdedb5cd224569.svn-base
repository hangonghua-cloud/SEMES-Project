<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.ProductionApp.PrinterWorkOrderBG.edit.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.ProductionApp.PrinterWorkOrderBG.edit.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="1">
        <!-- TODO: Put here the properties of the entity managed by the service -->
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="3" style="margin-left: 4px;">
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.PrinterOrder" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterWorkOrderBG.edit.Tips_3'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.PlanOrder" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterWorkOrderBG.edit.Tips_4'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.WorkOrder" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterWorkOrderBG.edit.Tips_5'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialCode" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterWorkOrderBG.edit.Tips_6'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.DesignColour" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterWorkOrderBG.edit.Tips_7'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.BatchNo" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterWorkOrderBG.edit.Tips_8'|translate}}</sit-property>


            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProcessRoutName" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterWorkOrderBG.edit.Tips_9'|translate}}</sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.typeProcessOperation.value" sit-validation="{required: true}" sit-options="vm.typeProcessOperation.options"
                          sit-to-display="'OperationName'" sit-to-keep="'OperationCode'" sit-read-only="false" sit-change="vm.processChange">{{'Siemens.SimaticIT.ProductionApp.PrinterWorkOrderBG.edit.Tips_10'|translate}}</sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.typeUserGroup.value" sit-validation="{required: true}" sit-options="vm.typeUserGroup.options"
                          sit-to-display="'PTeamName'" sit-to-keep="'PTeamCode'">{{'Siemens.SimaticIT.ProductionApp.PrinterWorkOrderBG.edit.Tips_11'|translate}}</sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.MeterNum" sit-validation="{required: true, min: 0}"
                          sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterWorkOrderBG.edit.Tips_12'|translate}}</sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.ReelNum" sit-validation="{required: false, min: 0}"
                          sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterWorkOrderBG.edit.Tips_13'|translate}}</sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.WeightNum" sit-validation="{required: false, min: 0}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterWorkOrderBG.edit.Tips_14'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.WhiteBatchNo" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterWorkOrderBG.edit.Tips_15'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                          sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PrinterWorkOrderBG.edit.Tips_16'|translate}}</sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>
