<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.QualityApp.IPQCManage.TestMaintenanceaddProcess.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.QualityApp.IPQCManage.TestMaintenanceaddProcess.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form" sit-layout="Vertical" sit-type="Fluid" sit-mode="edit" sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="1"
                           style="margin-left: 4px;">
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.FactoryName" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.QualityApp.IPQCManage.TestMaintenanceaddProcess.Tips_3'|translate}}</sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.typeProcess.value" sit-validation="{required: true}"
                          sit-options="vm.typeProcess.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                          sit-read-only="false">{{'Siemens.SimaticIT.QualityApp.IPQCManage.TestMaintenanceaddProcess.Tips_4'|translate}}</sit-property>

        </sit-property-grid>
    </sit-property-grid>
</div>