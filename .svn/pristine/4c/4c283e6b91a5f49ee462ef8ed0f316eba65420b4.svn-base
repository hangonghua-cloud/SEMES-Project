<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }

    .canvas .property-area-container div.command-bar-side-panel {
        padding-bottom: 40px;
    }

    .canvas .property-area-container > div.content .side-panel-property-area-body {
        overflow: visible;
        flex: none;
    }

    /* .uigrid-edit .ui-grid-viewport {
          overflow: auto !important;
      }
    */
</style>

<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.QualityApp.QC_MaterialInventoryCheckList.QC_MaterialInventoryCheckListadd.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.QualityApp.QC_MaterialInventoryCheckList.QC_MaterialInventoryCheckListadd.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form1" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="5">
        <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value" sit-validation="{required: false}"
                      sit-options="vm.typeFactory.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                      sit-read-only="false" sit-change="vm.typeFactoryChange">{{'Siemens.SimaticIT.QualityApp.QC_MaterialInventoryCheckList.QC_MaterialInventoryCheckListadd.Tips_3'|translate}}</sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.typeWhsCode.value" sit-validation="{required: false}"
                      sit-options="vm.typeWhsCode.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                      sit-read-only="false">{{'Siemens.SimaticIT.QualityApp.QC_MaterialInventoryCheckList.QC_MaterialInventoryCheckListadd.Tips_4'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.searchParams.Material" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.QualityApp.QC_MaterialInventoryCheckList.QC_MaterialInventoryCheckListadd.Tips_5'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.searchParams.BatchNo" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.QualityApp.QC_MaterialInventoryCheckList.QC_MaterialInventoryCheckListadd.Tips_6'|translate}}</sit-property>

        <sit-command-bar sit-type="action">
            <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                         :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.QC_MaterialInventoryCheckList.QC_MaterialInventoryCheckListadd.Tips_7'|translate}}" ng-click="vm.searchButtonHandler" :sit-label="{{'Siemens.SimaticIT.QualityApp.QC_MaterialInventoryCheckList.QC_MaterialInventoryCheckListadd.Tips_7'|translate}}">
            </sit-command>
        </sit-command-bar>

    </sit-property-grid>
</div>
<div style="clear: both;"></div>
<div id="itemlist1"
     style="width:calc(100% - 2px); height: 30%;margin-top: 6px; padding:5px 16px 0px 0px;clear: both; display: block;">
    <div ui-grid="vm.gridOptionsItem1" ui-grid-selection ui-grid-resize-columns ui-grid-auto-resize
         class="uigrid  gridItem"></div>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="5">

        <sit-property sit-widget="sit-select" sit-value="vm.typeTestDepartment.value" sit-validation="{required: true}"
                      sit-options="vm.typeTestDepartment.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                      sit-read-only="false" sit-change="vm.testDepartmentChange">{{'Siemens.SimaticIT.QualityApp.QC_MaterialInventoryCheckList.QC_MaterialInventoryCheckListadd.Tips_8'|translate}}</sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.typeTestResult.value" sit-validation="{required: true}"
                      sit-options="vm.typeTestResult.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                      sit-read-only="false">{{'Siemens.SimaticIT.QualityApp.QC_MaterialInventoryCheckList.QC_MaterialInventoryCheckListadd.Tips_9'|translate}}</sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.typeIsFrozen.value" sit-validation="{required: true}"
                      sit-options="vm.typeIsFrozen.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                      sit-read-only="false">{{'Siemens.SimaticIT.QualityApp.QC_MaterialInventoryCheckList.QC_MaterialInventoryCheckListadd.Tips_10'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.QualityApp.QC_MaterialInventoryCheckList.QC_MaterialInventoryCheckListadd.Tips_11'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Address" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.QualityApp.QC_MaterialInventoryCheckList.QC_MaterialInventoryCheckListadd.Tips_12'|translate}}</sit-property>
    </sit-property-grid>
</div>
<div id="itemlist2"
     style="width:calc(100% - 2px); height: 32%;margin-top: 6px; padding:5px 16px 0 0px;clear: both; display: block;overflow: auto;">
    <div ui-grid="vm.gridOptionsItem2" ui-grid-selection ui-grid-resize-columns ui-grid-auto-resize
         class="uigrid uigrid-edit gridItem"></div>
</div>