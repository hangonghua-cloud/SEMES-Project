<style>
    .MainCommandActionButton {
        margin-top: 20px !important;
    }
</style>
<div id="itemlist" class="content-area content-area-relative" style="height: calc(23% - 30px) !important">
    <!--查询条件与功能按钮-->
    <div class="col-md-40" style="margin-left: 15px;">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit"
                               sit-columns="8">
                <sit-property sit-widget="sit-select" sit-value="vm.Factory.value" sit-validation="{required: false}"
                              sit-options="vm.Factory.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                              sit-read-only="false" sit-change="vm.FactoryChange">{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_1'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.ReworkOrder" sit-read-only="false"
                              style="max-width:100px;">{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_2'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.ProductOrder" sit-read-only="false"
                              style="max-width:100px;">{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_3'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.ContainerNO" sit-read-only="false"
                              style="max-width:100px;">{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_4'|translate}}</sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.ReworkStatus.value"
                              sit-validation="{required: false}" sit-options="vm.ReworkStatus.options" sit-to-display="'ItemName'"
                              sit-to-keep="'ItemValue'" style="max-width:100px;">{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_5'|translate}}</sit-property>

                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.MMXH" sit-read-only="false"
                              style="max-width:100px;">{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_6'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.Spec" sit-read-only="false"
                              style="max-width:100px;">{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_7'|translate}}</sit-property>

                <sit-property sit-widget="sit-select" sit-value="vm.CurrentProcess.value"
                              sit-validation="{required: false}" sit-options="vm.CurrentProcess.options"
                              sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="false">
                    {{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_8'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.DutyProcess.value"
                              sit-validation="{required: false}" sit-options="vm.DutyProcess.options"
                              sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="false">
                    {{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_9'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.ReworkProcess.value"
                              sit-validation="{required: false}" sit-options="vm.ReworkProcess.options"
                              sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="false">
                    {{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_10'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.ConfirmStatus.value"
                              sit-validation="{required: false}" sit-options="vm.ConfirmStatus.options"
                              sit-to-display="'ItemName'" sit-to-keep="'ItemValue'" style="max-width:100px;">
                    {{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_11'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.Operator" sit-read-only="false"
                              style="max-width:100px;">{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_12'|translate}}</sit-property>
                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                                 :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_13'|translate}}" ng-click="vm.searchButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_13'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div>
    <!--右侧功能按钮-->
    <sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">
        <sit-command sit-icon="fa-eye" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_14'|translate}}"
                     ng-click="vm.selectButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_14'|translate}}" ng-show="vm.isButtonVisible" sit-type="main">
        </sit-command>
        <sit-command sit-icon="fa-trash" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_15'|translate}}"
                     ng-click="vm.deleteButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_15'|translate}}" ng-show="vm.isReworkDel"></sit-command>
        <sit-command sit-icon="fa-pencil" sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_16'|translate}}"
                     ng-click="vm.editButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_16'|translate}}" ng-show="vm.isButtonVisible"></sit-command>
        <sit-command sit-icon="fa-check" sit-name="com.siemens.customcommand.check" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_17'|translate}}"
                     ng-click="vm.checkButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.ReworkRecord.Tips_17'|translate}}" ng-show="vm.isReworkQualityConfirm"></sit-command>
    </sit-command-bar>
</div>
<!-- grid列表 -->
<div id="listClass" style="width:100%; height: 40%; padding:0px 16px 0 16px; margin-top: 3px;">
    <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
         ui-grid-pagination class="uigrid"></div>
</div>
<!--子明细管理-->
<div class="row" style="width:100%; height: 40%; padding:0px 16px 0 16px; margin-top: 3px;">
    <div class="col-md-20">
        <div ui-grid="vm.gridOptionsDetail" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
             ui-grid-pagination class="uigrid"></div>
    </div>
    <div class="col-md-1"></div>
    <div class="col-md-19">
        <div ui-grid="vm.gridOptionsDetail2" ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
             ui-grid-pagination class="uigrid"></div>
    </div>
</div>