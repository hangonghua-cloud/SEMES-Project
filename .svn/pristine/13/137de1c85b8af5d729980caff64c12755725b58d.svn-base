<style>
    .MainCommandActionButton {
        margin-top: 20px !important;
    }
</style>

<div id="itemlist" class="content-area content-area-relative" style="height: calc(14% -30px)!important">
    <!--查询条件与功能按钮-->
    <div class="col-md-40" style="margin-left:15px;">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit"
                               sit-columns="8">
                <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value"
                              sit-options="vm.typeFactory.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                              sit-change="vm.typeFactoryChange">
                    {{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_1'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.typeWorkShop.value"
                              sit-options="vm.typeWorkShop.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                              sit-change="vm.typeWorkShopChange">
                    {{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_2'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.typeProcess.value"
                              sit-options="vm.typeProcess.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                              sit-change="vm.typeProcessChange">
                    {{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_3'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.typePost.value" sit-validation="{required: false}"
                              sit-options="vm.typePost.options" sit-to-display="'Col2'" sit-to-keep="'Col1'"
                              sit-read-only="false">
                    {{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_4'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.UserCode" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_5'|translate}}</sit-property>
                <!-- <sit-property sit-widget="sit-text" sit-value="vm.searchParams.UserName" sit-read-only="false"
                    style="max-width:300px;">{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_6'|translate}}</sit-property> -->
                <sit-property sit-widget="sit-datepicker" sit-value="vm.StartTime" sit-format="'yyyy-MM-dd'"
                              sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_7'|translate}}</sit-property>
                <sit-property sit-widget="sit-datepicker" sit-value="vm.EndTime" sit-format="'yyyy-MM-dd'"
                              sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_8'|translate}}</sit-property>
                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                                 :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_9'|translate}}" ng-click="vm.searchButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_9'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div>
    <!--右侧功能按钮-->
    <sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">
        <sit-command sit-icon="fa-eye" sit-name="com.siemens.customcommand.eye" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_10'|translate}}"
                     ng-click="vm.selectButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_10'|translate}}" ng-show="true"></sit-command>
        <sit-command sit-icon="fa-file-excel-o" sit-name="com.siemens.customcommand.export" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_11'|translate}}"
                     ng-click="vm.exportButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_11'|translate}}"></sit-command>
        <sit-command sit-icon="fa-upload" sit-name="com.siemens.customcommand.import" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_12'|translate}}"
                     ng-click="vm.importButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_12'|translate}}"></sit-command>
        <sit-command sit-icon="fa-plus" sit-name="com.siemens.customcommand.add" ng-click="vm.addButtonHandler"
                     :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_13'|translate}}" :sit-label="{{'Siemens.SimaticIT.ProductionApp.PMPerformanceManage.Tips_13'|translate}}"></sit-command>
    </sit-command-bar>
</div>
<!-- grid列表 -->
<div id="listClass" style="width:100%; height: 89%; padding:0px 16px 0 16px; margin-top: 2%;">
    <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
         ui-grid-pagination class="uigrid"></div>
</div>