<style>
    .MainCommandActionButton {
        margin-top: 20px !important;
    }
</style>

<div id="itemlist" class="content-area content-area-relative" style="height: calc(14% - 30px) !important">
    <!--查询条件与功能按钮-->
    <div class="col-md-40" style="margin-left: 15px;">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit"
                               sit-columns="8">
                <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value"
                              sit-validation="{required: false}" sit-options="vm.typeFactory.options"
                              sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="false"
                              sit-change="vm.typeFactoryChange">{{'Siemens.SimaticIT.ProductionApp.PMPostCoefficient.Tips_1'|translate}}</sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.typeProcess.value"
                              sit-validation="{required: false}" sit-options="vm.typeProcess.options"
                              sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="false"
                              sit-change="vm.typeProcessChange">
                    {{'Siemens.SimaticIT.ProductionApp.PMPostCoefficient.Tips_2'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.typePost.value" sit-validation="{required: false}"
                              sit-options="vm.typePost.options" sit-to-display="'Col2'" sit-to-keep="'Col1'"
                              sit-read-only="false">
                    {{'Siemens.SimaticIT.ProductionApp.PMPostCoefficient.Tips_3'|translate}}
                </sit-property>

                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                                 :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.PMPostCoefficient.Tips_4'|translate}}" ng-click="vm.searchButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.PMPostCoefficient.Tips_4'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div>
    <!--右侧功能按钮-->
    <sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">
        <sit-command sit-icon="fa-trash-o" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.PMPostCoefficient.Tips_5'|translate}}"
                     ng-click="vm.delete2ButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.PMPostCoefficient.Tips_5'|translate}}" ng-show="vm.isDetailButtonVisible"></sit-command>
        <sit-command sit-icon="fa-pencil-square-o" sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.PMPostCoefficient.Tips_6'|translate}}"
                     ng-click="vm.edit2ButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.PMPostCoefficient.Tips_6'|translate}}" ng-show="vm.isDetailButtonVisible"></sit-command>
        <sit-command sit-icon="fa-plus-square-o" sit-name="com.siemens.customcommand.add"
                     ng-click="vm.add2ButtonHandler" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.PMPostCoefficient.Tips_7'|translate}}" :sit-label="{{'Siemens.SimaticIT.ProductionApp.PMPostCoefficient.Tips_7'|translate}}" sit-type="main"
                     ng-show="vm.isButtonVisible"></sit-command>
    </sit-command-bar>
</div>
<!-- grid列表 -->
<div id="listClass" style="width:100%; height: 40%; padding:0px 16px 0 16px; margin-top: 3px;">
    <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
         ui-grid-pagination class="uigrid"></div>
</div>

<div id="listClass2" class="col-md-40" style="width:100%; height: 47%; padding:0px 16px 0 16px; margin-top:1%">
    <div ui-grid="vm.gridOptionsDetail" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
         ui-grid-pagination class="uigrid"></div>
</div>