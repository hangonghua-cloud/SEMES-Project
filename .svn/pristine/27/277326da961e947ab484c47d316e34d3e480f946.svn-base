<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.QualityApp.QC_IPQCDetail.QC_IPQCDetaileditresult.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.QualityApp.QC_IPQCDetail.QC_IPQCDetaileditresult.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2" style="margin-left: 4px;">
            <!--<sit-property sit-widget="sit-alp-text-picker"
                    sit-read-only="false"
                    sit-validation="{required: true}"
                    sit-value="vm.currentResultItem.EquipmentTaskName"
                    ng-click="vm.SelectTaskModal()">
                    {{'Siemens.SimaticIT.QualityApp.QC_IPQCDetail.QC_IPQCDetaileditresult.Tips_3'|translate}}
            </sit-property>-->
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductionWorkshopName" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.QualityApp.QC_IPQCDetail.QC_IPQCDetaileditresult.Tips_4'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.TestMachineName" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.QualityApp.QC_IPQCDetail.QC_IPQCDetaileditresult.Tips_5'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.CalibrationMethodName" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.QualityApp.QC_IPQCDetail.QC_IPQCDetaileditresult.Tips_6'|translate}}</sit-property>
            <sit-property sit-widget="sit-alp-text-picker"
                          sit-read-only="true"
                          sit-validation="{required: true}"
                          sit-value="vm.currentItem.InspectorName" ng-show="vm.isSelPeopleButtonVisible"
                          ng-click="vm.SelectPeopleModal()">
                {{'Siemens.SimaticIT.QualityApp.QC_IPQCDetail.QC_IPQCDetaileditresult.Tips_7'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-datepicker" sit-value="vm.currentItem.InspectionTimeStr" sit-validation="{required: false}" ng-show="vm.isSelPeopleButtonVisible"
                          sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="">{{'Siemens.SimaticIT.QualityApp.QC_IPQCDetail.QC_IPQCDetaileditresult.Tips_8'|translate}}</sit-property>
        </sit-property-grid>
    </sit-property-grid>
    <div id="itemlist" style="width:calc(100% - 5px); height: calc(100% - 100px); margin-top:20px;margin-left:20px;padding-right:20px;overflow: auto;">
        <div ui-grid="vm.gridOptions" ui-grid-pagination ui-grid-pinning ui-grid-selection ui-grid-exporter ui-grid-resize-columns
             ui-grid-auto-resize class="uigrid uigrid-edit"></div>

    </div>
</div>
