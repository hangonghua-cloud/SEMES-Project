<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }

    /** mask **/
    .flyover .mask {
        top: 0;
        left: 0;
        position: fixed;
        width: 100%;
        height: 100%;
        opacity: 0.5;
        background: black;
        z-index: 1049;
    }

    .flyover .alert {
        left: 50%;
        top: 50%;
        position: fixed;
        z-index: 1050;
    }

    .property-grid-input-group > textarea {
        width: 101%;
        height: 120px;
    }

    .boxUploadTitle .uploadTitle {
        margin-left: 10px;
        font-size: 16px;
    }

    .boxUploadTitle .num {
        font-size: 12px;
        margin-left: 10px;
    }

    .boxUploadTitle a {
        margin-left: 10px;
        height: 30px;
        line-height: 30px;
        position: relative;
        cursor: pointer;
        overflow: hidden;
        display: inline-block;
    }

        .boxUploadTitle a input {
            position: absolute;
            left: 0;
            top: 0;
            opacity: 0;
        }

    .validator-control[disabled] {
        color: #666666;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2">
        <!-- <sit-property sit-widget="sit-text" sit-value="vm.currentItem.EquipCode" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_3'|translate}}</sit-property> -->
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.EquipName" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_4'|translate}}</sit-property>
        <sit-property sit-widget="sit-select" sit-read-only="false" sit-options="vm.StatusConfig.options"
                      sit-to-keep="'ItemValue'" sit-validation="{required: true}" sit-value="vm.StatusConfig.selectedOption"
                      sit-to-display="'ItemName'">
            {{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_5'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.EquipClass" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_6'|translate}}</sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.EquipSpec" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_7'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Manufacturer" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_8'|translate}}</sit-property>
        <sit-property sit-widget="sit-datepicker" sit-value="vm.ProducedDate" sit-format="'yyyy-MM-dd'"
                      sit-validation="{required: false}" sit-read-only="false">
            {{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_9'|translate}}
        </sit-property>
        <sit-property sit-widget="sit-datepicker" sit-value="vm.UserDate" sit-format="'yyyy-MM-dd'"
                      sit-validation="{required: false}" sit-read-only="false">
            {{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_10'|translate}}
        </sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_11'|translate}}</sit-property>

        <div class="row" style="margin-top: 10px;">
            <div style="margin-left: 3px">
            </div>
            <div class="col-md-39" style="margin-top: 1px">
                <div class="boxUploadTitle">
                    <span class="uploadTitle">{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_12'|translate}}</span>
                    <!-- Example: nv-file-select="" uploader="{Object}" options="{Object}" filters="{String}" .jpg,.png,.jpeg,.bmp,.gif,.doc,.docx,.xls,.xlsx,.ppt,.pptx,-->
                    <a href="javascript:void(0);" class="btn btn-primary">
                        <i class="ace-icon fa fa-plus"></i>
                        <input type="file" accept=".jpg,.png" nv-file-select="" uploader="uploader" multiple />{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_13'|translate}}
                    </a>
                    <span class="num">{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_14'|translate}}: {{ uploader.queue.length }}</span>
                </div>
                <table class="table">
                    <thead>
                        <tr>
                            <!-- <th>{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_15'|translate}}</th> -->
                            <th>{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_16'|translate}}</th>
                            <th ng-show="uploader.isHTML5">{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_17'|translate}}</th>
                            <th ng-show="uploader.isHTML5" nowrap>{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_18'|translate}}</th>
                            <th nowrap>{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_19'|translate}}</th>
                            <th>{{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_20'|translate}}</th>
                        </tr>
                    </thead>
                    <tbody>
                        <tr ng-repeat="item in uploader.queue">
                            <!-- <td> -->
                            <!-- Image preview -->
                            <!--auto height-->
                            <!--<div ng-thumb="{ file: item.file, width: 80 }"></div>-->
                            <!--auto width-->
                            <!-- <div ng-show="uploader.isHTML5" ng-thumb="{ file: item._file, height: 60 }"></div> -->
                            <!--fixed width and height -->
                            <!--<div ng-thumb="{ file: item.file, width: 80, height: 80 }"></div>-->
                            <!-- </td> -->
                            <td>
                                <strong>{{ item._file.name }}</strong>
                            </td>
                            <td ng-show="uploader.isHTML5" nowrap>{{ item.file.size/1024/1024|number:2 }} MB</td>
                            <td ng-show="uploader.isHTML5">
                                <div class="progress" style="margin-bottom: 0;">
                                    <div class="progress-bar" role="progressbar"
                                         ng-style="{ 'width': item.progress + '%' }"></div>
                                </div>
                            </td>
                            <td class="text-center">
                                <span ng-show="item.isSuccess"><i class="glyphicon glyphicon-ok"></i></span>
                                <span ng-show="item.isCancel"><i class="glyphicon glyphicon-ban-circle"></i></span>
                                <span ng-show="item.isError"><i class="glyphicon glyphicon-remove"></i></span>
                            </td>
                            <td nowrap>
                                <button type="button" class="btn btn-success btn-xs" ng-click="item.upload()"
                                        ng-disabled="item.isReady || item.isUploading || item.isSuccess">
                                    <span class="glyphicon glyphicon-upload"></span> {{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_21'|translate}}
                                </button>
                                <button type="button" class="btn btn-warning btn-xs" ng-click="item.cancel()"
                                        ng-disabled="!item.isUploading">
                                    <span class="glyphicon glyphicon-ban-circle"></span> {{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_1'|translate}}
                                </button>
                                <button type="button" class="btn btn-danger btn-xs" ng-click="item.remove()">
                                    <span class="glyphicon glyphicon-trash"></span> {{'Siemens.SimaticIT.EquipmentApp.EquipmentAccount.EquipmentAccountaddDetail.Tips_22'|translate}}
                                </button>
                            </td>
                        </tr>
                    </tbody>
                </table>

            </div>
        </div>
    </sit-property-grid>
</div>