<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMaintain.EP_EquipmentMaintaineditstandard.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMaintain.EP_EquipmentMaintaineditstandard.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="1" style="margin-left: 4px;">
            <sit-property sit-widget="sit-text" sit-value="vm.currentItemDetail.EquipmentMaintainId" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMaintain.EP_EquipmentMaintaineditstandard.Tips_3'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItemDetail.EquipmentMaintainName" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMaintain.EP_EquipmentMaintaineditstandard.Tips_4'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItemDetail.EquipmentMaintainStandard" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMaintain.EP_EquipmentMaintaineditstandard.Tips_5'|translate}}</sit-property>
            <sit-property sit-widget="sit-select"
                      sit-read-only="false"
                      sit-options="vm.DataTypeConfig.options"
                      sit-to-keep="'ItemValue'"
                      sit-change='vm.shopChagne' sit-validation="{required: true}"
                      sit-value="vm.DataTypeConfig.selectedOption"
                      sit-to-display="'ItemName'">
                {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMaintain.EP_EquipmentMaintaineditstandard.Tips_6'|translate}}
            </sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>
