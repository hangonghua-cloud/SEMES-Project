<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMaintainTask.EP_EquipmentMaintainTaskedit.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMaintainTask.EP_EquipmentMaintainTaskedit.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form" sit-layout="Vertical" sit-type="Fluid" sit-mode="edit" sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="1"
                           style="margin-left: 4px;">
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.FactoryName" sit-validation="{required: false}"
                          sit-read-only="true">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMaintainTask.EP_EquipmentMaintainTaskedit.Tips_3'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-read-only="true" sit-validation="{required: true}"
                          sit-value="vm.currentItem.EquipmentName">
                {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMaintainTask.EP_EquipmentMaintainTaskedit.Tips_4'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-select" sit-read-only="true" sit-options="vm.TaskConfig.options"
                          sit-to-keep="'EquipmentTaskId'" sit-validation="{required: true}"
                          sit-value="vm.TaskConfig.selectedOption" sit-to-display="'EquipmentTaskName'">
                {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMaintainTask.EP_EquipmentMaintainTaskedit.Tips_5'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-date-time-picker" sit-format="'yyyy-MM-dd hh:mm:ss a'"
                          sit-validation="{required: true}" sit-value="vm.currentItem.PlanDate" sit-read-only="false">
                {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentMaintainTask.EP_EquipmentMaintainTaskedit.Tips_6'|translate}}
            </sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>