<style>
    .header-filtered {
        color: blue;
    }

    .modal-content {
        width: 1000px;
    }
</style>
<div class="modal-header">
    <div class="command-bar-side-panel">
        <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.ProductionApp.OwnProduct.edit.Tips_1'|translate}}</button>
        <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.ProductionApp.OwnProduct.edit.Tips_2'|translate}}</button>
    </div>
</div>

<div class="modal-body" ui-i18n="{{vm.lang}}">
    <div class="col-xs-40 col-sm-40 col-md-40 col-lg-40" style="margin-bottom: 10px;padding: 0px;">
        <sit-property-grid sit-id="add_form"
                           sit-layout="Horizontal"
                           sit-type="Fixed"
                           sit-mode="edit"
                           sit-columns="3">
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialCode" sit-validation="{required: true}"
                          sit-read-only="false" sit-change="vm.materialChange">{{'Siemens.SimaticIT.ProductionApp.OwnProduct.edit.Tips_3'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialName" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.OwnProduct.edit.Tips_4'|translate}}</sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.MaterialClass.value" sit-validation="{required: true}" sit-options="vm.MaterialClass.options"
                          sit-to-display="'ItemName'" sit-to-keep="'ItemValue'" sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.OwnProduct.edit.Tips_5'|translate}}</sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.SmallClass.value" sit-validation="{required: true}" sit-options="vm.SmallClass.options"
                          sit-to-display="'ItemName'" sit-to-keep="'ItemValue'" sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.OwnProduct.edit.Tips_6'|translate}}</sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.TypeBom.value" sit-validation="{required: false}" sit-options="vm.TypeBom.options"
                          sit-to-display="'BOMCode'" sit-to-keep="'Id'">{{'Siemens.SimaticIT.ProductionApp.OwnProduct.edit.Tips_7'|translate}}</sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.Num"
                          sit-validation="{required: true, min: 0}" sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.OwnProduct.edit.Tips_8'|translate}}</sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.typeUnit.value" sit-validation="{required: true}" sit-options="vm.typeUnit.options"
                          sit-to-display="'ItemName'" sit-to-keep="'ItemValue'" sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.OwnProduct.edit.Tips_9'|translate}}</sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.Warehouse.value" sit-validation="{required: true}" sit-options="vm.Warehouse.options"
                          sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'">{{'Siemens.SimaticIT.ProductionApp.OwnProduct.edit.Tips_10'|translate}}</sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.Process.value" sit-validation="{required: true}" sit-options="vm.Process.options"
                          sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.OwnProduct.edit.Tips_11'|translate}}</sit-property>
        </sit-property-grid>
    </div>
</div>

