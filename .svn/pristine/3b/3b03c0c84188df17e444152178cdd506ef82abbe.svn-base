<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()"
            class="btn side-panel-button">
        {{'Siemens.SimaticIT.MaterialApp.ProductStock.ProductStockeditDetail.Tips_1'|translate}}
    </button>
    <button ng-click="vm.save()" class="btn side-panel-button"
            ng-show="vm.validInputs">
        {{'Siemens.SimaticIT.MaterialApp.ProductStock.ProductStockeditDetail.Tips_2'|translate}}
    </button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2"
                       style="margin-left: 4px;">

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductOrder" sit-validation="{required: true}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.MaterialApp.ProductStock.ProductStockeditDetail.Tips_3'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ContainerNO" sit-validation="{required: true}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.MaterialApp.ProductStock.ProductStockeditDetail.Tips_4'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialCode" sit-validation="{required: true}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.MaterialApp.ProductStock.ProductStockeditDetail.Tips_5'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MMXH" sit-validation="{required: true}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.MaterialApp.ProductStock.ProductStockeditDetail.Tips_6'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.WhsName" sit-validation="{required: true}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.MaterialApp.ProductStock.ProductStockeditDetail.Tips_7'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.LocationName" sit-validation="{required: true}"
                      sit-read-only="true">
            {{'Siemens.SimaticIT.MaterialApp.ProductStock.ProductStockeditDetail.Tips_8'|translate}}
        </sit-property>

        <!-- <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.PalletQty"
            sit-validation="{required: true, min: 0}" sit-read-only="true">
            {{'Siemens.SimaticIT.MaterialApp.ProductStock.ProductStockeditDetail.Tips_9'|translate}}</sit-property> -->
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.PieceQty"
                      sit-validation="{required: true, min: 0}" sit-read-only="true">
            库存片数
        </sit-property>

        <sit-property sit-widget="sit-alp-text-picker" sit-value="vm.currentItem.TargetProductOrder"
                      sit-validation="{required: true}" sit-read-only="false" ng-click="vm.selectOrderModal()">
            {{'Siemens.SimaticIT.MaterialApp.ProductStock.ProductStockeditDetail.Tips_10'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-alp-text-picker" sit-value="vm.currentItem.TargetContainerNO"
                      sit-validation="{required: true}" sit-read-only="false" ng-click="vm.selectContainerNOrModal()">
            目标{{'Siemens.SimaticIT.MaterialApp.ProductStock.ProductStockeditDetail.Tips_4'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-select" sit-value="vm.typeWarehouse.value" sit-validation="{required: true}"
                      sit-options="vm.typeWarehouse.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                      sit-change="vm.WarehouseChange">
            目标{{'Siemens.SimaticIT.MaterialApp.ProductStock.ProductStockeditDetail.Tips_7'|translate}}
        </sit-property>

        <sit-property sit-widget="sit-select" sit-value="vm.typeLocation.value" sit-validation="{required: true}"
                      sit-options="vm.typeLocation.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'">
            目标{{'Siemens.SimaticIT.MaterialApp.ProductStock.ProductStockeditDetail.Tips_8'|translate}}
        </sit-property>

        <!-- <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.TargetPalletQty"
            sit-validation="{required: true}" sit-read-only="false">
            {{'Siemens.SimaticIT.MaterialApp.ProductStock.ProductStockeditDetail.Tips_14'|translate}}</sit-property> -->
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.TargetPieceQty"
                      sit-validation="{required: true}" sit-read-only="false">
            目标片数
        </sit-property>

    </sit-property-grid>
</div>