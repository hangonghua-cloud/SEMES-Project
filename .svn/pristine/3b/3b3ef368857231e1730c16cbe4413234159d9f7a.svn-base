<!-- 生产报废记录 -->
<style>
    .MainCommandActionButton {
        margin-top: 20px !important;
    }

    .green {
        color: rgb(38, 228, 31)
    }

    .red {
        color: red
    }
</style>
<div id="itemlist" class="content-area content-area-relative" style="height: calc(93% - 30px) !important">
    <!--查询条件与功能按钮-->
    <div class="col-md-40" style="margin-left: 15px;">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit"
                               sit-columns="8">
                <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value"
                              sit-validation="{required: false}" sit-options="vm.typeFactory.options"
                              sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="false"
                              sit-change="vm.typeFactoryChange">
                    {{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_1'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.typeProcess.value"
                              sit-validation="{required: false}" sit-options="vm.typeProcess.options"
                              sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="false"
                              sit-change="vm.typeProcessChange">
                    {{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_2'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.ScrapCode" sit-read-only="false"
                              style="max-width:300px;">
                    {{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_3'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.typeScrapReason.value"
                              sit-validation="{required: false}" sit-options="vm.typeScrapReason.options"
                              sit-to-display="'ItemName'" sit-to-keep="'ItemValue'" sit-read-only="false">
                    {{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_4'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-datepicker" sit-value="vm.StartTime" sit-format="'yyyy-MM-dd'"
                              sit-read-only="false">
                    {{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_5'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-datepicker" sit-value="vm.EndTime" sit-format="'yyyy-MM-dd'"
                              sit-read-only="false">
                    {{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_6'|translate}}
                </sit-property>

                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                                 :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_7'|translate}}"
                                 ng-click="vm.searchButtonHandler"
                                 :sit-label="{{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_7'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div>
    <!--右侧功能按钮-->
    <sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">

        <sit-command sit-icon="fa-upload" sit-name="com.siemens.customcommand.import"
                     :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_12'|translate}}"
                     ng-click="vm.importShareButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_12'|translate}}"></sit-command>

        <sit-command sit-icon="fa-trash" sit-name="com.siemens.customcommand.delete"
                     :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_8'|translate}}"
                     ng-click="vm.deleteButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_8'|translate}}"
                     ng-show="vm.isButtonVisible"></sit-command>
        <sit-command sit-icon="fa-edit" sit-name="com.siemens.customcommand.edit"
                     :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_9'|translate}}"
                     ng-click="vm.editButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_9'|translate}}"
                     ng-show="vm.isButtonVisible"></sit-command>
        <sit-command sit-icon="fa-plus" sit-name="com.siemens.customcommand.add" ng-click="vm.addButtonHandler"
                     :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_10'|translate}}"
                     :sit-label="{{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_10'|translate}}" sit-type="main">
        </sit-command>
        <sit-command sit-icon="fa-upload" sit-name="com.siemens.customcommand.import"
                     :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_11'|translate}}"
                     ng-click="vm.importButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.ProductionApp.ScrapRecord.Tips_11'|translate}}"></sit-command>
    </sit-command-bar>
    <!-- grid列表 -->
    <div id="listClass" style="width:100%; height: 100%; padding:0px 16px 0 16px; margin-top: 30px;">
        <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
             ui-grid-pagination class="uigrid"></div>
    </div>
</div>