<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()"
            class="btn side-panel-button">
        {{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_1'|translate}}
    </button>
    <button ng-click="vm.save()" class="btn side-panel-button"
            ng-show="vm.validInputs">
        {{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_2'|translate}}
    </button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form" sit-layout="Vertical" sit-type="Fixed" sit-mode="edit" sit-columns="2">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="4"
                           style="margin-left: 4px;">
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.PurchaseOrder"
                          sit-validation="{required: true}" sit-read-only="true">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_3'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-select" sit-value="vm.typeOrderType.value" sit-validation="{required: true}"
                          sit-options="vm.typeOrderType.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                          sit-read-only="true">{{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_4'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductOrder"
                          sit-validation="{required: true}" sit-read-only="true">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_5'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-datepicker" sit-value="vm.currentItem.ProductDeliveryDate"
                          sit-validation="{required: true}"
                          sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="true">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_6'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialCode"
                          sit-validation="{required: true}" sit-read-only="true">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_7'|translate}}
            </sit-property>

            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialName"
                          sit-validation="{required: true}" sit-read-only="true">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_8'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Unit" sit-validation="{required: true}"
                          sit-read-only="true">{{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_9'|translate}}</sit-property>
            <!-- <sit-property sit-widget="sit-select" sit-value="vm.typeUnit.value" sit-validation="{required: true}"
                          sit-options="vm.typeUnit.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                          sit-read-only="true">{{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_9'|translate}}</sit-property> -->
            <!-- <sit-property sit-widget="sit-select" sit-value="vm.typeSupplier.value" sit-validation="{required: true}"
                          sit-options="vm.typeSupplier.options" sit-to-display="'SupplierName'" sit-to-keep="'SupplierCode'"
                          sit-read-only="false">{{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_10'|translate}}</sit-property> -->

            <sit-property sit-widget="sit-alp-text-picker" sit-value="vm.currentItem.Abbr"
                          sit-validation="{required: false}" sit-read-only="false" ng-click="vm.selectClick2()">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_10'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-alp-text-picker" sit-value="vm.currentItem.SupplierName2"
                          sit-validation="{required: false}" sit-read-only="false" ng-click="vm.supplierClick('2')">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.in.Tips_23'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-alp-text-picker" sit-value="vm.currentItem.SupplierName3"
                          sit-validation="{required: false}" sit-read-only="false" ng-click="vm.supplierClick('3')">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.in.Tips_24'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-alp-text-picker" sit-value="vm.currentItem.SupplierName4"
                          sit-validation="{required: false}" sit-read-only="false" ng-click="vm.supplierClick('4')">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.in.Tips_25'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-alp-text-picker" sit-value="vm.currentItem.SupplierName5"
                          sit-validation="{required: false}" sit-read-only="false" ng-click="vm.supplierClick('5')">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.in.Tips_26'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-alp-text-picker" sit-value="vm.currentItem.SupplierName6"
                          sit-validation="{required: false}" sit-read-only="false" ng-click="vm.supplierClick('6')">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.in.Tips_27'|translate}}
            </sit-property>


            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ContractNo" sit-validation="{required: false}"
                          sit-read-only="false">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_11'|translate}}
            </sit-property>

            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.InvoiceNo" sit-validation="{required: false}"
                          sit-read-only="false">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_12'|translate}}
            </sit-property>

            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.PurchaseNum"
                          sit-validation="{required: true, min: 0}" sit-read-only="false">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_13'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.OrderNum"
                          sit-validation="{required: true, min: 0}" sit-read-only="true">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_14'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-datepicker" sit-value="vm.currentItem.PurchaseDeliveryDate"
                          sit-validation="{required: true}"
                          sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="false">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_15'|translate}}
            </sit-property>
            <!-- <sit-property sit-widget="sit-select" sit-value="vm.typeArrivalStatus.value" sit-validation="{required: true}"
                          sit-options="vm.typeArrivalStatus.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                          sit-read-only="false">{{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_16'|translate}}</sit-property> -->

            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Coefficient"
                          sit-validation="{required: false}" sit-read-only="false">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_17'|translate}}
            </sit-property>

            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                          sit-read-only="false">
                {{'Siemens.SimaticIT.PlanApp.PurchaseManage.edit.Tips_18'|translate}}
            </sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>