
<style>
    .textarea-control-readonly {
        height: 150px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.select.Tips_1'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="view_form"
                       sit-layout="Horizontal"
                       sit-type="Fixed"
                       sit-mode="view"
                       sit-columns="2">
        <!-- TODO: Put here the properties of the entity managed by the service -->
        <sit-property sit-widget="sit-select" sit-value="vm.Factory.value" sit-validation="{required: true}" sit-options="vm.Factory.options"
                      sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="true" sit-change="vm.FactoryChange">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.select.Tips_2'|translate}}</sit-property>
        <sit-property sit-widget="sit-select" sit-value="vm.Process.value" sit-validation="{required: true}" sit-options="vm.Process.options"
                      sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.select.Tips_3'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.PrinterOrder" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.select.Tips_4'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.PlanOrder" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.select.Tips_5'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.MeterNum" sit-validation="{required: true, min: 0}"
                      sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.select.Tips_6'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.ReelNum" sit-validation="{required: true, min: 0}"
                      sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.select.Tips_7'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.PalletNum" sit-validation="{required: true, min: 0}"
                      sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.select.Tips_8'|translate}}</sit-property>

        <sit-property sit-widget="sit-datepicker" sit-value="vm.OrderDate" sit-validation="{required: true}"
                      sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.select.Tips_9'|translate}}</sit-property>
        <sit-property sit-widget="sit-datepicker" sit-value="vm.DeliveryDate" sit-validation="{required: true}"
                      sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.select.Tips_10'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.PalletNum1" sit-validation="{required: true, min: 0}"
                      sit-read-only="true" ng-show="false">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.select.Tips_8'|translate}}</sit-property>

        <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Packaging" sit-validation="{required: false}"
                      sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.select.Tips_11'|translate}}</sit-property>
        <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                      sit-read-only="true">{{'Siemens.SimaticIT.ProductionApp.PrinterOrder.select.Tips_12'|translate}}</sit-property>
    </sit-property-grid>
</div>
