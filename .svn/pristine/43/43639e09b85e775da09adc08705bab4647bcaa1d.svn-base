        /// <summary>
        /// 根据单据类型获取流水号 存储过程调用示例
        /// </summary>
        /// <param name="SeqCode">规则代码</param>
        /// <param name="returnNum">返回的流水号</param>
        /// <param name="messageCode">异常消息等</param>
        /// <returns></returns>
        public bool GetSerialNO(string SeqCode, out string returnNum, out string messageCode)
        {
            bool b = false;
            returnNum = "";
            messageCode = "";
            //调用存储过程
            SqlParameter[] parameters = {
                new SqlParameter("@SeqCode", SqlDbType.VarChar,60),
                new SqlParameter("@ReturnNum", SqlDbType.VarChar,40),
                new SqlParameter("@MessageCode", SqlDbType.VarChar,800)
            };
            parameters[0].Value = SeqCode;
            parameters[1].Direction = ParameterDirection.Output;
            parameters[2].Direction = ParameterDirection.Output;

            try
            {
                //执行存储过程
                Data.Dapper.SqlDatabase db2 = new Data.Dapper.SqlDatabase();
                db2.ExecuteProcedure("P_GetSerialNO", parameters);
                //返回参数值
                returnNum = parameters[1].Value.ToString();
                messageCode = parameters[2].Value.ToString();
                b = true;
            }
            catch (Exception ex)
            {
                messageCode = ex.Message;
            }
            return b;
        }

        /// <summary>
        /// 功能描述: 导出 列表到EXCEL 
        /// 创　　建: liyongguo
        /// 创建日期: 2021-07-26 14:57:01
        /// 任务编号: 供应商管理
        /// </summary>
        /// <param name="checkType">查询条件</param>
        /// <returns>链接地址</returns>
        public string GetList_export(string checkType, out string msg)
        {
            StringBuilder sql = new StringBuilder();
            sql.Append(@"SELECT 
                      [FactoryCode] as '工厂编码'
                      ,[ProcessCode] as '工艺编码'
                      ,[ProcessName] as '工艺名称'
                      ,[MaterialClass] as '物料分类'
                      ,[SmallClass] as ''
                      ,[Remark] as '备注'
                      ,[Creator] as '创建人'
                      ,[CreateTime] as '创建时间'
                      ,[ModifyBy] as '最后修改人'
                      ,[ModifyTime] as '最后修改时间'
                  FROM [dbo].[BS_Process] where 1 = 1 ");
            msg = "成功!";
            if (!checkType.IsEmpty())
            {
                //此处换上你的关键查询条件 也可以为空 查询全部
                sql.Append($@" and CreatedByCode = '{checkType}' ");
            }
            try
            {
                DataTable dt = this.BaseRepository().FindTable(sql.ToString());
                var virtualPath = "~/";
                var dirPath = "Upload/";
                string folder = DateTime.Now.ToString("yyyyMM") + "/";
                //文件全路径
                var fullDirPath = System.Web.HttpContext.Current.Server.MapPath(virtualPath + dirPath + folder);

                string sServerDir = fullDirPath;
                if (!Directory.Exists(sServerDir))
                {
                    Directory.CreateDirectory(sServerDir);
                }
                string saveFileName = "供应商管理_" + DateTime.Now.ToString("yyyy-MM-dd-HHmm") + ".xls";

                ExcelHelper Excel = new ExcelHelper();
                MemoryStream ms = Excel.DataTableToExcel("供应商管理", dt, true);
                //保存
                Excel.saveTofle(ms, System.IO.Path.Combine(sServerDir, saveFileName));
                Excel.Dispose();
                return $@"{dirPath}{folder}{saveFileName}";
            }
            catch (Exception ex)
            {
                msg = ex.Message;
                return null;
            }
        }

        #region 同步工单工艺路线
        public void WorkOrderProcessSync(string processCode)
        {
            //调用存储过程
            SqlParameter[] parameters = {
                    new SqlParameter("@processCode",SqlDbType.VarChar, 40)
            };
            parameters[0].Value = processCode;
            //执行存贮过程
            Data.Dapper.SqlDatabase db = new Data.Dapper.SqlDatabase();
            db.ExecuteProcedure("Pro_WorkOrderProcessSync", parameters);
        }
        #endregion

        #region SAP工艺路线同步
        public void SaveSAPBS_Process(List<SAPBS_Process> entity)
        {
            //开启事务进行数据的插入
            IDatabase db = DbFactory.UABase().BeginTrans();
            try
            {

                foreach (var item in entity)
                {
                    var sapProcessEntity = item.Process;
                    var sapOperationList = item.ProcessOfOperations;
                    //判断工艺路线数据是否重复
                    if (string.IsNullOrEmpty(sapProcessEntity.FactoryCode))
                    {
                        throw new Exception("工厂编码必须传");
                    }
                    if (string.IsNullOrEmpty(sapProcessEntity.FactoryName))
                    {
                        throw new Exception("工厂名称必须传");
                    }
                    if (string.IsNullOrEmpty(sapProcessEntity.ProcessCode))
                    {
                        throw new Exception("工艺路线编码必须传");
                    }
                    if (string.IsNullOrEmpty(sapProcessEntity.ProcessName))
                    {
                        throw new Exception("工艺路线名称必须传");
                    }
                    if (string.IsNullOrEmpty(sapProcessEntity.ProcessType))
                    {
                        throw new Exception("工艺路线类型必须传");
                    }
                    //判断工艺路线编码是否存在
                    var processEntity = Get_ExpressionEntity(t => t.FactoryCode == sapProcessEntity.FactoryCode && t.ProcessCode == sapProcessEntity.ProcessCode);
                    var processCode = "";
                    var factoryCode = "";
                    if (!sapProcessEntity.IsDeleted)
                    {
                        //判断工艺路线是否存在，存在就更新
                        if (processEntity == null)
                        {
                            processCode = sapProcessEntity.ProcessCode;
                            factoryCode = sapProcessEntity.FactoryCode;
                            sapProcessEntity.Id = Guid.NewGuid().ToString();
                            sapProcessEntity.CreateTime = DateTime.Now;
                            sapProcessEntity.Creator = "SAP";
                            db.Insert(sapProcessEntity);
                        }
                        else
                        {
                            processCode = processEntity.ProcessCode;
                            factoryCode = processEntity.FactoryCode;
                            processEntity.ProcessType = sapProcessEntity.ProcessType;
                            processEntity.IsDefault = sapProcessEntity.IsDefault;
                            processEntity.ModifyTime = DateTime.Now;
                            db.Update(processEntity);
                        }

                        foreach (var entitys in sapOperationList)
                        {
                            var processOfOperation = entitys.ProcessOfOperation;
                            var ProcessOfOperationsAttrs = entitys.ProcessOfOperationsAttrs;
                            //判断工艺路线数据
                            if (string.IsNullOrEmpty(processOfOperation.OperationCode))
                            {
                                throw new Exception("工序编码必须传");
                            }
                            if (string.IsNullOrEmpty(processOfOperation.OperationName))
                            {
                                throw new Exception("工序名称必须传");
                            }
                            if (processOfOperation.SN.IsEmpty())
                            {
                                throw new Exception("工序顺序必须传");
                            }
                            if (processOfOperation.CuringCycle.IsEmpty())
                            {
                                throw new Exception("养生周期必须传");
                            }
                            //判断工艺路线下工序是否存在

                            var operationEntity = new BS_ProcessOfOperations_Service().Get_ExpressionEntity(t => t.ProcessCode == processCode 
                                && t.FactoryCode == factoryCode && t.OperationCode == processOfOperation.OperationCode);
                            var Operationid = "";
                            if (operationEntity == null)
                            {
                                processOfOperation.ProcessCode = sapProcessEntity.ProcessCode;
                                processOfOperation.Id = Guid.NewGuid().ToString();
                                processOfOperation.CreateTime = DateTime.Now;
                                processOfOperation.FactoryCode = sapProcessEntity.FactoryCode;
                                processOfOperation.FactoryName = sapProcessEntity.FactoryName;
                                Operationid = processOfOperation.Id;
                                db.Insert(processOfOperation);
                            }
                            else
                            {
                                Operationid = operationEntity.Id;
                                operationEntity.OperationCode = processOfOperation.OperationCode;
                                operationEntity.SN = processOfOperation.SN.IsEmpty() ? operationEntity.SN : processOfOperation.SN;
                                operationEntity.CuringCycle = processOfOperation.CuringCycle.IsEmpty() ? operationEntity.CuringCycle : processOfOperation.CuringCycle;
                                operationEntity.ModifyTime = DateTime.Now;
                                db.Update(operationEntity);
                            }
                            //循环处理属性数据
                            foreach (var sapAttr in ProcessOfOperationsAttrs)
                            {
                                if (string.IsNullOrEmpty(sapAttr.AttrCode))
                                {
                                    throw new Exception("属性编码必须传");
                                }
                                if (string.IsNullOrEmpty(sapAttr.AttrName))
                                {
                                    throw new Exception("属性名称必须传");
                                }
                                if (string.IsNullOrEmpty(sapAttr.AttrTypeName))
                                {
                                    throw new Exception("属性类型必须传");
                                }
                                if (string.IsNullOrEmpty(sapAttr.AttrValue))
                                {
                                    throw new Exception("属性值必须传");
                                }
                                //判断工艺路线属性是否存在
                                var attrEntity = new BS_ProcessOfOperationsAttr_Service().GetEntity(t => t.OperationsId == Operationid && t.AttrCode == sapAttr.AttrCode);
                                if (attrEntity == null)
                                {
                                    sapAttr.SortCode = sapAttr.SortCode.IsEmpty() ? 100 : sapAttr.SortCode;
                                    sapAttr.OperationsId = Operationid;
                                    sapAttr.Create();
                                    sapAttr.CreateTime = DateTime.Now;
                                    db.Insert(sapAttr);
                                }
                                else
                                {
                                    attrEntity.SortCode = sapAttr.SortCode==null? 100: sapAttr.SortCode;
                                    attrEntity.AttrValue = sapAttr.AttrValue;
                                    attrEntity.AttrType = sapAttr.AttrType;
                                    attrEntity.AttrTypeName = sapAttr.AttrTypeName;
                                    db.Update(attrEntity);
                                }
                            }
                        }
                    }
                    else
                    {
                        //删除操作
                        if (processEntity == null)
                        {
                            throw new Exception("工艺路线不存在无法进行删除");
                        }
                        var DeOperations = new BS_ProcessOfOperations_Service().Get_ExpressionList(t => t.ProcessCode == processEntity.ProcessCode);
                        db.Delete(DeOperations);
                        db.Delete(processEntity);
                        //new BS_ProcessOfOperations_Service().RemoveForm(t => t.ProcessCode == ProcessEntity.ProcessCode);
                        //RemoveForm(ProcessEntity.Id, null);
                        //目前属性值暂时没有删除

                    }
                }
                db.Commit();
            }
            catch (Exception ex)
            {
                db.Rollback();
                throw;
            }
            finally
            {
                db.Close();
            }
        }
        #endregion
    }
}
