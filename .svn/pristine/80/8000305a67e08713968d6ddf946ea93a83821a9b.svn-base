				    margin-right: 8px;
				    display: inline-block;
				    vertical-align: middle;
				    float: left;
				}
				.light{
					font-weight: bold;
					font-size: $font-lg;
					color: $font-color-dark;
				}
				.r{
					text-align: right;
				}
				.row-title{
					font-size: $font-base;
					font-weight: normal;
					color: $font-color-light;
				}
				.row-amount{
					font-size: $font-base;
					font-weight: normal;
					color: $font-color-dark;
				}
				
				
				.gt{
					font-weight: 10;
				}
			}
		}
		
		
	}
	
	.Itemlable{
			// width: 120rpx;
			width: 120upx;
			text-align:justify;
			float:left;
			height: 28rpx;
			// width:0rpx;
			margin: 2rpx 0 5rpx 15rpx;
			font-size: 48upx;
			font-weight: 350;
			 color:black;
			
			span{
			     display:inline-block;
			     width:100%;
			   }
		}
		.Itemvalue{
			float:left;
			width: 80%;
			margin: 2rpx 0 5rpx 0;
			text-align: left;
			//height: 28rpx;
			font-size: 20rpx;
		//	font-weight: normal;
			color: #909399;
		}
		
		.clearView {
			clear:both;
		}
	
.bottom {
		display: flex;
		margin-top: 5px;
		padding: 0 10rpx;
		justify-content: space-between;
		align-items: center;
	
		.btn {
			line-height: 52rpx;
			width: 160rpx;
			border-radius: 26rpx;
			border: 2rpx solid $u-border-color;
			font-size: 26rpx;
			text-align: center;
			color: $u-type-info-dark;
		}
		.evaluate {
			color: #2696FF;
			border-color: #2696FF;
			
		}
	}
.viewpanel{
	margin: 3px 0px; 
	border-radius: 10px;
	font-size: $font-base;
	font-weight: normal;
	color: $font-color-light;
	//background-color:	#F9F9F9	;
}

.listitem{
	background-color: white; margin: 10rpx 20rpx; padding:0rpx 10rpx;    border-radius: 10px;
}

.s-rowP{ margin-top: 10px;margin-bottom: 5px;}
.additemx{
	padding:0px 10px;font-size: 20rpx;color: #909399;
}

.upseach{
	margin-top:10rpx;background-color:RGB(242,242,242);border-radius: 20px;
}
.upseach-seach{
	width:90%;float:left;
}
.upseach-ico-plan{
	width:10%;float:left;
}
.upseach-ico{
	width:55rpx;height:55rpx;
	margin:13rpx 35rpx 0 0;
	//margin-left: 20rpx;
}
.upseach-select{
	margin:18rpx 0 0 20rpx;
}
.bodybackcolor{
	background-color: #F9F9F9;
}

.newcheckbox{
	transform:scale(0.8);margin: 0px; padding: 0px; line-height: 10px; width: 30px;
}
.itemleftcheckbox{
	width: 40rpx; text-align: center;
}
.txtbutton-ok{
	color:ForestGreen;
	width:100rpx;
	height:40rpx;
	background-color:#7FFF00;
	font-size: 20rpx;
	padding: 5rpx 20rpx ;
	text-align: center;
	border-radius: 15px;
	font-weight:normal;
}.txtbutton-ng{
	color:white;
	
	width:100rpx;
	height:40rpx;
	background-color:#808080;
	font-size: 20rpx;
	padding: 5rpx 20rpx ;
	text-align: center;
	border-radius: 15px;
	font-weight:normal;
}

.inputlable{
	width: 100%; height: 50rpx;line-height: 40rpx;;
	padding-bottom: 40rpx;
	 position:relative;border-bottom: 1px solid #e8e8e8;
	  clear: both; background: transparent;
}

.u-form-item{
    padding:10upx 10upx !important;
	height: 80upx;
}
.u-form-item--left{
	flex:0 0 180upx !important;
	width: 300upx !important;
	font-size: 30upx;
}
.u-label,.uni-input-placeholder,.uni-input-input,.uni-textarea-placeholder,.u-picker-header,.u-select__header,.u-select__body__picker-view__item,.u-column-item{
	font-size: 30upx !important;
}

.submits,.return{
	margin-top:20upx;
	width: 48%;
	height: 80upx !important;
}

.return{
	margin-top:20upx;
	width: 48%;
	height: 80upx !important;
	background: #ccc !important;
}
.u-btn--primary{
	height: 80upx !important;
	line-height: 80upx !important;
}
.mescroll-body{
	width: 100% !important;
}
.u-border-bottom:after{
	border:0 !important;
}
.u-collapse-head{
	font-size: 26upx !important;
}
.u-checkbox__label{
	font-size: 28upx !important;
}
.box{
	.u-checkbox__label{
		font-size: 40upx !important;
	}
}
