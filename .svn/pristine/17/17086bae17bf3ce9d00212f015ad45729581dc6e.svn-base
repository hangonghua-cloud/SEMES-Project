<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.SystemApp.Persons.PersonsModifyPermissions.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.SystemApp.Persons.PersonsModifyPermissions.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="2">
        <!-- TODO: Put here the properties of the entity managed by the service -->
        <sit-property sit-widget="sit-select" sit-layout="horizontal" sit-value="vm.searchParams.isAllow.value" sit-options="vm.searchParams.isAllow.options"
            sit-to-display="'Name'" sit-to-keep="'ID'" sit-read-only="false">
            {{'Siemens.SimaticIT.SystemApp.Persons.PersonsModifyPermissions.Tips_3'|translate}}
        </sit-property>
        
    </sit-property-grid>
</div>
