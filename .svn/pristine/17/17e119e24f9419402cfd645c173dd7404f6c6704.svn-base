<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }

    .ui-grid-cell {
        overflow: inherit;
    }

    .multi-advanced-selection .dropdown,
    .multi-advanced-selection .dropup {
        min-width: 50px !important;
    }

    .canvas .property-area-container > div.content .side-panel-property-area-body {
        overflow-y: visible;
    }
</style>

<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.ProductionApp.ProductionFirstInspection.add.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button">{{'Siemens.SimaticIT.ProductionApp.ProductionFirstInspection.add.Tips_2'|translate}}</button>
</div>

<div id="itemlist"
     style="width:calc(100% - 2px); height: 80%;margin-top: 6px; padding:0px 2px 0px 0px;clear: both; display: block;overflow-y: auto;">
    <div ui-grid="vm.gridOptionsItem" ui-grid-selection ui-grid-resize-columns ui-grid-auto-resize
         class="uigrid uigrid-edit gridItem"></div>
</div>