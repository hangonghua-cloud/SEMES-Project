        <sit-command sit-icon="fa-trash" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_12'|translate}}" ng-click="vm.deleteButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_12'|translate}}" ng-show="vm.isButtonVisible"></sit-command>
        <sit-command sit-icon="fa-pencil" sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_13'|translate}}" ng-click="vm.editButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_13'|translate}}" ng-show="vm.isButtonVisible"></sit-command>
        <sit-command sit-icon="fa-plus" sit-name="com.siemens.customcommand.add" ng-click="vm.addButtonHandler" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_14'|translate}}"
                     :sit-label="{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_14'|translate}}" sit-type="main"></sit-command>
    </sit-command-bar> -->
    <!-- grid列表 -->
    <div id="listClass" style="width:100%; height: 46%; padding:0px 16px 0 16px; margin-top: 30px;">
        <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
             ui-grid-pagination class="uigrid"></div>
    </div>

    <!-- grid列表 -->
    <div id="listClass2" class="col-md-40" style="width:100%; height: 46%; padding:0px 16px 0 16px; margin-top: 3px;">
        <div ui-grid="vm.gridOptionsDetail" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
             ui-grid-pagination class="uigrid"></div>
    </div>
</div>