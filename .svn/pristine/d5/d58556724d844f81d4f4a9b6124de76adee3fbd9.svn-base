<style>
    .MainCommandActionButton {
        margin-top: 20px !important;
    }
</style>
<div id="itemlist" class="content-area content-area-relative" style="height: calc(93% - 30px) !important">
    <!--查询条件与功能按钮-->
    <div class="col-md-40" style="margin-left: 15px;height: calc(13%-30px) !important">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit"
                               sit-columns="8">
                <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value" sit-validation="{required: false}"
                              sit-options="vm.typeFactory.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                              sit-read-only="false" sit-change="vm.typeFactoryChange">{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_1'|translate}}</sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.Process.value" sit-validation="{required: false}"
                              sit-options="vm.Process.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'"
                              sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_2'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.ProductOrder" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_3'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.ContainerNO" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_4'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.MaterialCode" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_5'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.MMXH" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_6'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.Spec" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_7'|translate}}</sit-property>

                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                                 :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_8'|translate}}" ng-click="vm.searchButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_8'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div>
    <!--右侧功能按钮-->
    <!-- <sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">


        <sit-command sit-icon="fa-trash-o" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_9'|translate}}" ng-click="vm.delete2ButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_9'|translate}}" ng-show="vm.isDetailButtonVisible" sit-type="main"></sit-command>
        <sit-command sit-icon="fa-pencil-square-o " sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_10'|translate}}" ng-click="vm.edit2ButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_10'|translate}}" ng-show="vm.isDetailButtonVisible" sit-type="main"></sit-command>
        <sit-command sit-icon="fa-plus-square-o " sit-name="com.siemens.customcommand.add" ng-click="vm.add2ButtonHandler" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.RawMaterialReceive.Tips_11'|translate}}"
