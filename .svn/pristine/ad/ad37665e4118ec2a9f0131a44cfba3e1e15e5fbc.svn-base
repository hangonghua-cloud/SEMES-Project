<style>
    .MainCommandActionButton {
        margin-top: 20px !important;
    }

    .ui-grid-disable-selection {
        -moz-user-select: text;
        -webkit-user-select: text;
        -ms-user-select: text;
        user-select: text;
    }

    .green {
        color: rgb(38, 228, 31)
    }

    .red {
        color: red
    }
</style>
<div id="itemlist" class="content-area content-area-relative" style="height: calc(93% - 30px) !important">
    <!--查询条件与功能按钮-->
    <div class="col-md-40" style="margin-left: 15px;">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit"
                               sit-columns="8">
                <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value"
                              sit-options="vm.typeFactory.options" sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'">
                    {{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_1'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.InspectNo" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_2'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.ProductOrder" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_3'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.CustomerPO" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_4'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.ContainerNO" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_5'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.MaterialCode" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_6'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.Spec" sit-read-only="false"
                              style="max-width:300px;">{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_7'|translate}}</sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.typeCheckStatus.value"
                              sit-validation="{required: false}" sit-options="vm.typeCheckStatus.options"
                              sit-to-display="'ItemName'" sit-to-keep="'ItemValue'" style="max-width:100px;">{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_8'|translate}}</sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.typeCheckResult.value"
                              sit-validation="{required: false}" sit-options="vm.typeCheckResult.options"
                              sit-to-display="'ItemName'" sit-to-keep="'ItemValue'" style="max-width:100px;">{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_9'|translate}}</sit-property>
                <sit-property sit-widget="sit-datepicker" sit-value="vm.StartDate" sit-format="'yyyy-MM-dd'"
                              sit-read-only="false">{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_10'|translate}}</sit-property>
                <sit-property sit-widget="sit-datepicker" sit-value="vm.EndDate" sit-format="'yyyy-MM-dd'"
                              sit-read-only="false">{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_11'|translate}}</sit-property>
                <!-- <sit-property sit-widget="sit-datepicker"
                              sit-value="vm.CheckStartDate"
                              sit-format="'yyyy-MM-dd'"
                              sit-read-only="false">{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_10'|translate}}</sit-property>
                <sit-property sit-widget="sit-datepicker"
                              sit-value="vm.CheckEndDate"
                              sit-format="'yyyy-MM-dd'"
                              sit-read-only="false">{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_11'|translate}}</sit-property> -->
                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                                 :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_12'|translate}}" ng-click="vm.searchButtonHandler" :sit-label="{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_12'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div>
    <!--右侧功能按钮-->
    <sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">

        <!-- <sit-command sit-icon="fa-eye" sit-name="com.siemens.customcommand.select" :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_13'|translate}}" ng-click="vm.selectButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_13'|translate}}" ng-show="vm.isDetailButtonVisible"></sit-command>

        <sit-command sit-icon="fa-trash" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_14'|translate}}" ng-click="vm.deleteButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_14'|translate}}" ng-show="vm.isButtonVisible"></sit-command>
        <sit-command sit-icon="fa-edit" sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_15'|translate}}" ng-click="vm.editButtonHandler"
            :sit-label="{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_15'|translate}}" ng-show="vm.isButtonVisible"></sit-command> -->
        <sit-command sit-icon="fa-plus" sit-name="com.siemens.customcommand.add" ng-click="vm.addButtonHandler"
                     :sit-tooltip="{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_16'|translate}}" :sit-label="{{'Siemens.SimaticIT.QualityApp.OQCManage.OQCQualityChecklist.Tips_16'|translate}}" sit-type="main" ng-show="vm.isButtonVisible"></sit-command>

    </sit-command-bar>
    <!-- grid列表 -->
    <div id="listClass" style="width:100%; height: 43%; padding:0px 16px 0 16px; margin-top: 90px;">
        <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
             ui-grid-pagination class="uigrid"></div>
    </div>

    <!-- grid列表 -->
    <div id="listClass2" class="col-md-40" style="width:100%; height: 43%; padding:0px 16px 0 16px; margin-top: 3px;">
        <div ui-grid="vm.gridOptionsDetail" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
             ui-grid-pagination class="uigrid"></div>
    </div>
</div>