<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportGroupadd.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportGroupadd.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="1">
        <!-- TODO: Put here the properties of the entity managed by the service -->
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.GroupName" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportGroupadd.Tips_3'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.SortCode" sit-validation="{required: true, min: 0}"
                      sit-read-only="false">{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportGroupadd.Tips_4'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                      sit-read-only="false">{{'Siemens.SimaticIT.BaseDataApp.ReportManage.ReportGroupadd.Tips_5'|translate}}</sit-property>
    </sit-property-grid>
</div>
