<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentTool.EP_EquipmentTooledit.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentTool.EP_EquipmentTooledit.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form" sit-layout="Vertical" sit-type="Fluid" sit-mode="edit" sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="1"
                           style="margin-left: 4px;">
            <!-- <sit-property sit-widget="sit-select" sit-read-only="true" sit-options="vm.CodadConfig.options"
                sit-to-keep="'ResourceCode'" sit-validation="{required: true}" sit-value="vm.CodadConfig.selectedOption"
                sit-change="vm.selectCodad" sit-to-display="'ResourceName'">
                {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentTool.EP_EquipmentTooledit.Tips_3'|translate}}
            </sit-property> -->
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.FactoryName"
                          sit-validation="{required: false}" sit-read-only="true">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentTool.EP_EquipmentTooledit.Tips_4'|translate}}</sit-property>

            <sit-property sit-widget="sit-alp-text-picker" sit-read-only="false" sit-validation="{required: true}"
                          sit-value="vm.currentItem.LineName" ng-click="vm.SelectResourceModal()">
                {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentTool.EP_EquipmentTooledit.Tips_5'|translate}}
            </sit-property>

            <!--<sit-property sit-widget="sit-text" sit-value="vm.currentItem.ToolId" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentTool.EP_EquipmentTooledit.Tips_6'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ToolsName" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentTool.EP_EquipmentTooledit.Tips_7'|translate}}</sit-property>-->
            <sit-property sit-widget="sit-alp-text-picker" sit-read-only="false" sit-validation="{required: true}"
                          sit-value="vm.currentItem.ToolsName" ng-click="vm.SelectToolsModal()">
                {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentTool.EP_EquipmentTooledit.Tips_7'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.SpecificationsModels"
                          sit-validation="{required: false}" sit-read-only="true">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentTool.EP_EquipmentTooledit.Tips_8'|translate}}</sit-property>
            <!--<sit-property sit-widget="sit-text" sit-value="vm.currentItem.Manufacturer" sit-validation="{required: false}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentTool.EP_EquipmentTooledit.Tips_9'|translate}}</sit-property>-->
            <sit-property sit-widget="sit-datepicker" sit-value="vm.currentItem.DateOfReplaceStr"
                          sit-validation="{required: false}"
                          sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="false">
                {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentTool.EP_EquipmentTooledit.Tips_10'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-alp-text-picker" sit-read-only="false" sit-validation="{required: false}"
                          sit-value="vm.currentItem.PersonOfReplaceName" ng-click="vm.SelectPeopleModal()">
                {{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentTool.EP_EquipmentTooledit.Tips_11'|translate}}
            </sit-property>
            <sit-property sit-widget="sit-textarea" sit-value="vm.currentItem.Remark" sit-validation="{required: false}"
                          sit-read-only="false">{{'Siemens.SimaticIT.EquipmentApp.EP_EquipmentTool.EP_EquipmentTooledit.Tips_12'|translate}}</sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>