using System;
namespace ALP.Application.Entity.BaseManage
{
    /// <summary>
    /// [Base_Sequence]表数据实体类
    /// 描述:流水号管理
    /// 作者:liyonguo
    /// 创建时间:2021-12-29 14:48:28
    /// </summary>
    public class BaseSequenceEntity : BaseEntity
    {
        #region 表: Base_Sequence 实体类: BaseSequence

        /// <summary>
        /// 编码
        /// <summary>
        public string SeqCode { get; set; }

        /// <summary>
        /// 描述
        /// <summary>
        public string Desc { get; set; }

        /// <summary>
        /// 当前序列号
        /// <summary>
        public string NowSeqValue { get; set; }

        /// <summary>
        /// 
        /// <summary>
        public DateTime? CreateTime { get; set; }

        /// <summary>
        /// 
        /// <summary>
        public string DateMax { get; set; }

        /// <summary>
        /// 返回的序列号最大值
        /// <summary>
        public string MaxVlaue { get; set; }

        /// <summary>
        /// 
        /// <summary>
        public string CreateBy { get; set; }

        /// <summary>
        /// 返回的序列号长度
        /// <summary>
        public int? Length { get; set; }

        /// <summary>
        /// 
        /// <summary>
        public string Status { get; set; }

        /// <summary>
        /// 
        /// <summary>
        public string InitValue { get; set; }

        /// <summary>
        /// 归零方式 @ResetType=1 不归零 2 按日归零   3 按月归零   4按年归零 
        /// <summary>
        public string ResetType { get; set; }

        /// <summary>
        /// 
        /// <summary>
        public string IsRunning { get; set; }
        #endregion
  
    }
}

