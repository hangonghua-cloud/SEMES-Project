<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.SupProductStockTransfer.SupProductStockTransferedit.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.SupProductStockTransfer.SupProductStockTransferedit.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form"
                       sit-layout="Horizontal"
                       sit-type="Fixed"
                       sit-mode="edit"
                       sit-columns="2">
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.BusinessTypeName" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.SupProductStockTransfer.SupProductStockTransferedit.Tips_3'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProcessName" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.SupProductStockTransfer.SupProductStockTransferedit.Tips_4'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Spec" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.SupProductStockTransfer.SupProductStockTransferedit.Tips_5'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialCode" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.SupProductStockTransfer.SupProductStockTransferedit.Tips_6'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MMXH" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.SupProductStockTransfer.SupProductStockTransferedit.Tips_7'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.BatchNo" sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.SupProductStockTransfer.SupProductStockTransferedit.Tips_8'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.Qty" sit-validation="{required: true, min: 0}"
                      sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.SupProductStockTransfer.SupProductStockTransferedit.Tips_9'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProductOrder" sit-validation="{required: true}"
                      sit-read-only="false" ng-show="vm.currentItem.BusinessType=='2'">{{'Siemens.SimaticIT.MaterialApp.SupProductStockTransfer.SupProductStockTransferedit.Tips_10'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ContainerNO" sit-validation="{required: true}"
                      sit-read-only="false" ng-show="vm.currentItem.BusinessType=='2'">{{'Siemens.SimaticIT.MaterialApp.SupProductStockTransfer.SupProductStockTransferedit.Tips_11'|translate}}</sit-property>
    </sit-property-grid>
</div>
