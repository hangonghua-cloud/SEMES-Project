<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.QualityApp.QC_TestMethodItemMaintenance.QC_TestMethodItemMaintenanceedit.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button">{{'Siemens.SimaticIT.QualityApp.QC_TestMethodItemMaintenance.QC_TestMethodItemMaintenanceedit.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2" style="margin-left: 4px;">
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.TestMethodCoading" sit-validation="{required: true}"
                          sit-read-only="false">:</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.TestItemCoading" sit-validation="{required: true}"
                          sit-read-only="false">:</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.TestItemName" sit-validation="{required: true}"
                          sit-read-only="false">:</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.TestItemStandard" sit-validation="{required: true}"
                          sit-read-only="false">:</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.TestDeprtment" sit-validation="{required: true}"
                          sit-read-only="false">:</sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.UpperLimit" sit-validation="{required: true, min: 0}"
                          sit-read-only="false">:</sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.LowerLimit" sit-validation="{required: true, min: 0}"
                          sit-read-only="false">:</sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.DataType" sit-validation="{required: true, min: 0}"
                          sit-read-only="false">:</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.IsUsed" sit-validation="{required: true}"
                          sit-read-only="false">:</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.EnabledMark" sit-validation="{required: true}"
                          sit-read-only="false">:</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Creator" sit-validation="{required: true}"
                          sit-read-only="false">:</sit-property>
            <sit-property sit-widget="sit-datepicker" sit-value="vm.currentItem.CreateTime" sit-validation="{required: true}"
                          sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="false">:</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ModifyBy" sit-validation="{required: true}"
                          sit-read-only="false">:</sit-property>
            <sit-property sit-widget="sit-datepicker" sit-value="vm.currentItem.ModifyTime" sit-validation="{required: true}"
                          sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="false">:</sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>
