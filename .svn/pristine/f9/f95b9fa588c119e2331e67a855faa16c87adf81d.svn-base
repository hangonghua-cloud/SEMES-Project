<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.SystemApp.APPRole.APPRoleadd.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.SystemApp.APPRole.APPRoleadd.Tips_2'|translate}}</button>
</div>
<style>
    .selectBox .label-property-grid-control-readonly {
        display: block;
    }

    .lbl_text {
        font-size: 15px;
        line-height: 30px;
        padding-left: 2px;
    }

    .navbar {
        margin-bottom: 2px;
        padding: 0 6px 0 6px;
        /* border: 1px solid transparent; */
        border: none;
    }

    .navbar-default {
        /* background-color: #f8f8f8;*/
        border-color: #e7e7e7;
        background-color: transparent;
        /* border-color: transparent; */
    }

        .navbar-default .navbar-brand {
            height: 40px;
            color: #333;
            font-size: 16px;
        }

        .navbar-default .navbar-text {
            margin-top: 15px;
            margin-bottom: 10px;
        }

    a, a:link, a:hover, a:active, a:visited {
        text-decoration: none;
    }
</style>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form"
                       sit-layout="Vertical"
                       sit-type="Fluid"
                       sit-mode="edit"
                       sit-columns="2">
        <!-- TODO: Put here the properties of the entity managed by the service -->
        <sit-property sit-widget="sit-text"
                      sit-value="vm.currentItem.RoleCode"
                      sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.SystemApp.APPRole.APPRoleadd.Tips_3'|translate}}</sit-property>
        <sit-property sit-widget="sit-text"
                      sit-value="vm.currentItem.RoleName"
                      sit-validation="{required: true}"
                      sit-read-only="false">{{'Siemens.SimaticIT.SystemApp.APPRole.APPRoleadd.Tips_4'|translate}}</sit-property>
        <sit-property sit-widget="sit-checkbox"
                      sit-value="vm.EnabledMark"
                      sit-validation="{required: false}"
                      ng-show="true">
            {{'Siemens.SimaticIT.SystemApp.APPRole.APPRoleadd.Tips_5'|translate}}
        </sit-property>
    </sit-property-grid>
</div>
