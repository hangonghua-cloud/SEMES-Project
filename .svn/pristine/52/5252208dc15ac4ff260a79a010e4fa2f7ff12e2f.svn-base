<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageadd.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageadd.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2"
                       style="margin-left: 4px;">
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialCode" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageadd.Tips_3'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialName" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageadd.Tips_4'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Spec" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageadd.Tips_5'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.SmallClassName" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageadd.Tips_6'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.BatchNo" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageadd.Tips_7'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.SupplierName" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageadd.Tips_8'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.WhsName" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageadd.Tips_9'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.LocationName" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageadd.Tips_10'|translate}}</sit-property>
        <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Unit" sit-validation="{required: true}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageadd.Tips_11'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.Qty" sit-validation="{required: true, min: 0}"
                      sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageadd.Tips_12'|translate}}</sit-property>

        <sit-property sit-widget="sit-alp-text-picker" sit-value="vm.currentItem.TargetWhsName"
                      sit-validation="{required: true}" sit-read-only="false" ng-click="vm.selectClick1()">目标{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageadd.Tips_9'|translate}}</sit-property>

        <sit-property sit-widget="sit-alp-text-picker" sit-value="vm.currentItem.TargetLocationName"
                      sit-validation="{required: true}" sit-read-only="false" ng-click="vm.selectClick2()">目标{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageadd.Tips_10'|translate}}</sit-property>
        <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.TargetQty"
                      sit-validation="{required: true, min: 0}" sit-read-only="false">移库{{'Siemens.SimaticIT.MaterialApp.RawMaterialStock.RawMaterialStockManageadd.Tips_12'|translate}}</sit-property>
    </sit-property-grid>
</div>