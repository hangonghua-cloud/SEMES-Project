<style>
    .row {
        padding: 5px;
        margin-top: 10px;
    }
</style>
<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">{{'Siemens.SimaticIT.MaterialApp.SuperProductStock.SuperProductStockManageadjust.Tips_1'|translate}}</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">{{'Siemens.SimaticIT.MaterialApp.SuperProductStock.SuperProductStockManageadjust.Tips_2'|translate}}</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="edit_form" sit-layout="Vertical" sit-type="Fluid" sit-mode="edit" sit-columns="1">
        <sit-property-grid sit-id="view_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit" sit-columns="2"
                           style="margin-left: 4px;">
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.FactoryName"
                          sit-validation="{required: false}" sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.SuperProductStock.SuperProductStockManageadjust.Tips_3'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProcessName"
                          sit-validation="{required: false}" sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.SuperProductStock.SuperProductStockManageadjust.Tips_4'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MaterialCode"
                          sit-validation="{required: false}" sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.SuperProductStock.SuperProductStockManageadjust.Tips_5'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Spec" sit-validation="{required: false}"
                          sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.SuperProductStock.SuperProductStockManageadjust.Tips_6'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.MMXH" sit-validation="{required: false}"
                          sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.SuperProductStock.SuperProductStockManageadjust.Tips_7'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.BatchNo" sit-validation="{required: false}"
                          sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.SuperProductStock.SuperProductStockManageadjust.Tips_8'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.StockQty" sit-validation="{required: false}"
                          sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.SuperProductStock.SuperProductStockManageadjust.Tips_9'|translate}}</sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.LockedQty"
                          sit-validation="{required: false, min: 0}" sit-read-only="true">{{'Siemens.SimaticIT.MaterialApp.SuperProductStock.SuperProductStockManageadjust.Tips_10'|translate}}</sit-property>
            <sit-property sit-widget="sit-numeric" sit-value="vm.currentItem.AdjustQty"
                          sit-validation="{required: true, min: 0}" sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.SuperProductStock.SuperProductStockManageadjust.Tips_11'|translate}}</sit-property>
            <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Remark" sit-validation="{required: true}"
                          sit-read-only="false">{{'Siemens.SimaticIT.MaterialApp.SuperProductStock.SuperProductStockManageadjust.Tips_12'|translate}}</sit-property>
        </sit-property-grid>
    </sit-property-grid>
</div>