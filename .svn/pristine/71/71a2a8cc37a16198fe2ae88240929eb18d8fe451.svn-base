<div class="command-bar-side-panel">
    <button ng-click="vm.cancel()" class="btn side-panel-button">取消</button>
    <button ng-click="vm.save()" class="btn side-panel-button" ng-show="vm.validInputs">保存</button>
</div>
<div class="side-panel-property-area-body">
    <sit-property-grid sit-id="add_form" sit-layout="Vertical" sit-type="Fluid" sit-mode="edit" sit-columns="1">
        <sit-property sit-id="File" sit-widget="sit-file-uploader" sit-value="vm.file"
                      sit-validation="{ required: true }" sit-change="vm.changeFile"
                      sit-widget-attributes="{'accept':'.xls,.xlsx','sit-min-size': '1KB', 'sit-max-size': '10MB'}">
            (<a href="Siemens.SimaticIT.ProductionApp/resources/绩效管理导入模板.xls">下载导入模板</a>):
        </sit-property>
    </sit-property-grid>
    <div>
        <sit-tabset>
            <sit-tab heading="绩效管理信息">
                <div id="sittab1" style="overflow: hidden;overflow:auto;white-space: nowrap;height: 330px;"></div>
            </sit-tab>
        </sit-tabset>
    </div>
</div>