<style>
    .MainCommandActionButton {
        margin-top: 20px !important;
    }

    .green {
        color: rgb(38, 228, 31)
    }

    .red {
        color: red
    }
</style>
<div id="itemlist" class="content-area content-area-relative" style="height: calc(93% - 30px) !important">
    <!--查询条件与功能按钮-->
    <div class="col-md-40" style="margin-left: 15px;">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fixed" sit-mode="edit"
                               sit-columns="8">
                <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value"
                              sit-validation="{required: false}" sit-options="vm.typeFactory.options"
                              sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="false">
                    {{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_1'|translate}}
                </sit-property>
                <sit-property sit-widget="sit-select" sit-value="vm.typeWO.value" sit-validation="{required: false}"
                              sit-options="vm.typeWO.options" sit-to-display="'ItemName'" sit-to-keep="'ItemValue'"
                              style="max-width:100px;">{{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_2'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.WorkOrder" sit-read-only="false"
                              style="max-width:100px;">{{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_3'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.MaterialCode" sit-read-only="false"
                              style="max-width:100px;">{{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_4'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.MMXH" sit-read-only="false"
                              style="max-width:100px;">{{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_5'|translate}}</sit-property>
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.Spec" sit-read-only="false"
                              style="max-width:100px;">{{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_6'|translate}}</sit-property>
                <sit-property sit-widget="sit-datepicker" sit-value="vm.GiveTime" sit-format="'yyyy-MM-dd'"
                              sit-read-only="false">{{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_7'|translate}}</sit-property>

                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search"
                                 :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_8'|translate}}" ng-click="vm.searchButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_8'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div>
    <!--右侧功能按钮-->
    <sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">
        <sit-command sit-icon="fa-magic" sit-name="com.siemens.customcommand.publish" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_9'|translate}}"
                     ng-click="vm.publishButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_9'|translate}}" ng-show="vm.isButtonVisible"></sit-command>
        <sit-command sit-icon="fa-eye" sit-name="com.siemens.customcommand.eye" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_10'|translate}}"
                     ng-click="vm.selectButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_10'|translate}}" ng-show="vm.isButtonVisible"></sit-command>
        <sit-command sit-icon="fa-object-ungroup" sit-name="com.siemens.customcommand.ungroup" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_11'|translate}}"
                     ng-click="vm.unGroupBatchButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_11'|translate}}" ng-show="vm.isButtonVisible"></sit-command>
        <sit-command sit-icon="fa-object-group" sit-name="com.siemens.customcommand.group" :sit-tooltip="{{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_12'|translate}}"
                     ng-click="vm.groupBatchButtonHandler" :sit-label="{{'Siemens.SimaticIT.ProductionApp.WorkOrderBatch.Tips_12'|translate}}" ng-show="vm.isButtonVisible"></sit-command>

    </sit-command-bar>
    <!-- grid列表 -->
    <div id="listClass" style="width:100%; height: 100%; padding:0px 16px 0 16px; margin-top: 30px;">
        <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
             ui-grid-pagination class="uigrid"></div>
    </div>
</div>