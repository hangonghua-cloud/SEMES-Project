<style>
    .MainCommandActionButton {
        margin-top: 20px !important;
    }
</style>
<div id="itemlist" class="content-area content-area-relative" style="height: calc(93% - 30px) !important">
    <!--查询条件与功能按钮-->
    <div class="col-md-40" style="margin-left: 15px;">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fluid" sit-mode="edit" sit-columns="5">

                <sit-property sit-widget="sit-select" sit-value="vm.typeFactory.value" sit-validation="{required: false}" sit-options="vm.typeFactory.options"
                              sit-to-display="'ResourceName'" sit-to-keep="'ResourceCode'" sit-read-only="false" sit-change="vm.typeFactoryChange" sit-validation="{required: true}">{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_1'|translate}}</sit-property>
                <!-- <sit-property sit-widget="sit-text" sit-value="vm.searchParams.FactoryName" sit-read-only="false" style="max-width:300px;">{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_1'|translate}}</sit-property> -->
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams.TraitName" sit-read-only="false" style="max-width:300px;">{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_2'|translate}}</sit-property>
                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_3'|translate}}" ng-click="vm.searchButtonHandler" :sit-label="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_3'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div>
    <!--右侧功能按钮-->
    <sit-command-bar sit-vertical-autofixed="true" sit-type="Tool" :sit-label-align="right" sit-layout="vertical">
        <sit-command sit-icon="fa-pencil-square" sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_4'|translate}}" ng-click="vm.editArrtButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_4'|translate}}" ng-show="vm.isAttrButtonVisible" sit-type="main"></sit-command>
        <sit-command sit-icon="fa-minus-square" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_5'|translate}}" ng-click="vm.deleteArrtButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_5'|translate}}" ng-show="vm.isAttrButtonVisible" sit-type="main"></sit-command>
        <sit-command sit-icon="fa-plus-square" sit-name="com.siemens.customcommand.add" ng-click="vm.addArrtButtonHandler" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_6'|translate}}"
                     :sit-label="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_6'|translate}}" ng-show="vm.isDetailButtonVisible" sit-type="main"></sit-command>
        <sit-command svg-icon="common/icons/cmdImport24.svg" sit-name="com.siemens.customcommand.import" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_7'|translate}}" ng-click="vm.import2ButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_7'|translate}}" ng-show="vm.isButtonVisible" sit-type="main"></sit-command>
        <sit-command sit-icon="fa-pencil-square-o" sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_8'|translate}}" ng-click="vm.edit2ButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_8'|translate}}" ng-show="vm.isDetailButtonVisible" sit-type="main"></sit-command>
        <sit-command sit-icon="fa-trash-o" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_9'|translate}}" ng-click="vm.delete2ButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_9'|translate}}" ng-show="vm.isDetailButtonVisible" sit-type="main"></sit-command>

        <sit-command sit-icon="fa-plus-square-o" sit-name="com.siemens.customcommand.add" ng-click="vm.add2ButtonHandler" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_10'|translate}}"
                     :sit-label="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_10'|translate}}" ng-show="vm.isButtonVisible" sit-type="main"></sit-command>

        <sit-command sit-icon="fa-trash" sit-name="com.siemens.customcommand.delete" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_11'|translate}}" ng-click="vm.deleteButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_11'|translate}}" ng-show="vm.isButtonVisible"></sit-command>
        <sit-command sit-icon="fa-edit" sit-name="com.siemens.customcommand.edit" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_12'|translate}}" ng-click="vm.editButtonHandler"
                     :sit-label="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_12'|translate}}" ng-show="vm.isButtonVisible"></sit-command>
        <sit-command sit-icon="fa-plus" sit-name="com.siemens.customcommand.add" ng-click="vm.addButtonHandler" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_13'|translate}}"
                     :sit-label="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_13'|translate}}" sit-type="main"></sit-command>


    </sit-command-bar>
    <!-- grid列表 -->
    <div id="listClass" style="width:100%; height: 47%; padding:0px 16px 0 16px; margin-top: 3px;">
        <div ui-grid="vm.gridOptions" ui-grid-pinning ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection ui-grid-pagination class="uigrid"></div>
    </div>
    <!--子明细管理-->
    <!--查询条件与功能按钮-->
    <!-- <div class="col-md-40" style="margin-left: 10px;">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fluid" sit-mode="edit" sit-columns="5">
                <sit-command-bar sit-type="action">

                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div> -->
    <!-- grid列表 -->
    <div class="col-md-40" style="margin-left: 15px;">
        <div class="side-panel-property-area-body">
            <sit-property-grid sit-id="add_form" sit-layout="Horizontal" sit-type="Fluid" sit-mode="edit" sit-columns="3">
                <!-- <sit-property sit-widget="sit-text" sit-value="vm.searchParams.FactoryName" sit-read-only="false" style="max-width:300px;">{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_1'|translate}}</sit-property> -->
                <sit-property sit-widget="sit-text" sit-value="vm.searchParams2.TraitValue" sit-read-only="false" style="max-width:300px;">{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_14'|translate}}</sit-property>
                <sit-command-bar sit-type="action">
                    <sit-command sit-icon="fa-search" sit-type="main" sit-name="com.siemens.customcommand.search" :sit-tooltip="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_3'|translate}}" ng-click="vm.detailsearchButtonHandler" :sit-label="{{'Siemens.SimaticIT.MaterialApp.BSTraitManage.BSTraitManagelist.Tips_3'|translate}}">
                    </sit-command>
                </sit-command-bar>
            </sit-property-grid>
        </div>
    </div>
    <div id="listClass2" class="row" style="width:100%; height: 46%; padding:0px 16px 0 16px; margin-top: 3px;">
        <div class="col-md-20">
            <div ui-grid="vm.gridOptionsDetail" ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
                 ui-grid-pagination class="uigrid">
            </div>
        </div>
        <div class="col-md-1"></div>
        <div class="col-md-19">
            <div ui-grid="vm.gridOptionsAttr" ui-grid-auto-resize ui-grid-resize-columns ui-grid-selection
                 ui-grid-pagination class="uigrid"></div>
        </div>
    </div>
</div>
