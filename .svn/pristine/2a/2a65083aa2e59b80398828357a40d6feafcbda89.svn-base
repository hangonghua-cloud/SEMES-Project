<style>
     .row {
         padding: 5px;
         margin-top: 10px;
     }
</style>
<div class="command-bar-side-panel">
     <button ng-click="vm.cancel()" class="btn side-panel-button">取消</button>
</div>
<div class="side-panel-property-area-body">
     <sit-property-grid sit-id="view_form"
         sit-layout="Horizontal"
         sit-type="Fixed"
         sit-mode="edit"
         sit-columns="1">
     <sit-property sit-widget="sit-text" sit-value="vm.currentItem.FactoryCode" 
         sit-validation="{required: true}" sit-read-only="true">工厂编码:</sit-property>
     <sit-property sit-widget="sit-text" sit-value="vm.currentItem.FactoryName" 
         sit-validation="{required: true}" sit-read-only="true">工厂名称:</sit-property>
     <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProcessCode" 
         sit-validation="{required: true}" sit-read-only="true">工序编码:</sit-property>
     <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ProcessName" 
         sit-validation="{required: true}" sit-read-only="true">工序名称:</sit-property>
     <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Spec" 
         sit-validation="{required: true}" sit-read-only="true">规格:</sit-property>
     <sit-property sit-widget="sit-text" sit-value="vm.currentItem.PalletNum" 
         sit-validation="{required: true}" sit-read-only="true">托盘数量:</sit-property>
     <sit-property sit-widget="sit-text" sit-value="vm.currentItem.UnitName" 
         sit-validation="{required: true}" sit-read-only="true">单位:</sit-property>
     <sit-property sit-widget="sit-checkbox" sit-value="vm.IsDeleted" 
         sit-validation="{required: false" sit-read-only="true" ng-show="true">删除标记:</sit-property>
     <sit-property sit-widget="sit-text" sit-value="vm.currentItem.Remark" 
         sit-validation="{required: true}" sit-read-only="true">备注:</sit-property>
     <sit-property sit-widget="sit-text" sit-value="vm.currentItem.CreatorCode" 
         sit-validation="{required: true}" sit-read-only="true">创建人编码:</sit-property>
     <sit-property sit-widget="sit-text" sit-value="vm.currentItem.CreatorName" 
         sit-validation="{required: true}" sit-read-only="true">创建人名称:</sit-property>
     <sit-property sit-widget="sit-datepicker" sit-value="vm.currentItem.CreateTime" 
         sit-validation="{required: true}" sit-read-only="true" sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="false">创建时间:</sit-property>
     <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ModifyCode" 
         sit-validation="{required: true}" sit-read-only="true">修改人编码:</sit-property>
     <sit-property sit-widget="sit-text" sit-value="vm.currentItem.ModifyName" 
         sit-validation="{required: true}" sit-read-only="true">修改人名称:</sit-property>
     <sit-property sit-widget="sit-datepicker" sit-value="vm.currentItem.ModifyTime" 
         sit-validation="{required: true}" sit-read-only="true" sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="false">修改时间:</sit-property>
     <sit-property sit-widget="sit-datepicker" sit-value="vm.currentItem.CreateTime" 
         sit-validation="{required: true}" sit-read-only="true" sit-widget-attributes="{'sit-format':'yyyy-MM-dd','sit-show-meridian':'false'}" sit-read-only="false">创建时间:</sit-property>
  </sit-property-grid>
</div>
