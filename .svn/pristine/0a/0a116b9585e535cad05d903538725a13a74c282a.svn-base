using System;
using System.Collections.Generic;
using System.Linq;
using System.Text;

namespace Lib
{
    /// <summary>
    /// api分页参数
    /// </summary>
    public class HttpPagination
    {
        /// <summary>
        /// 页大小
        /// </summary>
        public int rows { get; set; }
        /// <summary>
        /// 当前页
        /// </summary>
        public int page { get; set; }
        /// <summary>
        /// 排序字段
        /// </summary>
        public string sidx { get; set; }
        /// <summary>
        /// 排序方式
        /// </summary>
        public string sord { get; set; }
    }
}
