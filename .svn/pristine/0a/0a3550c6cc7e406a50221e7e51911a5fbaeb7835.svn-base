        /// <summary>
        /// 功能描述: 查询分页列表(DataTable)
        /// 创　　建: admin
        /// 创建日期: 2021-10-11 21:42:27
        /// 任务编号: 成品库存管理(主)
        /// </summary>
        /// <param name="pagination">分页</param>
        /// <param name="queryJson">查询参数</param>
        /// <returns>返回分页列表</returns>
        public DataTable GetProductStockPageDataTableMainList(Pagination pagination, string queryJson)
         {
             StringBuilder sql = new StringBuilder();

            sql.Append(@"SELECT b.Id,a.FactoryCode,a.FactoryName,a.ProductOrder,
                               a.ContainerNO,
                               a.CustomerPO,
							   a.WorkOrder,
							   a.MaterialCode,
							   c.MMXH,
							   b.WhsCode,
							   d.ResourceName WhsName,
							   b.LocationCode,
							   e.ResourceName LocationName,
                               a.OrderPallet,
                               a.OrderBox,
                               a.OrderPieces,
                               a.DeliveryPallet,
                               a.DeliveryBox,
                               a.DeliveryPieces,
                               b.PalletQty,
                               b.BoxQty,
							   b.PieceQty,
                               b.PerPalletBoxQty,
							   b.PerPalletPieceQty,
                               CASE
                                   WHEN ISNULL(b.PieceQty,0) < a.OrderPieces THEN
                                       '部分入库'
                                   ELSE
                                       '已入库'
                               END FinisthStatus,
							   b.CreateTime,
							   b.LineNum,
							   c.CPBZTPSL
                        FROM dbo.PL_WorkOrder a
                            INNER JOIN
                            dbo.MM_ProductStock b
                                ON a.WorkOrder = b.WorkOrder
							LEFT JOIN dbo.fn_GetMaterialAttrs() c ON a.WorkOrder=c.WorkOrder
							LEFT JOIN dbo.BS_ModelWithResource d ON b.WhsCode=d.ResourceCode
							LEFT JOIN dbo.BS_ModelWithResource e ON b.LocationCode=e.ResourceCode
                        WHERE 1 = 1 
						AND ISNULL(b.PieceQty,0)>0 ");
            var parameter = new List<DbParameter>();
            if (!string.IsNullOrEmpty(queryJson))
            {
                JObject queryParam = queryJson.ToJObject();
                //工厂
                if (!queryParam["FactoryCode"].IsEmpty())
                {
                    sql.Append($" AND a.FactoryCode = N'{queryParam["FactoryCode"]}'");
                }
                if (!queryParam["ProductOrder"].IsEmpty())
                {
                    sql.Append($" AND a.ProductOrder like N'%{queryParam["ProductOrder"]}%'");
                }

                //柜号 是否为空进行查询
                if (!queryParam["ContainerNO"].IsEmpty())
                {
                    sql.Append($" AND a.ContainerNO = N'{queryParam["ContainerNO"]}'");
                }
                //客户型号 是否为空进行查询
                if (!queryParam["MaterialCode"].IsEmpty())
                {
                    sql.Append($" AND a.MaterialCode like N'%{queryParam["MaterialCode"]}%'");
                }
                //客户PO号 是否为空进行查询
                if (!queryParam["CustomerPO"].IsEmpty())
                {
                    sql.Append($" AND a.CustomerPO like N'%{queryParam["CustomerPO"]}%'");
                }
                //待入库唛头
                if (!queryParam["Status"].IsEmpty())
                {
                    sql.Append($" AND EXISTS(SELECT 1 FROM dbo.BS_ModelResourceExtendInfo WHERE ResourceCode=b.LocationCode AND FieldCode='GLFS' AND FieldValue='0') ");
                };
                //仓库类型  2025-07-25 韩总要求放开 暂时不做限制
                //if (!queryParam["CKLX"].IsEmpty())
                //{
                //    sql.Append($" AND EXISTS(SELECT 1 FROM dbo.BS_ModelResourceExtendInfo  WHERE ResourceCode=b.WhsCode AND FieldCode='CKLX' AND FieldValue='{queryParam["CKLX"]}' ) ");
                //};
                //仓库
                if (!queryParam["WhsName"].IsEmpty())
                {
                    sql.Append($" AND (d.ResourceName  LIKE '{queryParam["WhsName"]}%' OR b.WhsCode LIKE '%{queryParam["WhsName"]}%')");
                }
            }

            try
            {
                if (pagination == null)
                {
                    return this.BaseRepository().FindTable(sql.ToString());
                }
                else
                {
                    return this.BaseRepository().FindTable(sql.ToString(), parameter.ToArray(), pagination);
                }
            }
            catch (Exception ex)
            {
                throw;
            }
        }

        /// <summary>
        /// 功能描述: 查询分页列表(DataTable)
        /// 创　　建: admin
        /// 创建日期: 2021-10-11 21:42:27
        /// 任务编号: 包装周转库存查询（明细）
